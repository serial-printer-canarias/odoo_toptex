<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sp_personalization_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .sp-title{font-size:24px;font-weight:900;color:#1f3cff;margin:0 0 8px}
                            .sp-meta{border:1px solid #d9e1f2;border-radius:10px;padding:8px 10px;margin-bottom:10px;font-size:12px}
                            .sp-group{border:2px solid #d9e1f2;border-radius:12px;margin-bottom:12px;page-break-inside:avoid;overflow:hidden}
                            .sp-group-head{background:#eef3ff;padding:9px 10px}
                            .sp-code{display:inline-block;background:#1f3cff;color:#fff;border-radius:999px;padding:4px 9px;font-weight:900;font-size:13px;margin-right:6px}
                            .sp-pill{display:inline-block;border:1px solid #d9e1f2;background:#fff;border-radius:999px;padding:4px 9px;font-size:12px;font-weight:800;margin-right:4px}
                            .sp-color-pill{display:inline-block;border:1px solid #cbd5e1;border-radius:999px;padding:4px 10px;font-size:12px;font-weight:900;background:#fff}
                            .sp-dot{display:inline-block;width:12px;height:12px;border-radius:50%;border:1px solid #94a3b8;vertical-align:-2px;margin-right:5px}
                            .sp-row{width:100%;border-collapse:collapse}
                            .sp-row td{vertical-align:top}
                            .sp-marking{border-top:1px solid #d9e1f2;padding:10px;page-break-inside:avoid}
                            .sp-marking-title{font-size:18px;font-weight:900;color:#132a99;margin:0 0 8px}
                            .sp-mockup-cell{width:44%;padding-right:10px}
                            .sp-info-cell{width:56%}
                            .sp-mockups{width:100%;border-collapse:collapse}
                            .sp-mockups td{width:50%;padding:4px;text-align:center;vertical-align:middle}
                            .sp-mockup-label{font-size:10px;text-transform:uppercase;color:#64748b;font-weight:900;margin-bottom:4px}
                            .sp-garment{position:relative;margin:0 auto}
                            .sp-photo-mockup{position:relative;margin:0 auto;width:150px;height:150px;text-align:center;background:#fff}
                            .sp-product-photo{display:block;margin:0 auto;max-width:145px;max-height:145px;width:auto;height:auto}
                            .sp-composed-mockup{display:block;margin:0 auto;max-width:170px;max-height:170px;width:auto;height:auto}
                            .sp-shirt{width:96px;height:132px;border-radius:18px;background:#334155}
                            .sp-shirt.black{background:#132a99}.sp-shirt.navy{background:#18243a}.sp-shirt.beige{background:#c9b79a}.sp-shirt.default{background:#334155}.sp-shirt.tricolor{background:#1e3a8a}
                            .sp-shirt:before,.sp-shirt:after{content:"";position:absolute;top:26px;width:44px;height:44px;border-radius:18px;background:inherit}
                            .sp-shirt:before{left:-30px}.sp-shirt:after{right:-30px}
                            .sp-neck{position:absolute;top:0;left:50%;width:36px;height:18px;margin-left:-18px;border-radius:0 0 18px 18px;background:#fff}
                            .sp-cap{width:130px;height:78px;border-radius:70px 70px 18px 18px;background:linear-gradient(90deg,#f8fafc,#b91c1c,#1e3a8a);position:relative}
                            .sp-cap:after{content:"";position:absolute;left:31px;bottom:-10px;width:68px;height:22px;border-radius:0 0 40px 40px;background:#132a99}
                            .sp-logo{position:absolute;border:2px solid #1f3cff;background:#fff;border-radius:7px;overflow:hidden;text-align:center;font-size:8px;font-weight:900;color:#1f3cff;line-height:1}
                            .sp-logo img{width:100%;height:100%;object-fit:contain;padding:2px}
                            .sp-logo.front_left{left:15px;top:38px;width:34px;height:26px}
                            .sp-logo.front_center{left:50%;top:42px;width:44px;height:30px;margin-left:-22px}
                            .sp-logo.back{left:50%;top:48px;width:54px;height:34px;margin-left:-27px}
                            .sp-logo.neck{left:50%;top:14px;width:34px;height:18px;margin-left:-17px}
                            .sp-logo.right_sleeve{right:-22px;top:40px;width:28px;height:26px}
                            .sp-logo.left_sleeve{left:-22px;top:40px;width:28px;height:26px}
                            .sp-logo.cap_front{left:50%;top:30px;width:42px;height:30px;margin-left:-21px}
                            .sp-logo.cap_side{right:18px;top:30px;width:34px;height:28px}
                            .sp-photo-mockup .sp-logo.front_left{left:52px;top:57px;width:36px;height:24px}
                            .sp-photo-mockup .sp-logo.front_center{left:75px;top:60px;width:42px;height:26px;margin-left:-21px}
                            .sp-photo-mockup .sp-logo.back{left:75px;top:56px;width:50px;height:30px;margin-left:-25px}
                            .sp-photo-mockup .sp-logo.neck{left:75px;top:32px;width:32px;height:17px;margin-left:-16px}
                            .sp-photo-mockup .sp-logo.right_sleeve{right:26px;top:58px;width:28px;height:24px}
                            .sp-photo-mockup .sp-logo.left_sleeve{left:26px;top:58px;width:28px;height:24px}
                            .sp-photo-mockup .sp-logo.cap_front{left:75px;top:60px;width:42px;height:28px;margin-left:-21px}
                            .sp-photo-mockup .sp-logo.cap_side{right:38px;top:60px;width:32px;height:24px}
                            .sp-specs{width:100%;border-collapse:collapse;margin-bottom:7px}
                            .sp-specs th{background:#eef3ff;color:#132a99;font-size:11px;text-transform:uppercase;text-align:left;padding:5px;border:1px solid #d9e1f2}
                            .sp-specs td{font-size:13px;font-weight:800;padding:6px;border:1px solid #d9e1f2}
                            .sp-size-table{width:100%;border-collapse:collapse;margin-top:7px}
                            .sp-size-table th{background:#f8faff;color:#64748b;font-size:10px;text-transform:uppercase;border:1px solid #d9e1f2;padding:4px;text-align:center}
                            .sp-size-table td{font-size:14px;font-weight:900;border:1px solid #d9e1f2;padding:5px;text-align:center}
                            .sp-files{width:100%;border-collapse:collapse;margin-top:7px}
                            .sp-files th{background:#eef3ff;color:#132a99;font-size:10px;text-transform:uppercase;border:1px solid #d9e1f2;padding:4px}
                            .sp-files td{font-size:11px;border:1px solid #d9e1f2;padding:5px;vertical-align:middle}
                            .sp-preview{display:block;max-height:58px;max-width:100%;width:auto;height:auto}
                            .sp-download{font-size:10px;font-weight:900;color:#1f3cff;text-decoration:none}
                            .sp-note{font-size:12px;border:1px solid #d9e1f2;border-radius:8px;padding:6px;margin-top:7px}
                            .sp-no{padding:12px;color:#991b1b;font-weight:900;background:#fff1f2;border-top:1px solid #fecaca}
                        </style>

                        <h1 class="sp-title">Ficha visual de taller</h1>
                        <div class="sp-meta">
                            <strong>Ficha:</strong> <span t-esc="doc.name"/>
                            · <strong>Cliente:</strong> <span t-esc="doc.partner_id.name"/>
                            · <strong>Origen:</strong> <span t-esc="doc.sale_order_id.name or doc.account_move_id.name or '-'"/>
                        </div>

                        <t t-foreach="doc.group_ids" t-as="group">
                            <section class="sp-group">
                                <div class="sp-group-head">
                                    <span class="sp-code" t-esc="group.product_ref or '-'"/>
                                    <span style="font-size:17px;font-weight:900" t-esc="group.product_name"/>
                                    <span class="sp-pill"><strong t-esc="group.qty_total_display"/> uds</span>
                                    <span class="sp-color-pill">
                                        <span class="sp-dot" t-att-style="'background:%s' % group.garment_color_hex"/>
                                        <span t-esc="group.color_name"/>
                                    </span>
                                    <span class="sp-pill" t-esc="group.size_summary"/>
                                </div>

                                <t t-if="group.status == 'no'">
                                    <div class="sp-no">NO PERSONALIZAR ESTE GRUPO</div>
                                </t>

                                <t t-foreach="group.marking_ids" t-as="marking">
                                    <div class="sp-marking">
                                        <h2 class="sp-marking-title">
                                            <span t-esc="marking.name"/> · <span t-esc="marking.qty_total_display"/> uds
                                        </h2>
                                        <t t-set="front_placements" t-value="marking.placement_ids.filtered(lambda p: p.side in ('front', 'side'))"/>
                                        <t t-set="back_placements" t-value="marking.placement_ids.filtered(lambda p: p.side == 'back')"/>
                                        <table class="sp-row">
                                            <tr>
                                                <td class="sp-mockup-cell">
                                                    <table class="sp-mockups">
                                                        <tr>
                                                            <td t-if="front_placements">
                                                                <div class="sp-mockup-label">Delante</div>
                                                                <t t-if="marking.mockup_front_available">
                                                                    <img class="sp-composed-mockup" t-att-src="marking.mockup_front_data_uri"/>
                                                                </t>
                                                                <t t-elif="group.product_image_data_uri">
                                                                    <img class="sp-composed-mockup" t-att-src="group.product_image_data_uri"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <div t-att-class="'sp-garment sp-shirt %s' % (group.garment_color_key or 'default')">
                                                                        <span class="sp-neck"/>
                                                                    </div>
                                                                </t>
                                                            </td>
                                                            <td t-if="group.group_type != 'cap' and back_placements">
                                                                <div class="sp-mockup-label">Espalda</div>
                                                                <t t-if="marking.mockup_back_available">
                                                                    <img class="sp-composed-mockup" t-att-src="marking.mockup_back_data_uri"/>
                                                                </t>
                                                                <t t-elif="group.product_image_data_uri">
                                                                    <img class="sp-composed-mockup" t-att-src="group.product_image_data_uri"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <div t-att-class="'sp-garment sp-shirt %s' % (group.garment_color_key or 'default')">
                                                                        <span class="sp-neck"/>
                                                                    </div>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                                <td class="sp-info-cell">
                                                    <table class="sp-specs">
                                                        <tr>
                                                            <th>Técnica</th>
                                                            <th>Posición</th>
                                                            <th>Color</th>
                                                            <th>Tamaño</th>
                                                        </tr>
                                                        <tr>
                                                            <td t-esc="dict(marking._fields['technique'].selection).get(marking.technique)"/>
                                                            <td t-esc="dict(marking._fields['position'].selection).get(marking.position)"/>
                                                            <td>
                                                                <span class="sp-dot" t-att-style="'background:%s' % marking.print_color_hex"/>
                                                                <span t-esc="dict(marking._fields['print_color'].selection).get(marking.print_color)"/>
                                                            </td>
                                                            <td>
                                                                <span t-esc="dict(marking._fields['size_mode'].selection).get(marking.size_mode)"/>
                                                                <t t-if="marking.width_cm or marking.height_cm">
                                                                    · <span t-esc="marking.width_cm or '-'"/> x <span t-esc="marking.height_cm or '-'"/> cm
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </table>

                                                    <table class="sp-size-table">
                                                        <tr>
                                                            <t t-foreach="marking.size_ids" t-as="size">
                                                                <th t-esc="size.size_name"/>
                                                            </t>
                                                        </tr>
                                                        <tr>
                                                            <t t-foreach="marking.size_ids" t-as="size">
                                                                <td t-esc="size.qty"/>
                                                            </t>
                                                        </tr>
                                                    </table>

                                                    <table class="sp-files">
                                                        <tr>
                                                            <th>Ubicación</th>
                                                            <th>Logo</th>
                                                            <th>Producción</th>
                                                        </tr>
                                                        <t t-foreach="marking.placement_ids" t-as="placement">
                                                            <tr>
                                                                <td><strong t-esc="placement.placement_label"/></td>
                                                                <td>
                                                                    <t t-if="placement.logo_preview_available">
                                                                        <img t-att-src="placement.logo_preview_data_uri" class="sp-preview"/>
                                                                    </t>
                                                                    <t t-else="">Sin preview</t>
                                                                </td>
                                                                <td>
                                                                    <t t-if="placement.production_attachment_id">
                                                                        <a class="sp-download"
                                                                           t-att-href="placement.production_download_url"
                                                                           t-esc="placement.production_filename or 'Descargar producción'"/>
                                                                    </t>
                                                                    <t t-else="">pendiente</t>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </table>

                                                    <t t-if="marking.notes">
                                                        <div class="sp-note"><strong>Notas:</strong> <span t-esc="marking.notes"/></div>
                                                    </t>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </t>
                            </section>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
