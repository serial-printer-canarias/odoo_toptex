<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_personalization_form" name="Serial Printer Personalization Form">
        <t t-call="website.layout">
            <div class="sp-personalization-page">
                <style>
                    .sp-personalization-page{background:#f6f8ff;color:#0f172a;padding:32px 0}
                    .sp-wrap{max-width:1180px;margin:0 auto;padding:0 18px}
                    .sp-hero,.sp-card{border:1px solid #d9e1f2;background:#fff;border-radius:28px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
                    .sp-hero{padding:28px;margin-bottom:18px}
                    .sp-eyebrow{color:#1f3cff;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;margin:0 0 8px}
                    .sp-title{font-size:34px;line-height:1.05;font-weight:900;margin:0 0 12px;color:#132a99}
                    .sp-muted{color:#64748b}
                    .sp-card{padding:22px;margin-bottom:18px}
                    .sp-grid{display:grid;gap:18px}
                    .sp-group-head{display:grid;grid-template-columns:140px 1fr 150px;gap:18px;align-items:center}
                    .sp-product-frame{height:128px;border:1px solid #d9e1f2;border-radius:24px;background:#f8faff;display:flex;align-items:center;justify-content:center;overflow:hidden}
                    .sp-product-frame img{max-width:100%;max-height:128px;object-fit:contain}
                    .sp-product-placeholder{width:70px;height:96px;border-radius:18px;background:#132a99;position:relative}
                    .sp-product-placeholder:before,.sp-product-placeholder:after{content:"";position:absolute;top:22px;width:34px;height:34px;border-radius:16px;background:inherit}
                    .sp-product-placeholder:before{left:-22px}.sp-product-placeholder:after{right:-22px}
                    .sp-product-placeholder.black{background:#132a99}.sp-product-placeholder.navy{background:#18243a}.sp-product-placeholder.beige{background:#c9b79a}.sp-product-placeholder.tricolor{background:linear-gradient(90deg,#f8fafc,#b91c1c,#1e3a8a)}
                    .sp-pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;border:1px solid #d9e1f2;background:#eef3ff;color:#132a99;padding:5px 10px;font-size:12px;font-weight:900}
                    .sp-qty{text-align:right}.sp-qty strong{display:block;font-size:40px;line-height:1;font-weight:900;color:#1f3cff}
                    .sp-actions{display:flex;flex-wrap:wrap;gap:9px;border-top:1px solid #d9e1f2;border-bottom:1px solid #d9e1f2;background:#f8faff;margin:18px -22px 0;padding:14px 22px}
                    .sp-btn{border:0;border-radius:14px;background:#1f3cff;color:#fff;padding:10px 14px;font-weight:900}
                    .sp-btn-light{border:1px solid #d9e1f2;border-radius:14px;background:#fff;color:#0f172a;padding:10px 14px;font-weight:900}
                    .sp-btn-danger{border:1px solid #fecaca;border-radius:14px;background:#fff1f2;color:#991b1b;padding:10px 14px;font-weight:900}
                    .sp-alert{border-radius:18px;border:1px solid #d9e1f2;background:#f8faff;padding:12px 14px;font-weight:800}
                    .sp-alert.ok{border-color:#bbf7d0;background:#f0fdf4;color:#166534}.sp-alert.warn{border-color:#fecaca;background:#fef2f2;color:#991b1b}
                    .sp-marking{border:1px solid #d9e1f2;border-radius:24px;background:#f8faff;padding:18px;margin-top:16px}
                    .sp-form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
                    .sp-field label,.sp-field-title{display:block;font-size:12px;font-weight:900;color:#64748b;text-transform:uppercase;margin-bottom:6px}
                    .sp-field input,.sp-field select,.sp-field textarea{width:100%;border:1px solid #d9e1f2;border-radius:14px;background:#fff;padding:11px;color:#0f172a}
                    .sp-field textarea{min-height:82px}
                    .sp-sizes{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
                    .sp-placement-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
                    .sp-placement{border:1px solid #d9e1f2;background:#fff;border-radius:18px;padding:12px}
                    .sp-preview{height:116px;border:1px dashed #d9e1f2;border-radius:14px;background:#eef3ff;display:flex;align-items:center;justify-content:center;margin:8px 0;overflow:hidden}
                    .sp-preview img{max-height:108px;max-width:100%;object-fit:contain}
                    .sp-palette{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:10px}
                    .sp-swatch{display:flex;align-items:center;gap:8px;border:1px solid #d9e1f2;border-radius:12px;background:#fff;padding:8px;font-size:12px;font-weight:800}
                    .sp-dot{width:16px;height:16px;border-radius:999px;border:1px solid #cbd5e1;display:inline-block}
                    .sp-footer{position:sticky;bottom:16px;border-radius:24px;background:#1f3cff;color:#fff;padding:16px 18px;display:flex;justify-content:space-between;gap:16px;align-items:center;box-shadow:0 14px 30px rgba(31,60,255,.24)}
                    @media(max-width:900px){.sp-group-head{grid-template-columns:1fr}.sp-qty{text-align:left}.sp-form-grid,.sp-placement-grid{grid-template-columns:1fr}.sp-sizes,.sp-palette{grid-template-columns:repeat(2,minmax(0,1fr))}.sp-title{font-size:28px}}
                </style>
                <div class="sp-wrap">
                    <section class="sp-hero">
                        <p class="sp-eyebrow">Serial Printer · Personalización textil</p>
                        <h1 class="sp-title">Ficha de personalización</h1>
                        <p>
                            Cliente: <strong><t t-esc="personalization.partner_id.name"/></strong>
                            <t t-if="personalization.source_display_name">
                                · Presupuesto/factura: <strong><t t-esc="personalization.source_display_name"/></strong>
                            </t>
                            · Referencia: <strong><t t-esc="personalization.name"/></strong>
                        </p>
                        <p class="sp-muted mb-0">Los productos se agrupan por modelo y color, no por SKU. Puedes personalizar, dividir en dos logos o marcar grupos sin personalización.</p>
                    </section>

                    <t t-if="not personalization.group_ids">
                        <section class="sp-card">
                            <h3>No hay productos cargados</h3>
                            <p>Abre la ficha en Odoo, enlaza un presupuesto o factura y pulsa <strong>Cargar líneas</strong>.</p>
                        </section>
                    </t>

                    <t t-foreach="personalization.group_ids" t-as="group">
                        <section class="sp-card">
                            <div class="sp-group-head">
                                <div class="sp-product-frame">
                                    <t t-if="group.product_image_1920">
                                        <img t-att-src="'/personalizacion/%s/grupo/%s/imagen' % (personalization.access_token, group.id)"/>
                                    </t>
                                    <t t-else="">
                                        <div t-attf-class="sp-product-placeholder #{group.garment_color_key}"/>
                                    </t>
                                </div>
                                <div>
                                    <div>
                                        <span class="sp-pill">Ref. <t t-esc="group.product_ref or '-'"/></span>
                                        <span class="sp-pill">Agrupado por modelo/color</span>
                                    </div>
                                    <h2 class="mt-2 mb-1"><t t-esc="group.product_name"/></h2>
                                    <p class="mb-1">Color prenda: <strong><t t-esc="group.color_name"/></strong></p>
                                    <p class="mb-1">Tallas compra: <strong><t t-esc="group.size_summary"/></strong></p>
                                    <details t-if="group.original_line_summary">
                                        <summary class="sp-muted">Ver líneas originales agrupadas</summary>
                                        <pre class="mt-2 p-3 rounded" style="white-space:pre-wrap;background:#eef3ff;border:1px solid #d9e1f2"><t t-esc="group.original_line_summary"/></pre>
                                    </details>
                                </div>
                                <div class="sp-qty">
                                    <strong><t t-esc="group.qty_total"/></strong>
                                    <span class="sp-muted">unidades</span>
                                </div>
                            </div>

                            <div class="sp-actions">
                                <form method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="personalize_group"/>
                                    <input type="hidden" name="group_id" t-att-value="group.id"/>
                                    <button class="sp-btn" type="submit">Personalizar</button>
                                </form>
                                <form method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="split_two"/>
                                    <input type="hidden" name="group_id" t-att-value="group.id"/>
                                    <button class="sp-btn-light" type="submit">Dividir en 2 logos</button>
                                </form>
                                <form method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="mark_no"/>
                                    <input type="hidden" name="group_id" t-att-value="group.id"/>
                                    <button class="sp-btn-danger" type="submit">No personalizar</button>
                                </form>
                            </div>

                            <t t-if="group.status == 'no'">
                                <div class="sp-alert ok mt-3">Grupo marcado como no personalizado.</div>
                            </t>
                            <t t-elif="not group.marking_ids">
                                <div class="sp-alert mt-3">Pendiente. Decide si este grupo lleva personalización.</div>
                            </t>
                            <t t-else="">
                                <div t-attf-class="sp-alert mt-3 #{'ok' if group.qty_status_ok else 'warn'}">
                                    <t t-esc="group.qty_status_text"/>
                                </div>
                            </t>

                            <t t-foreach="group.marking_ids" t-as="marking">
                                <form method="post" enctype="multipart/form-data" class="sp-marking">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="save_marking"/>
                                    <input type="hidden" name="marking_id" t-att-value="marking.id"/>
                                    <div class="d-flex justify-content-between gap-3 flex-wrap mb-3">
                                        <div>
                                            <h3 class="mb-1"><t t-esc="marking.name"/> · <t t-esc="marking.qty_total"/> uds</h3>
                                            <p class="sp-muted mb-0">Configura técnica, posición, color, tallas y archivos por ubicación.</p>
                                        </div>
                                        <button type="submit" class="sp-btn">Guardar marcaje</button>
                                    </div>
                                    <div class="sp-form-grid">
                                        <div class="sp-field"><label>Nombre</label><input name="name" t-att-value="marking.name"/></div>
                                        <div class="sp-field"><label>Técnica</label><select name="technique"><t t-foreach="technique_options" t-as="opt"><option t-att-value="opt[0]" t-att-selected="opt[0] == marking.technique"><t t-esc="opt[1]"/></option></t></select></div>
                                        <div class="sp-field"><label>Posición</label><select name="position"><t t-foreach="position_options" t-as="opt"><option t-att-value="opt[0]" t-att-selected="opt[0] == marking.position"><t t-esc="opt[1]"/></option></t></select></div>
                                        <div class="sp-field"><label>Tamaño</label><select name="size_mode"><t t-foreach="size_mode_options" t-as="opt"><option t-att-value="opt[0]" t-att-selected="opt[0] == marking.size_mode"><t t-esc="opt[1]"/></option></t></select></div>
                                        <div class="sp-field"><label>Ancho cm</label><input type="number" step="0.1" name="width_cm" t-att-value="marking.width_cm"/></div>
                                        <div class="sp-field"><label>Alto cm</label><input type="number" step="0.1" name="height_cm" t-att-value="marking.height_cm"/></div>
                                        <div class="sp-field" style="grid-column:span 2"><label>Color tinta/hilo</label><select name="print_color"><t t-foreach="color_options" t-as="opt"><option t-att-value="opt[0]" t-att-selected="opt[0] == marking.print_color"><t t-esc="opt[1]"/></option></t></select></div>
                                    </div>

                                    <details class="mt-3">
                                        <summary class="sp-field-title">Ver paleta completa</summary>
                                        <div class="sp-palette">
                                            <t t-foreach="color_options" t-as="opt">
                                                <div class="sp-swatch">
                                                    <span class="sp-dot" t-att-style="'background:%s' % color_hex_map.get(opt[0], '#111111')"/>
                                                    <span><t t-esc="opt[1]"/></span>
                                                </div>
                                            </t>
                                        </div>
                                    </details>

                                    <div class="mt-3">
                                        <p class="sp-field-title">Reparto de tallas</p>
                                        <div class="sp-sizes">
                                            <t t-foreach="marking.size_ids" t-as="size_line">
                                                <div class="sp-field">
                                                    <label><t t-esc="size_line.size_name"/></label>
                                                    <input type="number" step="1" min="0" t-att-name="'size_qty_%s' % size_line.id" t-att-value="size_line.qty"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <p class="sp-field-title">Archivos por ubicación</p>
                                        <div class="sp-placement-grid">
                                            <t t-foreach="marking.placement_ids" t-as="placement">
                                                <div class="sp-placement">
                                                    <strong style="color:#132a99"><t t-esc="placement.placement_label"/></strong>
                                                    <div class="sp-preview">
                                                        <t t-if="placement.preview_image">
                                                            <img t-att-src="'/personalizacion/%s/ubicacion/%s/preview' % (personalization.access_token, placement.id)"/>
                                                        </t>
                                                        <t t-else=""><span class="sp-muted">Sin preview</span></t>
                                                    </div>
                                                    <div class="sp-field"><label>Producción</label><input type="file" t-att-name="'production_%s' % placement.id"/></div>
                                                    <div class="sp-field mt-2"><label>Preview</label><input type="file" t-att-name="'preview_%s' % placement.id"/></div>
                                                    <p class="sp-muted mt-2 mb-0">Producción: <t t-esc="placement.production_filename or 'pendiente'"/></p>
                                                    <p class="sp-muted mb-0">Preview: <t t-esc="placement.preview_filename or 'pendiente'"/></p>
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                    <div class="sp-field mt-3">
                                        <label>Observaciones</label>
                                        <textarea name="notes"><t t-esc="marking.notes or ''"/></textarea>
                                    </div>
                                </form>
                            </t>

                            <t t-if="group.marking_ids">
                                <form method="post" class="mt-3">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="add_marking"/>
                                    <input type="hidden" name="group_id" t-att-value="group.id"/>
                                    <button class="sp-btn-light" type="submit">+ Añadir otro marcaje</button>
                                </form>
                            </t>
                        </section>
                    </t>

                    <form method="post" class="sp-card">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="action" value="confirm"/>
                        <div class="sp-field">
                            <label>Notas generales</label>
                            <textarea name="customer_notes"><t t-esc="personalization.customer_notes or ''"/></textarea>
                        </div>
                        <button type="submit" class="sp-btn mt-3">Enviar ficha a Serial Printer</button>
                    </form>

                    <div class="sp-footer">
                        <div>
                            <strong><t t-esc="personalization.group_count"/> grupos · <t t-esc="personalization.marking_count"/> marcajes</strong>
                            <div style="font-size:12px;color:#dbeafe">Esta ficha se guarda en Odoo y sirve como base para el PDF de taller.</div>
                        </div>
                        <a class="sp-btn-light" href="#top">Revisar arriba</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_sale_order_personalization_button" inherit_id="sale.sale_order_portal_content" name="Sale Portal Personalization Button">
        <xpath expr="//div[@id='intro_row']" position="inside">
            <t t-if="report_type == 'html' and sale_order.sp_has_textile_personalization_lines">
                <a class="btn btn-primary ms-auto d-print-none"
                   t-attf-href="/personalizacion/presupuesto/#{sale_order.id}?access_token=#{sale_order.access_token}">
                    <i class="fa fa-paint-brush me-1"/> Personalización textil
                </a>
            </t>
        </xpath>
    </template>
</odoo>
