<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_personalization_customer" model="mail.template">
        <field name="name">Serial Printer Personalizacion Cliente</field>
        <field name="model_id" ref="model_sp_personalization_order"/>
        <field name="subject">Ficha de personalizacion - {{ object.name }}</field>
        <field name="email_from">{{ object.company_id.email or user.email }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hola <t t-out="object.partner_id.name"/>,</p>
                <p>Hemos preparado la ficha para confirmar la personalizacion de tu pedido.</p>
                <p><a t-att-href="object.portal_url" style="background:#1f3cff;color:#ffffff;padding:12px 18px;border-radius:10px;text-decoration:none;">Abrir ficha de personalizacion</a></p>
                <p>Formatos produccion: PDF, AI, EPS o SVG. Preview visible: PNG, JPG, WEBP o SVG.</p>
            </div>
        </field>
    </record>

    <record id="mail_template_personalization_internal_received" model="mail.template">
        <field name="name">Serial Printer Personalizacion Recibida</field>
        <field name="model_id" ref="model_sp_personalization_order"/>
        <field name="subject">Personalizacion recibida - {{ object.name }}</field>
        <field name="email_from">{{ object.company_id.email or user.email }}</field>
        <field name="email_to">{{ object.sale_order_id.user_id.email or user.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Se ha recibido una ficha de personalizacion.</p>
                <p><strong>Ficha:</strong> <t t-out="object.name"/><br/><strong>Cliente:</strong> <t t-out="object.partner_id.name"/></p>
                <p><a t-att-href="object.portal_url">Abrir enlace cliente</a></p>
            </div>
        </field>
    </record>
</odoo>
