<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_personalization_form" name="Serial Printer Personalization Form">
        <t t-call="website.layout">
            <div class="sp-personalization">
                <style>
                    .sp-personalization{background:#f6f8ff;color:#101828;padding:26px 0}
                    .sp-wrap{max-width:1120px;margin:0 auto;padding:0 16px}
                    .sp-head,.sp-group,.sp-marking,.sp-notes{background:#fff;border:1px solid #d9e1f2;border-radius:20px}
                    .sp-head{padding:18px 20px;margin-bottom:14px}
                    .sp-head h1{margin:0;color:#1f3cff;font-weight:900;font-size:30px;letter-spacing:0}
                    .sp-meta{color:#667085;font-size:13px;margin-top:6px}
                    .sp-group{margin-bottom:14px;overflow:hidden}
                    .sp-group-main{display:grid;grid-template-columns:92px 1fr 90px;gap:14px;align-items:center;padding:14px 16px}
                    .sp-code{display:inline-block;border-radius:999px;background:#eef3ff;color:#132a99;font-weight:900;font-size:12px;padding:4px 9px}
                    .sp-name{font-size:18px;font-weight:900;margin:6px 0 2px}
                    .sp-line{font-size:13px;color:#475467;margin:0}
                    .sp-total{text-align:right}.sp-total strong{display:block;font-size:28px;color:#1f3cff;line-height:1;font-weight:900}
                    .sp-thumb{height:82px;border-radius:16px;border:1px solid #d9e1f2;background:#f8faff;display:flex;align-items:center;justify-content:center;overflow:hidden}
                    .sp-thumb img{max-width:100%;max-height:82px;object-fit:contain}
                    .sp-actions{display:flex;gap:8px;flex-wrap:wrap;background:#f8faff;border-top:1px solid #d9e1f2;padding:10px 16px}
                    .sp-btn{border:0;border-radius:12px;background:#1f3cff;color:#fff;font-weight:900;padding:9px 12px}
                    .sp-btn-light{border:1px solid #d9e1f2;border-radius:12px;background:#fff;color:#101828;font-weight:900;padding:9px 12px}
                    .sp-btn-danger{border:1px solid #fecaca;border-radius:12px;background:#fff1f2;color:#991b1b;font-weight:900;padding:9px 12px}
                    .sp-status{margin:12px 16px 0;padding:9px 11px;border-radius:13px;font-size:13px;font-weight:900;background:#eef3ff;color:#132a99;border:1px solid #d9e1f2}
                    .sp-status.ok{background:#f0fdf4;color:#166534;border-color:#bbf7d0}.sp-status.warn{background:#fef2f2;color:#991b1b;border-color:#fecaca}
                    .sp-marking{margin:12px 16px 16px;padding:14px}
                    .sp-marking-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
                    .sp-marking-head h3{font-size:17px;margin:0;font-weight:900}
                    .sp-editor{display:grid;grid-template-columns:280px 1fr;gap:14px;align-items:start}
                    .sp-mockups{display:grid;grid-template-columns:1fr 1fr;gap:10px}
                    .sp-mockup-box{border:1px solid #d9e1f2;border-radius:18px;background:#f8faff;padding:10px;text-align:center}
                    .sp-mockup-label{font-size:11px;font-weight:900;text-transform:uppercase;color:#667085;margin-bottom:8px}
                    .sp-garment{position:relative;margin:0 auto}
                    .sp-shirt{width:88px;height:126px;border-radius:18px 18px 20px 20px;background:#132a99}
                    .sp-shirt:before,.sp-shirt:after{content:"";position:absolute;top:24px;width:42px;height:42px;border-radius:18px;background:inherit}
                    .sp-shirt:before{left:-28px}.sp-shirt:after{right:-28px}
                    .sp-shirt .neck{position:absolute;top:0;left:50%;width:34px;height:18px;transform:translateX(-50%);border-radius:0 0 18px 18px;background:#f8faff}
                    .sp-cap{width:128px;height:76px;border-radius:68px 68px 18px 18px;background:linear-gradient(90deg,#f8fafc,#b91c1c,#1e3a8a)}
                    .sp-cap:after{content:"";position:absolute;left:30px;bottom:-10px;width:68px;height:22px;border-radius:0 0 40px 40px;background:#132a99}
                    .sp-black{background:#132a99}.sp-navy{background:#18243a}.sp-beige{background:#c9b79a}.sp-default{background:#334155}.sp-tricolor{background:linear-gradient(90deg,#f8fafc,#b91c1c,#1e3a8a)}
                    .sp-logo-token{position:absolute;border:2px solid currentColor;color:#1f3cff;background:#fff;border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden;font-size:8px;font-weight:900;box-shadow:0 4px 10px rgba(15,23,42,.12)}
                    .sp-logo-token img{width:100%;height:100%;object-fit:contain;padding:2px}
                    .sp-logo-token.front_left{left:14px;top:36px;width:34px;height:26px}
                    .sp-logo-token.front_center{left:50%;top:42px;width:42px;height:30px;transform:translateX(-50%)}
                    .sp-logo-token.back{left:50%;top:48px;width:52px;height:34px;transform:translateX(-50%)}
                    .sp-logo-token.neck{left:50%;top:15px;width:34px;height:18px;transform:translateX(-50%)}
                    .sp-logo-token.right_sleeve{right:-22px;top:38px;width:28px;height:26px}
                    .sp-logo-token.left_sleeve{left:-22px;top:38px;width:28px;height:26px}
                    .sp-logo-token.cap_front{left:50%;top:30px;width:42px;height:30px;transform:translateX(-50%)}
                    .sp-logo-token.cap_side{right:18px;top:30px;width:34px;height:28px}
                    .sp-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
                    .sp-field label,.sp-subtitle{display:block;font-size:11px;font-weight:900;color:#667085;text-transform:uppercase;margin-bottom:5px}
                    .sp-field input,.sp-field select,.sp-field textarea{width:100%;border:1px solid #d9e1f2;border-radius:11px;background:#fff;padding:9px;color:#101828;font-size:13px}
                    .sp-field textarea{min-height:72px}
                    .sp-sizes{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
                    .sp-files{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:10px}
                    .sp-file{border:1px solid #d9e1f2;border-radius:14px;background:#fff;padding:10px}
                    .sp-file strong{color:#132a99;font-size:13px}
                    .sp-file-preview{height:74px;background:#eef3ff;border:1px dashed #d9e1f2;border-radius:10px;display:flex;align-items:center;justify-content:center;margin:7px 0;overflow:hidden;font-size:12px;color:#667085}
                    .sp-file-preview img{max-width:100%;max-height:70px;object-fit:contain}
                    .sp-small{font-size:11px;color:#667085;margin:4px 0 0}
                    .sp-notes{padding:14px;margin-top:14px}
                    .sp-footer{position:sticky;bottom:12px;margin-top:14px;border-radius:16px;background:#1f3cff;color:#fff;padding:12px 14px;display:flex;justify-content:space-between;gap:10px;align-items:center;box-shadow:0 12px 28px rgba(31,60,255,.22)}
                    @media(max-width:900px){.sp-group-main{grid-template-columns:1fr}.sp-total{text-align:left}.sp-editor{grid-template-columns:1fr}.sp-fields,.sp-files{grid-template-columns:1fr}.sp-sizes{grid-template-columns:repeat(2,minmax(0,1fr))}}
                </style>
                <div class="sp-wrap">
                    <section class="sp-head">
                        <h1>Personalización textil</h1>
                        <div class="sp-meta">
                            <strong><t t-esc="personalization.partner_id.name"/></strong>
                            <t t-if="personalization.source_display_name"> · <t t-esc="personalization.source_display_name"/></t>
                            · <t t-esc="personalization.name"/>
                        </div>
                    </section>

                    <t t-foreach="personalization.group_ids" t-as="group">
                        <section class="sp-group">
                            <div class="sp-group-main">
                                <div class="sp-thumb">
                                    <t t-if="group.product_image_1920">
                                        <img t-att-src="'/personalizacion/%s/grupo/%s/imagen' % (personalization.access_token, group.id)"/>
                                    </t>
                                    <t t-else="">
                                        <div t-attf-class="sp-shirt sp-#{group.garment_color_key or 'default'}"><span class="neck"/></div>
                                    </t>
                                </div>
                                <div>
                                    <span class="sp-code"><t t-esc="group.product_ref or '-'"/></span>
                                    <h2 class="sp-name"><t t-esc="group.product_name"/></h2>
                                    <p class="sp-line"><strong><t t-esc="group.color_name"/></strong> · <t t-esc="group.size_summary"/></p>
                                </div>
                                <div class="sp-total">
                                    <strong><t t-esc="group.qty_total"/></strong>
                                    <span class="sp-small">uds</span>
                                </div>
                            </div>

                            <div class="sp-actions">
                                <form method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="personalize_group"/>
                                    <input type="hidden" name="group_id" t-att-value="group.id"/>
                                    <button class="sp-btn" type="submit">Personalizar</button>
                                </form>
                                <form method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="split_two"/>
                                    <input type="hidden" name="group_id" t-att-value="group.id"/>
                                    <button class="sp-btn-light" type="submit">2 logos</button>
                                </form>
                                <form method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="mark_no"/>
                                    <input type="hidden" name="group_id" t-att-value="group.id"/>
                                    <button class="sp-btn-danger" type="submit">No personalizar</button>
                                </form>
                            </div>

                            <t t-if="group.status == 'no'">
                                <div class="sp-status ok">No personalizar este grupo.</div>
                            </t>
                            <t t-elif="not group.marking_ids">
                                <div class="sp-status">Pendiente de decidir.</div>
                            </t>
                            <t t-else="">
                                <div t-attf-class="sp-status #{'ok' if group.qty_status_ok else 'warn'}"><t t-esc="group.qty_status_text"/></div>
                            </t>

                            <t t-foreach="group.marking_ids" t-as="marking">
                                <form method="post" enctype="multipart/form-data" class="sp-marking">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="save_marking"/>
                                    <input type="hidden" name="marking_id" t-att-value="marking.id"/>
                                    <div class="sp-marking-head">
                                        <h3><t t-esc="marking.name"/> · <t t-esc="marking.qty_total"/> uds</h3>
                                        <button class="sp-btn" type="submit">Guardar</button>
                                    </div>

                                    <div class="sp-editor">
                                        <div class="sp-mockups">
                                            <div class="sp-mockup-box">
                                                <div class="sp-mockup-label">Delante</div>
                                                <t t-if="group.group_type == 'cap'">
                                                    <div class="sp-garment sp-cap">
                                                        <t t-foreach="marking.placement_ids" t-as="placement">
                                                            <t t-if="placement.side in ('front', 'side')">
                                                                <div t-attf-class="sp-logo-token #{placement.placement_key}">
                                                                    <t t-if="placement.preview_image"><img t-att-src="'/personalizacion/%s/ubicacion/%s/preview' % (personalization.access_token, placement.id)"/></t>
                                                                    <t t-else="">LOGO</t>
                                                                </div>
                                                            </t>
                                                        </t>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <div t-attf-class="sp-garment sp-shirt sp-#{group.garment_color_key or 'default'}">
                                                        <span class="neck"/>
                                                        <t t-foreach="marking.placement_ids" t-as="placement">
                                                            <t t-if="placement.side == 'front'">
                                                                <div t-attf-class="sp-logo-token #{placement.placement_key}">
                                                                    <t t-if="placement.preview_image"><img t-att-src="'/personalizacion/%s/ubicacion/%s/preview' % (personalization.access_token, placement.id)"/></t>
                                                                    <t t-else="">LOGO</t>
                                                                </div>
                                                            </t>
                                                        </t>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="sp-mockup-box" t-if="group.group_type != 'cap'">
                                                <div class="sp-mockup-label">Espalda</div>
                                                <div t-attf-class="sp-garment sp-shirt sp-#{group.garment_color_key or 'default'}">
                                                    <span class="neck"/>
                                                    <t t-foreach="marking.placement_ids" t-as="placement">
                                                        <t t-if="placement.side == 'back'">
                                                            <div t-attf-class="sp-logo-token #{placement.placement_key}">
                                                                <t t-if="placement.preview_image"><img t-att-src="'/personalizacion/%s/ubicacion/%s/preview' % (personalization.access_token, placement.id)"/></t>
                                                                <t t-else="">LOGO</t>
                                                            </div>
                                                        </t>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>

                                        <div>
                                            <div class="sp-fields">
                                                <div class="sp-field"><label>Nombre</label><input name="name" t-att-value="marking.name"/></div>
                                                <div class="sp-field"><label>Técnica</label><select name="technique"><t t-foreach="technique_options" t-as="opt"><option t-att-value="opt[0]" t-att-selected="opt[0] == marking.technique"><t t-esc="opt[1]"/></option></t></select></div>
                                                <div class="sp-field"><label>Posición</label><select name="position"><t t-foreach="position_options" t-as="opt"><option t-att-value="opt[0]" t-att-selected="opt[0] == marking.position"><t t-esc="opt[1]"/></option></t></select></div>
                                                <div class="sp-field"><label>Color</label><select name="print_color"><t t-foreach="color_options" t-as="opt"><option t-att-value="opt[0]" t-att-selected="opt[0] == marking.print_color"><t t-esc="opt[1]"/></option></t></select></div>
                                                <div class="sp-field"><label>Ancho cm</label><input type="number" step="0.1" name="width_cm" t-att-value="marking.width_cm"/></div>
                                                <div class="sp-field"><label>Alto cm</label><input type="number" step="0.1" name="height_cm" t-att-value="marking.height_cm"/></div>
                                            </div>

                                            <div class="mt-3">
                                                <div class="sp-subtitle">Tallas de este marcaje</div>
                                                <div class="sp-sizes">
                                                    <t t-foreach="marking.size_ids" t-as="size_line">
                                                        <div class="sp-field">
                                                            <label><t t-esc="size_line.size_name"/></label>
                                                            <input type="number" step="1" min="0" t-att-name="'size_qty_%s' % size_line.id" t-att-value="size_line.qty"/>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>

                                            <div class="sp-files">
                                                <t t-foreach="marking.placement_ids" t-as="placement">
                                                    <div class="sp-file">
                                                        <strong><t t-esc="placement.placement_label"/></strong>
                                                        <div class="sp-file-preview">
                                                            <t t-if="placement.preview_image"><img t-att-src="'/personalizacion/%s/ubicacion/%s/preview' % (personalization.access_token, placement.id)"/></t>
                                                            <t t-else="">Sin preview</t>
                                                        </div>
                                                        <div class="sp-field"><label>Producción</label><input type="file" t-att-name="'production_%s' % placement.id"/></div>
                                                        <div class="sp-field mt-2"><label>Preview</label><input type="file" t-att-name="'preview_%s' % placement.id"/></div>
                                                    </div>
                                                </t>
                                            </div>

                                            <div class="sp-field mt-3">
                                                <label>Notas</label>
                                                <textarea name="notes"><t t-esc="marking.notes or ''"/></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </t>

                            <t t-if="group.marking_ids">
                                <form method="post" class="m-3">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="action" value="add_marking"/>
                                    <input type="hidden" name="group_id" t-att-value="group.id"/>
                                    <button class="sp-btn-light" type="submit">+ Otro marcaje</button>
                                </form>
                            </t>
                        </section>
                    </t>

                    <form method="post" class="sp-notes">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="action" value="confirm"/>
                        <div class="sp-field">
                            <label>Notas generales</label>
                            <textarea name="customer_notes"><t t-esc="personalization.customer_notes or ''"/></textarea>
                        </div>
                        <button type="submit" class="sp-btn mt-3">Enviar ficha</button>
                    </form>

                    <div class="sp-footer">
                        <strong><t t-esc="personalization.group_count"/> grupos · <t t-esc="personalization.marking_count"/> marcajes</strong>
                        <span>Cliente y taller ven lo mismo.</span>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_sale_order_personalization_button" inherit_id="sale.sale_order_portal_content" name="Sale Portal Personalization Button">
        <xpath expr="//div[@id='intro_row']" position="inside">
            <t t-if="report_type == 'html' and sale_order.sp_has_textile_personalization_lines">
                <a class="btn btn-primary ms-auto d-print-none"
                   t-attf-href="/personalizacion/presupuesto/#{sale_order.id}?access_token=#{sale_order.access_token}">
                    <i class="fa fa-paint-brush me-1"/> Personalización textil
                </a>
            </t>
        </xpath>
    </template>
</odoo>
