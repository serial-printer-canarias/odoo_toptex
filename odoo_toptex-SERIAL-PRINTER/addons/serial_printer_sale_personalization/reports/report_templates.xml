<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sp_personalization_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .sp-blue { color:#1f3cff; }
                            .sp-box { border:1px solid #d9e1f2; border-radius:10px; padding:10px; margin-bottom:12px; }
                            .sp-soft { background:#f6f8ff; }
                            .sp-img { max-height:120px; max-width:100%; object-fit:contain; }
                            .sp-logo { max-height:95px; max-width:100%; object-fit:contain; }
                            table.sp-table { width:100%; border-collapse:collapse; margin-top:6px; }
                            table.sp-table td, table.sp-table th { border:1px solid #d9e1f2; padding:6px; font-size:12px; vertical-align:top; }
                            .sp-muted { color:#64748b; font-size:12px; }
                        </style>
                        <h2 class="sp-blue">Ficha de taller - Personalización</h2>
                        <div class="sp-box">
                            <strong>Ficha:</strong> <span t-esc="doc.name"/><br/>
                            <strong>Cliente:</strong> <span t-esc="doc.partner_id.name"/><br/>
                            <strong>Presupuesto:</strong> <span t-esc="doc.sale_order_id.name or '-'"/><br/>
                            <strong>Factura:</strong> <span t-esc="doc.account_move_id.name or '-'"/><br/>
                            <strong>Estado:</strong> <span t-esc="dict(doc._fields['state'].selection).get(doc.state)"/>
                        </div>
                        <t t-foreach="doc.group_ids" t-as="group">
                            <div class="sp-box sp-soft">
                                <table style="width:100%; border:0;">
                                    <tr>
                                        <td style="width:22%; border:0;">
                                            <t t-if="group.product_image_1920"><img t-att-src="'/web/image/sp.personalization.group/%s/product_image_1920' % group.id" class="sp-img"/></t>
                                            <t t-else=""><span class="sp-muted">Sin imagen producto</span></t>
                                        </td>
                                        <td style="border:0;">
                                            <h3><span t-esc="group.product_name"/></h3>
                                            <p>Ref. <strong t-esc="group.product_ref"/> · Color prenda: <strong t-esc="group.color_name"/></p>
                                            <p>Cantidad: <strong t-esc="group.qty_total"/> · Tallas: <strong t-esc="group.size_summary"/></p>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <t t-foreach="group.marking_ids" t-as="marking">
                                <div class="sp-box">
                                    <h4 class="sp-blue">Marcaje: <span t-esc="marking.name"/></h4>
                                    <table class="sp-table">
                                        <tr>
                                            <th>Técnica</th><th>Posición</th><th>Color tinta/hilo</th><th>Tamaño</th><th>Cantidad</th>
                                        </tr>
                                        <tr>
                                            <td t-esc="marking.technique_label"/>
                                            <td t-esc="marking.position_label"/>
                                            <td><span t-att-style="'display:inline-block;width:10px;height:10px;border:1px solid #999;background:%s;' % (marking.print_color_hex or '#fff')"></span> <span t-esc="marking.print_color_label"/></td>
                                            <td><span t-esc="marking.size_mode_label"/><t t-if="marking.width_cm or marking.height_cm"> - <span t-esc="marking.width_cm or '-'"/> x <span t-esc="marking.height_cm or '-'"/> cm</t></td>
                                            <td t-esc="marking.qty_total"/>
                                        </tr>
                                    </table>
                                    <h5>Tallas</h5>
                                    <table class="sp-table">
                                        <tr><t t-foreach="marking.size_line_ids" t-as="s"><th t-esc="s.size_name"/></t></tr>
                                        <tr><t t-foreach="marking.size_line_ids" t-as="s"><td t-esc="s.qty"/></t></tr>
                                    </table>
                                    <h5>Mockup / Archivos por ubicación</h5>
                                    <table class="sp-table">
                                        <tr><th>Ubicación</th><th>Preview visible</th><th>Archivo producción</th><th>Archivo preview</th></tr>
                                        <t t-foreach="marking.placement_ids" t-as="placement">
                                            <tr>
                                                <td><strong t-esc="placement.placement_label"/><br/><span class="sp-muted" t-esc="dict(placement._fields['side'].selection).get(placement.side)"/></td>
                                                <td><t t-if="placement.preview_image"><img t-att-src="'/web/image/sp.personalization.placement/%s/preview_image' % placement.id" class="sp-logo"/></t><t t-else="">Sin preview</t></td>
                                                <td t-esc="placement.production_filename or 'pendiente'"/>
                                                <td t-esc="placement.preview_filename or 'pendiente'"/>
                                            </tr>
                                        </t>
                                    </table>
                                    <t t-if="marking.notes"><p><strong>Observaciones:</strong> <span t-esc="marking.notes"/></p></t>
                                </div>
                            </t>
                        </t>
                        <t t-if="doc.customer_notes"><div class="sp-box"><strong>Notas cliente:</strong><p t-esc="doc.customer_notes"/></div></t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
