<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sp_personalization_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>.spbox{border:1px solid #d9e1f2;padding:10px;margin-bottom:12px}.spimg{max-height:120px;max-width:100%;object-fit:contain}.splogo{max-height:100px;max-width:100%;object-fit:contain}.sptable{width:100%;border-collapse:collapse}.sptable td,.sptable th{border:1px solid #d9e1f2;padding:6px;font-size:12px}</style>
                        <h2 style="color:#1f3cff">Ficha de taller - Personalización</h2>
                        <div class="spbox"><strong>Ficha:</strong> <span t-esc="doc.name"/><br/><strong>Cliente:</strong> <span t-esc="doc.partner_id.name"/><br/><strong>Presupuesto:</strong> <span t-esc="doc.sale_order_id.name or '-'"/><br/><strong>Factura:</strong> <span t-esc="doc.account_move_id.name or '-'"/></div>
                        <t t-foreach="doc.group_ids" t-as="group">
                            <div class="spbox">
                                <table style="width:100%"><tr><td style="width:20%"><t t-if="group.product_image_1920"><img t-att-src="'/web/image/sp.personalization.group/%s/product_image_1920' % group.id" class="spimg"/></t></td><td><h3><span t-esc="group.product_name"/></h3><p>Ref. <strong t-esc="group.product_ref"/> · Color prenda: <strong t-esc="group.color_name"/></p><p>Cantidad: <strong t-esc="group.qty_total"/> · Tallas: <strong t-esc="group.size_summary"/></p><p><strong>Estado:</strong> <span t-esc="dict(group._fields['status'].selection).get(group.status)"/> · <span t-esc="group.qty_status_text"/></p></td></tr></table>
                                <t t-if="group.status == 'no'"><p><strong>No personalizar este grupo.</strong></p></t>
                            </div>
                            <t t-foreach="group.marking_ids" t-as="marking">
                                <div class="spbox">
                                    <h4 style="color:#1f3cff"><span t-esc="marking.name"/></h4>
                                    <table class="sptable"><tr><th>Técnica</th><th>Posición</th><th>Color</th><th>Tamaño</th><th>Cantidad</th></tr><tr><td t-esc="dict(marking._fields['technique'].selection).get(marking.technique)"/><td t-esc="dict(marking._fields['position'].selection).get(marking.position)"/><td t-esc="dict(marking._fields['print_color'].selection).get(marking.print_color)"/><td><span t-esc="dict(marking._fields['size_mode'].selection).get(marking.size_mode)"/> <t t-if="marking.width_cm or marking.height_cm"> - <span t-esc="marking.width_cm or '-'"/> x <span t-esc="marking.height_cm or '-'"/> cm</t></td><td t-esc="marking.qty_total"/></tr></table>
                                    <h5>Tallas</h5><table class="sptable"><tr><t t-foreach="marking.size_ids" t-as="s"><th t-esc="s.size_name"/></t></tr><tr><t t-foreach="marking.size_ids" t-as="s"><td t-esc="s.qty"/></t></tr></table>
                                    <h5>Archivos y previews por ubicación</h5>
                                    <table class="sptable"><tr><th>Ubicación</th><th>Preview</th><th>Producción</th><th>Preview archivo</th></tr><t t-foreach="marking.placement_ids" t-as="placement"><tr><td><strong t-esc="placement.placement_label"/></td><td><t t-if="placement.preview_image"><img t-att-src="'/web/image/sp.personalization.placement/%s/preview_image' % placement.id" class="splogo"/></t><t t-else="">Sin preview</t></td><td t-esc="placement.production_filename or 'pendiente'"/><td t-esc="placement.preview_filename or 'pendiente'"/></tr></t></table>
                                    <t t-if="marking.notes"><p><strong>Observaciones:</strong> <span t-esc="marking.notes"/></p></t>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
