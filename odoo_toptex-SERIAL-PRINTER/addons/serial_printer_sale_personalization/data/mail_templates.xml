<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_personalization_customer" model="mail.template">
        <field name="name">Serial Printer - Enlace personalización cliente</field>
        <field name="model_id" ref="model_sp_personalization_order"/>
        <field name="subject">Ficha de personalización - {{ object.name }}</field>
        <field name="email_from">{{ object.company_id.email or user.email }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hola <t t-out="object.partner_id.name"/>,</p>
                <p>Hemos preparado la ficha para confirmar la personalización de tu pedido.</p>
                <p>Por favor, entra en este enlace y sube los logos, colores, posiciones y observaciones:</p>
                <p><a t-att-href="object.portal_url" style="background:#1f3cff;color:#ffffff;padding:12px 18px;border-radius:10px;text-decoration:none;">Abrir ficha de personalización</a></p>
                <p>Formatos recomendados para producción: PDF, AI, EPS o SVG. Para preview visible: PNG, JPG, WEBP o SVG.</p>
                <p>Gracias,<br/>Serial Printer</p>
            </div>
        </field>
    </record>

    <record id="mail_template_personalization_internal_received" model="mail.template">
        <field name="name">Serial Printer - Personalización recibida</field>
        <field name="model_id" ref="model_sp_personalization_order"/>
        <field name="subject">Personalización recibida - {{ object.name }}</field>
        <field name="email_from">{{ object.company_id.email or user.email }}</field>
        <field name="email_to">{{ object.sale_order_id.user_id.email or user.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Se ha recibido una ficha de personalización.</p>
                <p><strong>Ficha:</strong> <t t-out="object.name"/><br/><strong>Cliente:</strong> <t t-out="object.partner_id.name"/></p>
                <p><a t-att-href="object.portal_url">Abrir enlace cliente</a></p>
            </div>
        </field>
    </record>
</odoo>
