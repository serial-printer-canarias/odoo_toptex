<odoo>
    <record id="view_form_personalizacion" model="ir.ui.view">
        <field name="name">product.personalizacion.form</field>
        <field name="model">product.personalizacion</field>
        <field name="arch" type="xml">
            <form string="Personalización">
                <group>
                    <field name="tecnica"/>
                    <field name="posicion"/>
                    <field name="color_impresion"/>
                    <field name="tamano_diseno"/>
                    <field name="logo" filename="logo_filename"/>
                    <field name="observaciones"/>
                </group>
            </form>
        </field>
    </record>
</odoo>