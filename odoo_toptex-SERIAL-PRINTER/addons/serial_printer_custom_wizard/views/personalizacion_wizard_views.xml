<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- FORM de product.personalizacion -->
  <record id="view_product_personalizacion_form" model="ir.ui.view">
    <field name="name">product.personalizacion.form</field>
    <field name="model">product.personalizacion</field>
    <field name="arch" type="xml">
      <form string="Personalización">
        <sheet>
          <group>
            <field name="product_tmpl_id"/>
            <field name="logo"/>
            <field name="tecnica_personalizacion"/>
            <field name="posicion_diseno"/>
            <field name="color_impresion"/>
            <field name="cantidad"/>
            <field name="observaciones"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- LIST (en Odoo 17 sustituye a tree) -->
  <record id="view_product_personalizacion_list" model="ir.ui.view">
    <field name="name">product.personalizacion.list</field>
    <field name="model">product.personalizacion</field>
    <field name="arch" type="xml">
      <list string="Personalizaciones">
        <field name="product_tmpl_id"/>
        <field name="tecnica_personalizacion"/>
        <field name="posicion_diseno"/>
        <field name="color_impresion"/>
        <field name="cantidad"/>
        <field name="create_date"/>
      </list>
    </field>
  </record>

  <!-- Acción y menú (opcional, útil para revisar registros) -->
  <record id="action_product_personalizacion" model="ir.actions.act_window">
    <field name="name">Personalizaciones</field>
    <field name="res_model">product.personalizacion</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_product_personalizacion_root"
            name="Personalizaciones"
            parent="website.menu_website_configuration"
            action="action_product_personalizacion"
            sequence="90"/>
</odoo>