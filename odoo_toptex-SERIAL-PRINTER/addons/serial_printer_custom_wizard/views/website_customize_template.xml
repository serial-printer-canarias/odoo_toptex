<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="customize_product_template" name="Formulario de personalización de productos">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h1 class="text-center mb-4">Personaliza tu producto</h1>

                <form action="/personalizar/enviar" method="post" enctype="multipart/form-data" class="form">
                    <div class="form-group">
                        <label for="logo">Sube tu logo (PNG, JPG, SVG)</label>
                        <input type="file" name="logo" class="form-control" required="required" />
                    </div>

                    <div class="form-group">
                        <label for="tecnica">Técnica de personalización</label>
                        <select name="tecnica" class="form-control" required="required">
                            <option value="">-- Selecciona una técnica --</option>
                            <option value="serigrafia">Serigrafía</option>
                            <option value="bordado">Bordado</option>
                            <option value="dtf">DTF</option>
                            <option value="ninguna">Ninguna</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="posicion">Posición del diseño</label>
                        <select name="posicion" class="form-control" required="required">
                            <option value="">-- Selecciona una posición --</option>
                            <option value="pecho">Pecho</option>
                            <option value="espalda">Espalda</option>
                            <option value="manga">Manga</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="color_impresion">Color de impresión</label>
                        <input type="text" name="color_impresion" class="form-control" placeholder="Ej: blanco, negro, dorado..." />
                    </div>

                    <div class="form-group">
                        <label for="tamano_dibujo">Tamaño del diseño</label>
                        <select name="tamano_dibujo" class="form-control" required="required">
                            <option value="">-- Selecciona un tamaño --</option>
                            <option value="pequeno">Pequeño (10x10 cm)</option>
                            <option value="mediano">Mediano (20x20 cm)</option>
                            <option value="grande">Grande (30x30 cm)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="observaciones">Observaciones</label>
                        <textarea name="observaciones" class="form-control" rows="4" placeholder="Indica cualquier detalle adicional..."></textarea>
                    </div>

                    <div class="form-group text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Enviar personalización</button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="customize_product_success" name="Gracias por personalizar">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5 text-center">
                <h1>¡Gracias!</h1>
                <p>Hemos recibido tu solicitud de personalización. Nos pondremos en contacto contigo pronto.</p>
                <a href="/" class="btn btn-secondary mt-3">Volver al inicio</a>
            </div>
        </t>
    </template>
</odoo>