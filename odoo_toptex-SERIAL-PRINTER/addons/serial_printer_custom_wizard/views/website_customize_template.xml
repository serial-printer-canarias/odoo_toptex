<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="website_personalizar_page" name="SPW Personalizar">
    <t t-call="website.layout">
      <div class="container my-5">
        <h1 class="mb-3">
          Personalizar: <t t-esc="product.display_name"/>
        </h1>
        <div class="alert alert-info">
          Página de prueba del personalizador (ruta y contexto OK).
        </div>
        <a t-att-href="product.website_url" class="btn btn-secondary mt-3">
          ← Volver al producto
        </a>
      </div>
    </t>
  </template>
</odoo>