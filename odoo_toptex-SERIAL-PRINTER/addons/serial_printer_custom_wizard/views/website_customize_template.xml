<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Página pública con el formulario de personalización -->
    <template id="customize_product_template" name="Página de personalización">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">
                    Personalización de <t t-esc="product.display_name"/>
                </h1>

                <form action="/personalizacion/submit"
                      method="post"
                      enctype="multipart/form-data"
                      class="o_website_form">

                    <input type="hidden" name="product_id" t-att-value="product.id"/>

                    <!-- Logo -->
                    <div class="form-group mb-3">
                        <label for="logo">Sube tu logo</label>
                        <input type="file" name="logo" id="logo" class="form-control"/>
                    </div>

                    <!-- Técnica -->
                    <div class="form-group mb-3">
                        <label for="tecnica">Técnica de impresión</label>
                        <select name="tecnica" id="tecnica" class="form-control">
                            <option value="serigrafia">Serigrafía</option>
                            <option value="bordado">Bordado</option>
                            <option value="dtf">DTF</option>
                            <option value="ninguna" selected="selected">Ninguna</option>
                        </select>
                    </div>

                    <!-- Posición -->
                    <div class="form-group mb-3">
                        <label for="posicion">Posición del diseño</label>
                        <select name="posicion" id="posicion" class="form-control">
                            <option value="pecho">Pecho</option>
                            <option value="espalda">Espalda</option>
                        </select>
                    </div>

                    <!-- Tamaño -->
                    <div class="form-group mb-3">
                        <label for="tamano">Tamaño del diseño</label>
                        <select name="tamano" id="tamano" class="form-control">
                            <option value="pequeno">Pequeño</option>
                            <option value="mediano" selected="selected">Mediano</option>
                            <option value="grande">Grande</option>
                        </select>
                    </div>

                    <!-- Color -->
                    <div class="form-group mb-3">
                        <label for="color_impresion">Color de impresión</label>
                        <input type="text" name="color_impresion" id="color_impresion" class="form-control"/>
                    </div>

                    <!-- Observaciones -->
                    <div class="form-group mb-4">
                        <label for="observaciones">Observaciones</label>
                        <textarea name="observaciones" id="observaciones" class="form-control" rows="3"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Guardar personalización
                    </button>
                    <a t-att-href="'/shop/product/%s' % product.id"
                       class="btn btn-link ms-2">Volver al producto</a>
                </form>
            </div>
        </t>
    </template>
</odoo>