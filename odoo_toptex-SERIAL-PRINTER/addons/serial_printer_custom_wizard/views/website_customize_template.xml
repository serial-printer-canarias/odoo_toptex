<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="customize_product_template" name="Personalización de producto" inherit_id="website.layout">
    <xpath expr="//main" position="inside">
      <div class="container my-5">
        <h1 class="mb-4">Personalización</h1>
        <form t-att-action="'/personalizacion/%s' % product.id" method="post" enctype="multipart/form-data">
          <!-- aquí tus campos de logo / técnica / posición / color / tamaño / observaciones -->
        </form>
      </div>
    </xpath>
  </template>
</odoo>