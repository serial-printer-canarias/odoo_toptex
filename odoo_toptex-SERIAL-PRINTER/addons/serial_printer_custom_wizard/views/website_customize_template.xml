<!-- views/website_customize_template.xml -->
<odoo>
  <template id="form_personalization_portal" name="Formulario de personalización desde pedido" inherit_id="portal.portal_my_home">
    <t t-call="website.layout">
      <div class="container my-5">
        <h2>Personalización de tu producto</h2>
        <form action="#" method="post" enctype="multipart/form-data">
          <div class="form-group">
            <label>Logo (PNG, SVG):</label>
            <input type="file" name="logo" class="form-control" required="1"/>
          </div>
          <div class="form-group">
            <label>Técnica:</label>
            <select name="technique" class="form-control">
              <option value="serigrafia">Serigrafía</option>
              <option value="bordado">Bordado</option>
              <option value="dtf">DTF</option>
              <option value="ninguna">Sin personalización</option>
            </select>
          </div>
          <div class="form-group">
            <label>Zona:</label>
            <select name="position" class="form-control">
              <option value="pecho">Pecho</option>
              <option value="espalda">Espalda</option>
              <option value="manga_derecha">Manga derecha</option>
              <option value="manga_izquierda">Manga izquierda</option>
            </select>
          </div>
          <div class="form-group">
            <label>Tamaño del diseño:</label>
            <select name="size" class="form-control">
              <option value="pequeno">Pequeño</option>
              <option value="mediano">Mediano</option>
              <option value="grande">Grande</option>
            </select>
          </div>
          <div class="form-group">
            <label>Color de impresión:</label>
            <select name="print_color" class="form-control">
              <option value="blanco">Blanco</option>
              <option value="negro">Negro</option>
              <option value="rojo">Rojo</option>
              <option value="azul">Azul</option>
              <option value="amarillo">Amarillo</option>
              <option value="verde">Verde</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label>Observaciones:</label>
            <textarea name="notes" class="form-control"></textarea>
          </div>
          <button type="submit" class="btn btn-primary mt-3">Guardar personalización</button>
        </form>
      </div>
    </t>
  </template>

  <template id="form_personalization_public" name="Formulario público de personalización">
    <t t-call="website.layout">
      <div class="container my-5">
        <h2>Personaliza tu prenda</h2>
        <p class="text-muted">Sube tu logo y configura tu personalización. Te contactaremos con un presupuesto.</p>
        <form action="/customize/submit" method="post" enctype="multipart/form-data">
          <input type="hidden" name="product_id" t-att-value="product.id"/>

          <!-- mismo formulario que el portal -->
          <div class="form-group">
            <label>Logo (PNG, SVG):</label>
            <input type="file" name="logo" class="form-control" required="1"/>
          </div>
          <div class="form-group">
            <label>Técnica:</label>
            <select name="technique" class="form-control">
              <option value="serigrafia">Serigrafía</option>
              <option value="bordado">Bordado</option>
              <option value="dtf">DTF</option>
              <option value="ninguna">Sin personalización</option>
            </select>
          </div>
          <div class="form-group">
            <label>Zona:</label>
            <select name="position" class="form-control">
              <option value="pecho">Pecho</option>
              <option value="espalda">Espalda</option>
              <option value="manga_derecha">Manga derecha</option>
              <option value="manga_izquierda">Manga izquierda</option>
            </select>
          </div>
          <div class="form-group">
            <label>Tamaño del diseño:</label>
            <select name="size" class="form-control">
              <option value="pequeno">Pequeño</option>
              <option value="mediano">Mediano</option>
              <option value="grande">Grande</option>
            </select>
          </div>
          <div class="form-group">
            <label>Color de impresión:</label>
            <select name="print_color" class="form-control">
              <option value="blanco">Blanco</option>
              <option value="negro">Negro</option>
              <option value="rojo">Rojo</option>
              <option value="azul">Azul</option>
              <option value="amarillo">Amarillo</option>
              <option value="verde">Verde</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label>Observaciones:</label>
            <textarea name="notes" class="form-control"></textarea>
          </div>

          <div class="form-group">
            <label>Tu nombre:</label>
            <input type="text" name="name" class="form-control" required="1"/>
          </div>
          <div class="form-group">
            <label>Tu email:</label>
            <input type="email" name="email" class="form-control" required="1"/>
          </div>

          <button type="submit" class="btn btn-primary mt-3">Enviar diseño</button>
        </form>
      </div>
    </t>
  </template>
</odoo>