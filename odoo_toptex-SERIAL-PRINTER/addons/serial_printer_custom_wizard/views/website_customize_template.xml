<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="customize_product_template" name="Personalizar Producto">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Personaliza tu producto</h1>
                <form action="/personalizar/enviar" method="post" enctype="multipart/form-data">

                    <div class="form-group mb-3">
                        <label for="logo">Sube tu logotipo</label>
                        <input type="file" class="form-control" name="logo" required/>
                    </div>

                    <div class="form-group mb-3">
                        <label for="tecnica">Técnica de personalización</label>
                        <select class="form-control" name="tecnica" required>
                            <option value="serigrafia">Serigrafía</option>
                            <option value="bordado">Bordado</option>
                            <option value="dtf">DTF</option>
                            <option value="ninguna">Ninguna</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="posicion">Posición del diseño</label>
                        <select class="form-control" name="posicion" required>
                            <option value="pecho">Pecho</option>
                            <option value="espalda">Espalda</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="color_impresion">Color de impresión</label>
                        <input type="text" class="form-control" name="color_impresion"/>
                    </div>

                    <div class="form-group mb-3">
                        <label for="tamano_dibujo">Tamaño del diseño</label>
                        <select class="form-control" name="tamano_dibujo" required>
                            <option value="pequeno">Pequeño</option>
                            <option value="mediano">Mediano</option>
                            <option value="grande">Grande</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="observaciones">Observaciones</label>
                        <textarea class="form-control" name="observaciones" rows="4"></textarea>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary">Enviar personalización</button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="customize_product_success" name="Gracias por tu envío">
        <t t-call="website.layout">
            <div class="container my-5">
                <h2 class="text-success">Gracias</h2>
                <p>Hemos recibido tu solicitud de personalización. Nuestro equipo la revisará y se pondrá en contacto contigo.</p>
                <a class="btn btn-primary mt-3" href="/shop">Volver a la tienda</a>
            </div>
        </t>
    </template>
</odoo>