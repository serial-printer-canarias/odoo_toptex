<odoo>
    <template id="formulario_personalizacion" name="Formulario de Personalización Portal">
        <t t-call="website.layout">
            <div class="container mt-4 mb-5">
                <h1>Personaliza tu pedido</h1>
                <form action="#" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="order_line_id" t-att-value="order_line.id"/>

                    <div class="form-group">
                        <label for="logo">Logo:</label>
                        <input type="file" name="logo" class="form-control"/>
                    </div>

                    <div class="form-group">
                        <label for="tecnica">Técnica:</label>
                        <select name="tecnica_personalizacion" class="form-control">
                            <option value="serigrafia">Serigrafía</option>
                            <option value="bordado">Bordado</option>
                            <option value="dtf">DTF</option>
                            <option value="ninguna">Ninguna</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="posicion">Posición del diseño:</label>
                        <select name="posicion_diseno" class="form-control">
                            <option value="front">Frontal</option>
                            <option value="back">Espalda</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="tamano">Tamaño del diseño:</label>
                        <select name="tamano_diseno" class="form-control">
                            <option value="small">Pequeño</option>
                            <option value="medium">Mediano</option>
                            <option value="large">Grande</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="color">Color de impresión:</label>
                        <input type="text" name="color" class="form-control" placeholder="Ej: Blanco, Negro, etc."/>
                    </div>

                    <div class="form-group">
                        <label for="observaciones">Observaciones:</label>
                        <textarea name="observaciones" class="form-control" rows="3"/>
                    </div>

                    <button type="submit" class="btn btn-primary mt-2">Guardar Personalización</button>
                </form>
            </div>
        </t>
    </template>

    <template id="formulario_personalizacion_publica" name="Formulario de Personalización Público">
        <t t-call="website.layout">
            <div class="container mt-4 mb-5">
                <h1>Personaliza este producto</h1>
                <p>Producto: <strong t-esc="product.display_name"/></p>
                <t t-call="serial_printer_custom_wizard.formulario_personalizacion"/>
            </div>
        </t>
    </template>

    <template id="personalizacion_no_editable" name="Personalización No Editable">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h2>La personalización de este pedido ya no se puede modificar.</h2>
                <p>Por favor, contacta con atención al cliente si necesitas realizar cambios.</p>
            </div>
        </t>
    </template>
</odoo>