<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="customize_product_template" name="Personalizar producto">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">Personalizar: <t t-esc="product.display_name"/></h1>

                <form action="/personalizacion/enviar"
                      method="post"
                      enctype="multipart/form-data"
                      class="oe_website_login">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="product_tmpl_id" t-att-value="product.id"/>

                    <!-- Logo -->
                    <div class="form-group mb-3">
                        <label for="logo">Sube tu logo</label>
                        <input type="file" class="form-control" id="logo" name="logo"/>
                    </div>

                    <!-- Técnica -->
                    <div class="form-group mb-3">
                        <label for="tecnica">Técnica de personalización</label>
                        <select class="form-control" id="tecnica" name="tecnica">
                            <option value="serigrafia">Serigrafía</option>
                            <option value="bordado">Bordado</option>
                            <option value="dtf">DTF</option>
                            <option value="ninguna">Ninguna</option>
                        </select>
                    </div>

                    <!-- Posición -->
                    <div class="form-group mb-3">
                        <label for="posicion">Posición del diseño</label>
                        <select class="form-control" id="posicion" name="posicion">
                            <option value="front">Frontal</option>
                            <option value="back">Espalda</option>
                        </select>
                    </div>

                    <!-- Tamaño -->
                    <div class="form-group mb-3">
                        <label for="tamano">Tamaño del diseño</label>
                        <select class="form-control" id="tamano" name="tamano">
                            <option value="small">Pequeño</option>
                            <option value="medium">Mediano</option>
                            <option value="large">Grande</option>
                        </select>
                    </div>

                    <!-- Color -->
                    <div class="form-group mb-3">
                        <label for="color_impresion">Color de impresión</label>
                        <input type="text" class="form-control" id="color_impresion" name="color_impresion"/>
                    </div>

                    <!-- Observaciones -->
                    <div class="form-group mb-3">
                        <label for="observaciones">Observaciones</label>
                        <textarea class="form-control" id="observaciones" name="observaciones"></textarea>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary">Enviar personalización</button>
                        <a t-att-href="'/shop/product/%s' % (slug(product))" class="btn btn-link">Volver al producto</a>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="customize_thanks" name="Gracias personalización">
        <t t-call="website.layout">
            <div class="container my-5">
                <h2>¡Gracias!</h2>
                <p>Hemos recibido tu solicitud de personalización para
                    <strong t-esc="product.display_name"/>.</p>
                <a href="/shop" class="btn btn-primary mt-3">Seguir comprando</a>
            </div>
        </t>
    </template>

</odoo>