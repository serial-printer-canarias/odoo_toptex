<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Página del personalizador -->
  <template id="website_personalizar_page" name="SPW Personalizar">
    <t t-call="website.layout">
      <div class="container my-5">
        <h1 class="mb-4">
          Personalizar:
          <t t-esc="product.display_name"/>
        </h1>

        <div class="row g-4">
          <!-- Pre-visualización -->
          <div class="col-12 col-lg-6">
            <div id="spw-preview" class="spw-preview shadow-sm">
              <img id="spw-base"
                   t-att-src="base_image_url"
                   alt="Producto" />
              <img id="spw-logo" alt="Logo" style="display:none;" />
            </div>

            <!-- Thumbnails de variantes -->
            <div class="d-flex flex-wrap gap-2 mt-3">
              <t t-foreach="variant_thumbs" t-as="v">
                <img t-att-src="v['img']"
                     t-att-alt="v['name']"
                     t-att-data-variant_id="v['id']"
                     class="spw-thumb" />
              </t>
            </div>
          </div>

          <!-- Formulario -->
          <div class="col-12 col-lg-6">
            <form action="#" method="post" enctype="multipart/form-data" class="o_website_form">
              <!-- la variante seleccionada -->
              <input type="hidden" id="variant_id" name="variant_id" t-att-value="variant_id or ''"/>

              <div class="mb-3">
                <label class="form-label fw-semibold">Subir logo (PNG/JPG/SVG)</label>
                <input type="file" id="spw_logo_input" name="logo" accept=".png,.jpg,.jpeg,.svg" class="form-control"/>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Técnica de personalización</label>
                <select class="form-select" name="tecnica_personalizacion" id="tecnica">
                  <option value="DTF">DTF</option>
                  <option value="Vinilo">Vinilo</option>
                  <option value="Bordado">Bordado</option>
                  <option value="Sublimación">Sublimación</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Posición</label>
                <select class="form-select" name="posicion_diseno" id="posicion">
                  <option value="pecho">Pecho</option>
                  <option value="espalda">Espalda</option>
                  <option value="manga_izquierda">Manga Izquierda</option>
                  <option value="manga_derecha">Manga Derecha</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Color de impresión</label>
                <input type="text" class="form-control" name="color_impresion" placeholder="Ej. Blanco / Pantone 186C"/>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Cantidad</label>
                <input type="number" min="1" value="1" name="cantidad" class="form-control"/>
              </div>

              <div class="mb-4">
                <label class="form-label fw-semibold">Observaciones</label>
                <textarea name="observaciones" class="form-control" rows="3" placeholder="Notas para el taller..."></textarea>
              </div>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                  Añadir al carrito con personalización
                </button>
                <a t-attf-href="/shop/product/#{product.id}"
                   class="btn btn-secondary">
                  ← Volver al producto
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </t>
  </template>

</odoo>