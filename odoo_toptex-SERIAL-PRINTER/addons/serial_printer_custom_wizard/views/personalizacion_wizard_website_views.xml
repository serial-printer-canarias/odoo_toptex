<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Página básica para /personalizar/<id> -->
    <template id="personalizar" name="SPW Personalizar">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1 class="mb-4">
                    Personalizar: <t t-esc="product.name"/>
                </h1>
                <p>ID del producto: <t t-esc="product.id"/></p>

                <!-- Aquí luego pondremos el formulario/wizard real -->
                <div class="alert alert-info">
                    Página de prueba del personalizador (funciona la ruta).
                </div>
                <a class="btn btn-secondary" t-att-href="'/shop/product/%s' % product.id">
                    ← Volver al producto
                </a>
            </div>
        </t>
    </template>
</odoo>