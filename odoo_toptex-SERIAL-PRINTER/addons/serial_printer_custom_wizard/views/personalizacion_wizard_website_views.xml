<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Página del personalizador con preview -->
  <template id="website_personalizar_page" name="SPW Personalizar">
    <t t-call="website.layout">
      <div class="container my-6 spw-customizer">
        <h1 class="mb-4">
          Personalizar:
          <t t-esc="product.name"/>
        </h1>

        <div class="row g-5">
          <!-- Columna PREVIEW -->
          <div class="col-12 col-lg-6">
            <div class="spw-preview">
              <!-- Imagen base = plantilla o variante -->
              <t t-set="base_src">
                <t t-if="variant_id">
                  <t t-esc="'/web/image/product.product/%s/image_1920' % variant_id"/>
                </t>
                <t t-if="not variant_id">
                  <t t-esc="'/web/image/product.template/%s/image_1920' % product.id"/>
                </t>
              </t>
              <img t-att-src="base_src" id="spw_base_img" alt="Producto"/>

              <!-- Slot de posicionamiento y preview del logo -->
              <div id="spw_slot">
                <img id="spw_logo_preview" alt="Preview"/>
              </div>
            </div>

            <!-- Thumbnails de variantes (si tienen imagen) -->
            <t t-if="variants">
              <div class="spw-thumbs">
                <t t-foreach="variants" t-as="v">
                  <a t-att-data-variant="v.id"
                     t-att-data-img="'/web/image/product.product/%s/image_1920' % v.id"
                     t-attf-class="spw-thumb #{'active' if v.id==variant_id else ''}"
                     href="#">
                    <img t-att-src="'/web/image/product.product/%s/image_1920' % v.id"
                         t-att-alt="v.display_name"/>
                  </a>
                </t>
              </div>
            </t>
          </div>

          <!-- Columna FORM -->
          <div class="col-12 col-lg-6">
            <form action="/personalizar/add" method="post" enctype="multipart/form-data" class="o_website_form">
              <input type="hidden" name="product_id" t-att-value="product.id"/>
              <input type="hidden" name="variant_id" t-att-value="variant_id or ''"/>

              <div class="mb-3">
                <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
                <input class="form-control" type="file" name="logo" accept=".png,.jpg,.jpeg,.svg"/>
              </div>

              <div class="mb-3">
                <label class="form-label">Técnica de personalización</label>
                <select class="form-select" name="tecnica_personalizacion">
                  <option value="DTF">DTF</option>
                  <option value="Vinilo">Vinilo</option>
                  <option value="Serigrafía">Serigrafía</option>
                  <option value="Bordado">Bordado</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Posición</label>
                <select class="form-select" name="posicion_diseno">
                  <option value="pecho">Pecho</option>
                  <option value="espalda">Espalda</option>
                  <option value="manga">Manga</option>
                  <option value="gorra_frente">Gorra (frente)</option>
                  <option value="frente">Frente</option>
                  <option value="trasera">Trasera</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Color de impresión</label>
                <input class="form-control" type="text" name="color_impresion" placeholder="Ej. Blanco / Pantone 186C"/>
              </div>

              <div class="mb-3">
                <label class="form-label">Cantidad</label>
                <input class="form-control" type="number" name="cantidad" min="1" value="1"/>
              </div>

              <div class="mb-4">
                <label class="form-label">Observaciones</label>
                <textarea class="form-control" name="observaciones" placeholder="Notas para el taller..." rows="3"></textarea>
              </div>

              <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary">
                  Añadir al carrito con personalización
                </button>
                <a t-att-href="'/shop/product/%s' % product.id" class="btn btn-outline-secondary">
                  ← Volver al producto
                </a>
              </div>
            </form>
          </div>
        </div>

        <!-- Sello de carga JS opcional -->
        <div class="text-end mt-3"><span class="badge bg-light text-dark">SPW Preview</span></div>
      </div>
    </t>
  </template>
</odoo>