<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Plantilla de la página /personalizar/<id> -->
    <template id="personalizar" name="SPW Personalizar">
        <t t-call="website.layout">
            <!-- Contexto necesario para el editor de Website -->
            <t t-set="main_object" t-value="product"/>
            <t t-set="main_object_name" t-value="'product.template'"/>

            <div class="container my-5"
                 data-oe-model="product.template"
                 t-att-data-oe-id="product.id">
                <h1 class="mb-4">
                    Personalizar: <t t-esc="product.name"/>
                </h1>

                <div class="alert alert-info">
                    Página de prueba del personalizador (ruta y contexto OK).
                </div>

                <!-- Botón volver -->
                <a class="btn btn-secondary"
                   t-att-href="'/shop/product/%s' % product.id">
                    ← Volver al producto
                </a>
            </div>
        </t>
    </template>
</odoo>