<odoo>
  <template id="personalization_wizard" name="Personalización – Wizard">
    <t t-call="website.layout">
      <div class="container my-4">
        <t t-set="pvar" t-value="product_variant or product"/>
        <!-- Hidden: product_id para el controlador -->
        <input type="hidden" name="product_id" t-att-value="pvar.id"/>

        <!-- *** PUNTO 6: IMAGEN INTERNA DE ODOO (evita CORS) *** -->
        <img id="base-product-image"
             t-att-src="'/web/image/product.product/%s/image_1920' % pvar.id"
             class="d-none"/>

        <!-- Lienzo donde pintas la imagen + logo -->
        <canvas id="personalization-canvas" width="900" height="900"
                style="max-width:100%; border:1px solid #eee;"></canvas>

        <!-- Controles mínimos requeridos por el backend -->
        <div class="row mt-3">
          <div class="col-6">
            <label class="form-label">Técnica</label>
            <select name="tecnica" class="form-select">
              <option value="">--</option>
              <option>Serigrafía</option>
              <option>Bordado</option>
              <option>DTF</option>
              <option>Ninguna</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label">Tamaño</label>
            <select name="tamano" class="form-select">
              <option value="">--</option>
              <option>Pequeño</option>
              <option>Medio</option>
              <option>Grande</option>
            </select>
          </div>
        </div>

        <div class="row mt-3">
          <div class="col-6">
            <label class="form-label">Posición</label>
            <select name="posicion" class="form-select">
              <option value="">Frontal</option>
              <option value="espalda">Espalda</option>
              <option value="pecho_izq">Pecho izq.</option>
              <option value="pecho_der">Pecho der.</option>
            </select>
          </div>
          <div class="col-3">
            <label class="form-label">Color impresión</label>
            <input type="text" name="color_hex" class="form-control" placeholder="#000000"/>
          </div>
          <div class="col-3">
            <label class="form-label">Cantidad</label>
            <input type="number" name="quantity" class="form-control" min="1" value="1"/>
          </div>
        </div>

        <div class="mt-3">
          <label class="form-label">Observaciones</label>
          <textarea name="notas" class="form-control" rows="2"></textarea>
        </div>

        <div class="mt-4 d-flex gap-2">
          <button id="btn-add-to-cart-personalization" type="button" class="btn btn-primary">
            Añadir al carrito con esta personalización
          </button>
          <button id="btn-download-png" type="button" class="btn btn-outline-secondary">
            Descargar PNG
          </button>
          <a href="/shop" class="btn btn-link">Volver al producto</a>
        </div>
      </div>
    </t>
  </template>
</odoo>