<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Inserta un botón "Personalizar" en la ficha de producto del eCommerce -->
  <template id="add_customize_button" inherit_id="website_sale.product">
    <!-- Añadimos el botón al final del <form> del detalle de producto -->
    <t t-jquery="#product_details form" t-operation="append">
      <a class="btn btn-secondary mt-2"
         t-if="product"
         t-att-href="'/personalizacion/%s' % product.id">
        Personalizar
      </a>
    </t>
  </template>
</odoo>