<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Heredamos la vista principal del producto en eCommerce -->
  <template id="spw_personalize_button" name="SPW: Botón Personalizar"
            inherit_id="website_sale.product">
    <!-- Insertamos el botón dentro del form de compra, para poder moverlo junto al Add to Cart -->
    <xpath expr="//form[contains(@class,'wsale') or contains(@class,'o_wsale') or @id='product_form'][1]"
           position="inside">
      <a id="spw_personalize_btn"
         class="btn btn-outline-primary ms-2 mt-2"
         t-att-href="'/personalizar/%s' % product.id">
        <i class="fa fa-magic me-1"/>
        <span>Personalizar</span>
      </a>
    </xpath>
  </template>
</odoo>