<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Añade un botón "Personalizar" en la página de producto del eCommerce.
       Usamos //main como ancla universal para evitar fallos de xpath/t-jquery. -->
  <template id="add_customize_button" inherit_id="website_sale.product">
    <xpath expr="//main" position="inside">
      <div class="container my-3">
        <a class="btn btn-secondary"
           t-if="product"
           t-att-href="'/personalizacion/%s' % product.id">
          Personalizar
        </a>
      </div>
    </xpath>
  </template>
</odoo>