<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Botón "Personalizar" en la ficha de producto web -->
  <template id="add_customize_button" inherit_id="website_sale.product">
    <!-- Colocamos el botón justo después del formulario de compra -->
    <xpath expr="//form[contains(@class, 'o_wsale_product_form')]" position="after">
      <a t-attf-href="/personalizacion/producto/#{product.id}"
         class="btn btn-primary mt-2">
        Personalizar
      </a>
    </xpath>
  </template>
</odoo>