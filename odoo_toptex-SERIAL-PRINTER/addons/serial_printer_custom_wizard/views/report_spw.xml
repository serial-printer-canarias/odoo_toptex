<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =========================================================
       PRESUPUESTO / PEDIDO: imágenes + datos SPW por línea
       ========================================================= -->
  <template id="report_saleorder_spw_inherit"
            inherit_id="sale.report_saleorder_document"
            name="SPW - Custom en Presupuesto/Pedido"
            priority="90">

    <!-- Unión de localizadores para distintas versiones de la plantilla -->
    <xpath expr="//table[contains(@class,'o_main_table')]//td[@name='td_description']
                 | //td[@name='td_description']
                 | //table[contains(@class,'o_main_table')]//td[@name='name']
                 | //table[contains(@class,'o_main_table')]//td[contains(concat(' ', normalize-space(@class), ' '), ' o_td_description ')]"
           position="inside">

      <div t-if="line and line.product_id"
           style="margin-top:6px;">
        <div style="display:flex;align-items:flex-start;gap:8px;">
          <!-- Imagen PRODUCTO -->
          <img t-att-src="'/web/image/product.product/%s/image_128' % (line.product_id.id)"
               alt="Producto"
               style="max-width:64px;max-height:64px;border:1px solid #ddd;border-radius:4px"/>

          <!-- Imagen PERSONALIZACIÓN -->
          <img t-if="line.id"
               t-att-src="'/spw/line_preview/%s.png?m=pdf' % (line.id)"
               alt="Personalización"
               style="max-width:120px;max-height:120px;border:1px solid #ddd;border-radius:4px"/>

          <!-- Metadatos -->
          <div style="font-size:11px;line-height:1.25;">
            <t t-set="tech"  t-value="getattr(line, 'spw_tech', '')"/>
            <t t-set="hex"   t-value="getattr(line, 'spw_svg_color', '')"/>
            <t t-set="notes" t-value="getattr(line, 'spw_notes', '')"/>
            <t t-set="qty"   t-value="hasattr(line, 'product_uom_qty') and line.product_uom_qty or (hasattr(line,'quantity') and line.quantity or 0)"/>

            <div t-if="tech or hex or notes or qty">
              <div t-if="tech"><strong>Técnica:</strong> <span t-esc="tech"/></div>
              <div t-if="hex"><strong>Color SVG:</strong> <span t-esc="hex"/></div>
              <div t-if="notes"><strong>Obs:</strong> <span t-esc="notes"/></div>
              <div t-if="qty"><strong>Cant:</strong> <span t-esc="qty"/></div>
            </div>
          </div>
        </div>
      </div>

    </xpath>
  </template>

  <!-- ===============================================
       FACTURA: mismas inserciones para account.move
