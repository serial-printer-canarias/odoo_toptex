<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- =========================================================
       PRESUPUESTO / PEDIDO
       ========================================================= -->
  <template id="report_saleorder_spw_inherit"
            inherit_id="sale.report_saleorder_document"
            name="SPW – Extras en Presupuesto/Pedido">
    <xpath expr="//table[contains(@class,'o_main_table')]/tbody/tr/td[1]" position="inside">
      <div class="spw-print-block" style="margin-top:6px;">
        <!-- Adjuntos de la línea de pedido -->
        <t t-set="spw_att"
           t-value="o.env['ir.attachment'].search([('res_model','=','sale.order.line'),
                                                   ('res_id','=', l.id),
                                                   ('mimetype','ilike','image'),
                                                   ('name','ilike','spw%')], limit=1, order='id desc')"/>
        <t t-set="spw_att_url" t-value="'/web/image/%s' % spw_att.id if spw_att else False"/>
        <t t-set="prod_url" t-value="'/web/image/product.product/%s/image_128' % (l.product_id.id or 0)"/>

        <div style="display:flex;gap:10px;align-items:flex-start;flex-wrap:wrap;">
          <img t-att-src="prod_url" alt="Producto"
               style="max-width:60px;max-height:60px;border:1px solid #ddd;border-radius:4px;"/>
          <img t-if="spw_att_url" t-att-src="spw_att_url" alt="Personalización"
               style="max-width:140px;border:1px solid #ddd;border-radius:4px;"/>
          <t t-if="getattr(l, 'spw_svg_color', False)">
            <span title="Color SVG"
                  t-att-style="'display:inline-block;width:14px;height:14px;border-radius:999px;border:1px solid #bbb;background:%s' % l.spw_svg_color"></span>
            <span style="font-size:11px;margin-left:6px;" t-esc="l.spw_svg_color"/>
          </t>
        </div>
      </div>
    </xpath>
  </template>

  <!-- =========================================================
       FACTURA
       - Reutiliza el adjunto de la sale.order.line ligada
       ========================================================= -->
  <template id="report_invoice_spw_inherit"
            inherit_id="account.report_invoice_document"
            name="SPW – Extras en Factura">
    <xpath expr="//table[contains(@class,'o_main_table')]/tbody/tr/td[1]" position="inside">
      <div class="spw-print-block" style="margin-top:6px;">
        <!-- Primera sale.order.line asociada al apunte -->
        <t t-set="sl" t-value="(l.sale_line_ids and l.sale_line_ids[0]) or False"/>
        <t t-set="spw_att"
           t-value="sl and o.env['ir.attachment'].search([('res_model','=','sale.order.line'),
                                                          ('res_id','=', sl.id),
                                                          ('mimetype','ilike','image'),
                                                          ('name','ilike','spw%')], limit=1, order='id desc') or False"/>
        <t t-set="spw_att_url" t-value="'/web/image/%s' % spw_att.id if spw_att else False"/>
        <t t-set="prod_url" t-value="'/web/image/product.product/%s/image_128' % (l.product_id.id or 0)"/>

        <div style="display:flex;gap:10px;align-items:flex-start;flex-wrap:wrap;">
          <img t-att-src="prod_url" alt="Producto"
               style="max-width:60px;max-height:60px;border:1px solid #ddd;border-radius:4px;"/>
          <img t-if="spw_att_url" t-att-src="spw_att_url" alt="Personalización"
               style="max-width:140px;border:1px solid #ddd;border-radius:4px;"/>
          <t t-if="getattr(l, 'spw_svg_color', False)">
            <span title="Color SVG"
                  t-att-style="'display:inline-block;width:14px;height:14px;border-radius:999px;border:1px solid #bbb;background:%s' % l.spw_svg_color"></span>
            <span style="font-size:11px;margin-left:6px;" t-esc="l.spw_svg_color"/>
          </t>
        </div>
      </div>
    </xpath>
  </template>

</odoo>