<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =========================
       PRESUPUESTO / PEDIDO (sale.order)
       ========================= -->
  <template id="report_saleorder_spw_inherit"
            inherit_id="sale.report_saleorder_document"
            name="SPW - Extras en Presupuesto/Pedido">

    <!-- Insertar al final de la celda de DESCRIPCIÓN de cada línea -->
    <xpath expr="//table[contains(@class,'o_main_table')]/tbody/tr/td[1]"
           position="inside">
      <!-- En el report de sale, la variable de línea suele ser 'l' -->
      <t t-if="l">
        <div style="margin-top:6px; display:flex; gap:8px; align-items:flex-start; flex-wrap:wrap;">
          <!-- Imagen del PRODUCTO (arreglo: usar t-att-src) -->
          <img t-att-src="'/web/image/product.product/%s/image_128' % (l.product_id.id or 0)"
               alt="Producto"
               style="width:72px; height:auto; border:1px solid #DDD; border-radius:4px;"/>

          <!-- PNG de PERSONALIZACIÓN servido por el controller público -->
          <img t-att-src="'/spw/line_preview/%s.png' % l.id"
               alt="Personalización"
               style="width:96px; height:auto; border:1px solid #DDD; border-radius:4px;"/>

          <!-- Píldora de color (lee HEX del texto de la línea si existe #XXXXXX) -->
          <t t-set="hex"
             t-value="('#' in (l.name or '')) and ( (l.name or '').split('#')[-1].split()[0] ) or False"/>
          <t t-if="hex and len(hex) in (3,6) or (len(hex)==7 and hex.startswith('#'))">
            <span t-att-style="'display:inline-block;width:14px;height:14px;border-radius:50%%;border:1px solid #999;background:%s;margin-top:2px;'" t-esc="('#'+hex) if not hex.startswith('#') else hex"/>
          </t>
        </div>
      </t>
    </xpath>
  </template>

  <!-- =========================
       FACTURA (account.move)
       ========================= -->
  <template id="report_invoice_spw_inherit"
            inherit_id="account.report_invoice_document"
            name="SPW - Extras en Factura">

    <xpath expr="//table[contains(@class,'o_main_table')]/tbody/tr/td[1]"
           position="inside">
      <!-- En el report de factura, también se usa 'l' por defecto -->
      <t t-if="l">
        <div style="margin-top:6px; display:flex; gap:8px; align-items:flex-start; flex-wrap:wrap;">
          <img t-att-src="'/web/image/product.product/%s/image_128' % (getattr(l, 'product_id', False) and l.product_id.id or 0)"
               alt="Producto"
               style="width:72px; height:auto; border:1px solid #DDD; border-radius:4px;"/>

          <img t-att-src="'/spw/line_preview/%s.png' % l.id"
               alt="Personalización"
               style="width:96px; height:auto; border:1px solid #DDD; border-radius:4px;"/>

          <t t-set="hex"
             t-value="('#' in (l.name or '')) and ( (l.name or '').split('#')[-1].split()[0] ) or False"/>
          <t t-if="hex and len(hex) in (3,6) or (len(hex)==7 and hex.startswith('#'))">
            <span t-att-style="'display:inline-block;width:14px;height:14px;border-radius:50%%;border:1px solid #999;background:%s;margin-top:2px;'" t-esc="('#'+hex) if not hex.startswith('#') else hex"/>
          </t>
        </div>
      </t>
    </xpath>
  </template>

</odoo>