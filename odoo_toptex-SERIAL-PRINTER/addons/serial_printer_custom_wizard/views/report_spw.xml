      <t t-set="src" t-value="(l.sale_line_ids and l.sale_line_ids[0]) or l"/>
      <div style="margin-top:6px;">
        <div style="height:52px; line-height:0; margin:0 0 4px 0;">
          <t t-if="src.product_id and src.product_id.image_128">
