<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =========================================================
       PRESUPUESTO / PEDIDO (sale.report_saleorder_document)
       Inserta debajo de la descripción de la línea
       ========================================================= -->
  <template id="report_saleorder_spw_inherit"
            inherit_id="sale.report_saleorder_document"
            name="SPW - Custom en Presupuesto/Pedido"
            priority="90">

    <!-- Localizamos la celda de descripción de la línea -->
    <xpath expr="//td[contains(@name,'td_description')]
                 | //span[@t-field='l.name']/ancestor::td[1]"
           position="inside">

      <!-- Solo para líneas de producto (no sección/nota) -->
      <t t-if="l and not l.display_type and l.product_id">
        <div style="margin-top:6px;">
          <div style="display:flex;align-items:flex-start;gap:8px;flex-wrap:wrap;">
            <!-- Foto producto -->
            <img t-att-src="'/web/image/product.product/%s/image_128' % (l.product_id.id)"
                 alt="Producto"
                 style="max-width:64px;max-height:64px;border:1px solid #ddd;border-radius:4px"/>

            <!-- Foto personalización (controlador debe existir) -->
            <img t-att-src="'/spw/line_preview/%s.png' % (l.id)"
                 alt="Personalización"
                 style="max-width:120px;max-height:120px;border:1px solid #ddd;border-radius:4px"/>

            <!-- Metadatos -->
            <div style="font-size:11px;line-height:1.25;min-width:120px;">
              <div t-if="l.spw_tech"><strong>Técnica:</strong> <span t-esc="l.spw_tech"/></div>
              <div t-if="l.spw_svg_color"><strong>Color SVG:</strong> <span t-esc="l.spw_svg_color"/></div>
              <div t-if="l.spw_notes"><strong>Obs:</strong> <span t-esc="l.spw_notes"/></div>
              <div t-if="l.product_uom_qty"><strong>Cant:</strong> <span t-esc="l.product_uom_qty"/></div>
            </div>
          </div>
        </div>
      </t>
    </xpath>
  </template>

  <!-- =========================================
       FACTURA (account.report_invoice_document)
       ========================================= -->
  <template id="report_invoice_spw_inherit"
            inherit_id="account.report_invoice_document"
            name="SPW - Custom en Factura"
            priority="90">

    <xpath expr="//td[contains(@name,'td_description')]
                 | //span[@t-field='l.name']/ancestor::td[1]"
           position="inside">

      <!-- En factura, también usamos 'l' -->
      <t t-if="l and not l.display_type and l.product_id">
        <!-- Si proviene de venta, tomamos el id de la línea de venta para la preview -->
        <t t-set="sol_id" t-value="(l.sale_line_ids and l.sale_line_ids[:1].id) or l.id"/>

        <div style="margin-top:6px;">
          <div style="display:flex;align-items:flex-start;gap:8px;flex-wrap:wrap;">
            <img t-att-src="'/web/image/product.product/%s/image_128' % (l.product_id.id)"
                 alt="Producto"
                 style="max-width:64px;max-height:64px;border:1px solid #ddd;border-radius:4px"/>

            <img t-att-src="'/spw/line_preview/%s.png' % (sol_id)"
                 alt="Personalización"
                 style="max-width:120px;max-height:120px;border:1px solid #ddd;border-radius:4px"/>

            <div style="font-size:11px;line-height:1.25;min-width:120px;">
              <div t-if="l.spw_tech"><strong>Técnica:</strong> <span t-esc="l.spw_tech"/></div>
              <div t-if="l.spw_svg_color"><strong>Color SVG:</strong> <span t-esc="l.spw_svg_color"/></div>
              <div t-if="l.spw_notes"><strong>Obs:</strong> <span t-esc="l.spw_notes"/></div>
              <div t-if="l.quantity or l.product_uom_qty">
                <strong>Cant:</strong> <span t-esc="l.quantity or l.product_uom_qty"/>
              </div>
            </div>
          </div>
        </div>
      </t>
    </xpath>
  </template>

</odoo>