<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =======================================
       SPW – Extras en Presupuesto / Pedido
       (sale.report_saleorder_document)
       ======================================= -->
  <template id="report_saleorder_spw_inherit"
            name="SPW – Extras en Presupuesto/Pedido"
            inherit_id="sale.report_saleorder_document"
            priority="99">

    <!-- Inserta dentro de la celda que contiene el <span t-field="*.name"> -->
    <xpath expr="//span[contains(@t-field,'.name')]/ancestor::td[1]" position="inside">
      <div class="spw-report-block" style="margin-top:4px;">

        <!-- Foto de producto -->
        <t t-if="l.product_id">
          <img t-att-src="'/web/image/product.product/%s/image_128' % l.product_id.id"
               alt="Producto"
               style="width:72px;height:auto;border:1px solid #DDD;border-radius:4px;margin-right:6px;vertical-align:top;"/>
        </t>

        <!-- PNG de personalización (usa el id de sale.order.line) -->
        <img t-att-src="'/spw/line_preview/%s.png' % l.id"
             alt="Personalización"
             style="width:72px;height:auto;border:1px solid #DDD;border-radius:4px;vertical-align:top;"/>

        <!-- Píldora de color si en la descripción hay un #RRGGBB -->
        <t t-if="'#' in (l.name or '')">
          <t t-set="__hex" t-value="(l.name or '').split('#')[-1][:6]"/>
          <t t-if="__hex and len(__hex)==6">
            <span t-att-style="'display:inline-block;width:10px;height:10px;border-radius:20px;border:1px solid #999;margin-left:6px;vertical-align:middle;background:#%s' % __hex"/>
            <span style="font-size:10px;margin-left:4px;" t-esc="'#'+__hex"/>
          </t>
        </t>

      </div>
    </xpath>
  </template>

  <!-- ==========================
       SPW – Extras en Factura
       (account.report_invoice_document)
       ========================== -->
  <template id="report_invoice_spw_inherit"
            name="SPW – Extras en Factura"
            inherit_id="account.report_invoice_document"
            priority="99">

    <!-- Igual: dentro del <td> que contiene el <span t-field="*.name"> -->
    <xpath expr="//span[contains(@t-field,'.name')]/ancestor::td[1]" position="inside">
      <div class="spw-report-block" style="margin-top:4px;">

        <!-- Foto de producto -->
        <t t-if="line.product_id">
          <img t-att-src="'/web/image/product.product/%s/image_128' % line.product_id.id"
               alt="Producto"
               style="width:72px;height:auto;border:1px solid #DDD;border-radius:4px;margin-right:6px;vertical-align:top;"/>
        </t>

        <!-- PNG de personalización.
             Primero intenta la sale.order.line vinculada; si no hay, usa el id de account.move.line -->
        <t t-set="__sol_id" t-value="(line.sale_line_ids and line.sale_line_ids[:1].id) or False"/>
        <img t-att-src="'/spw/line_preview/%s.png' % (__sol_id or line.id)"
             alt="Personalización"
             style="width:72px;height:auto;border:1px solid #DDD;border-radius:4px;vertical-align:top;"/>

        <!-- Píldora de color -->
        <t t-if="'#' in (line.name or '')">
          <t t-set="__hex" t-value="(line.name or '').split('#')[-1][:6]"/>
          <t t-if="__hex and len(__hex)==6">
            <span t-att-style="'display:inline-block;width:10px;height:10px;border-radius:20px;border:1px solid #999;margin-left:6px;vertical-align:middle;background:#%s' % __hex"/>
            <span style="font-size:10px;margin-left:4px;" t-esc="'#'+__hex"/>
          </t>
        </t>

      </div>
    </xpath>
  </template>

</odoo>