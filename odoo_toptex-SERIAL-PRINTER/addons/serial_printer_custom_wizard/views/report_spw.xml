<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =========================================================
       PRESUPUESTO / PEDIDO: imágenes + metadatos SPW en líneas
       ========================================================= -->
  <template id="report_saleorder_spw_inherit"
            inherit_id="sale.report_saleorder_document"
            name="SPW - Extra en presupuesto/pedido (líneas)">

    <!--
      Localizamos la PRIMERA CELDA de las filas de líneas.
      El XPath es flexible: busca la tabla que contiene un span con
      t-field "line.name" o "l.name" (cubre distintas versiones),
      y dentro de ella actúa sobre cada tr/td[1].
    -->
    <xpath expr="//table[.//span[@t-field='line.name'] or .//span[@t-field='l.name']]//tbody//tr/td[1]"
           position="inside">

      <!-- Normalizamos la variable de línea sin usar locals() -->
      <t t-if="line" t-set="l" t-value="line"/>
      <t t-if="not line and l" t-set="l" t-value="l"/>

      <div class="spw-line-extra" style="margin-top:6px;">
        <!-- IMÁGENES -->
        <div class="spw-pics" style="display:flex;gap:6px;align-items:flex-start;flex-wrap:wrap;">
          <!-- Producto -->
          <img t-if="l and l.product_id"
               t-att-src="'/web/image/product.product/%s/image_128' % l.product_id.id"
               style="height:48px;width:auto;border:1px solid #e5e7eb;border-radius:4px;"/>

          <!-- Personalización: adjunto -> binario -> fallback URL -->
          <t t-set="spw_att" t-if="l"
             t-value="getattr(l,'spw_attachment_id', False) or getattr(l,'spw_png_attachment_id', False)"/>
          <img t-if="spw_att"
               t-att-src="'/web/image/ir.attachment/%s/datas' % spw_att.id"
               style="height:48px;width:auto;border:1px solid #e5e7eb;border-radius:4px;"/>
          <img t-elif="l and getattr(l,'spw_png', False)"
               t-att-src="'data:image/png;base64,%s' % l.spw_png"
               style="height:48px;width:auto;border:1px solid #e5e7eb;border-radius:4px;"/>
          <img t-elif="l and getattr(l,'id', False)"
               t-att-src="'/spw/line_preview/%s.png' % l.id"
               style="height:48px;width:auto;border:1px solid #e5e7eb;border-radius:4px;"/>
        </div>

        <!-- METADATOS -->
        <div class="spw-meta" style="font-size:11px;line-height:1.2;margin-top:4px;color:#374151;">
          <t t-if="l and getattr(l,'spw_tech', False)">
            <span><strong>Técnica:</strong> <t t-esc="l.spw_tech"/></span>
          </t>
          <t t-if="l and (getattr(l,'spw_svg_color_name', False) or getattr(l,'spw_svg_color', False))">
            <span style="margin-left:8px;">
              <strong>Color SVG:</strong>
              <t t-esc="getattr(l,'spw_svg_color_name', False) or getattr(l,'spw_svg_color', '')"/>
            </span>
          </t>
          <t t-if="l and getattr(l,'spw_notes', False)">
            <span style="margin-left:8px;"><strong>Obs:</strong> <t t-esc="l.spw_notes"/></span>
          </t>
          <t t-if="l and getattr(l,'product_uom_qty', False)">
            <span style="margin-left:8px;"><strong>Cant:</strong> <t t-esc="l.product_uom_qty"/></span>
          </t>
        </div>
      </div>
    </xpath>
  </template>

  <!-- ================================================
       FACTURA: mismo bloque en líneas de factura
       ================================================ -->
  <template id="report_invoice_spw_inherit"
            inherit_id="account.report_invoice_document"
            name="SPW - Extra en factura (líneas)">

    <!-- Igual estrategia de localización flexible -->
    <xpath expr="//table[.//span[@t-field='line.name'] or .//span[@t-field='l.name']]//tbody//tr/td[1]"
           position="inside">

      <t t-if="line" t-set="l" t-value="line"/>
      <t t-if="not line and l" t-set="l" t-value="l"/>

      <div class="spw-line-extra" style="margin-top:6px;">
        <div class="spw-pics" style="display:flex;gap:6px;align-items:flex-start;flex-wrap:wrap;">
          <img t-if="l and getattr(l,'product_id', False)"
               t-att-src="'/web/image/product.product/%s/image_128' % l.product_id.id"
               style="height:48px;width:auto;border:1px solid #e5e7eb;border-radius:4px;"/>

          <t t-set="spw_att" t-if="l"
             t-value="getattr(l,'spw_attachment_id', False) or getattr(l,'spw_png_attachment_id', False)"/>
          <img t-if="spw_att"
               t-att-src="'/web/image/ir.attachment/%s/datas' % spw_att.id"
               style="height:48px;width:auto;border:1px solid #e5e7eb;border-radius:4px;"/>
          <img t-elif="l and getattr(l,'spw_png', False)"
               t-att-src="'data:image/png;base64,%s' % l.spw_png"
               style="height:48px;width:auto;border:1px solid #e5e7eb;border-radius:4px;"/>
          <img t-elif="l and getattr(l,'id', False)"
               t-att-src="'/spw/line_preview/%s.png' % l.id"
               style="height:48px;width:auto;border:1px solid #e5e7eb;border-radius:4px;"/>
        </div>

        <div class="spw-meta" style="font-size:11px;line-height:1.2;margin-top:4px;color:#374151;">
          <t t-if="l and getattr(l,'spw_tech', False)">
            <span><strong>Técnica:</strong> <t t-esc="l.spw_tech"/></span>
          </t>
          <t t-if="l and (getattr(l,'spw_svg_color_name', False) or getattr(l,'spw_svg_color', False))">
            <span style="margin-left:8px;">
              <strong>Color SVG:</strong>
              <t t-esc="getattr(l,'spw_svg_color_name', False) or getattr(l,'spw_svg_color', '')"/>
            </span>
          </t>
          <t t-if="l and getattr(l,'spw_notes', False)">
            <span style="margin-left:8px;"><strong>Obs:</strong> <t t-esc="l.spw_notes"/></span>
          </t>
          <!-- En factura el campo suele ser quantity -->
          <t t-if="l and getattr(l,'quantity', False)">
            <span style="margin-left:8px;"><strong>Cant:</strong> <t t-esc="l.quantity"/></span>
          </t>
        </div>
      </div>
    </xpath>
  </template>

</odoo>