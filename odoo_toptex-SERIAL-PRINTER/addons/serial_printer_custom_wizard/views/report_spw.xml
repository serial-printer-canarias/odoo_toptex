<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- ==============================================
       PRESUPUESTO / PEDIDO (sale.report_saleorder_document)
       ============================================== -->
  <template id="report_saleorder_spw_inherit"
            inherit_id="sale.report_saleorder_document"
            name="SPW - Producto + Personalización en Presupuesto"
            priority="90">

    <!-- Hook seguro: justo después del nombre de la línea -->
    <xpath expr="//span[contains(@t-field, 'line.name')]" position="after">

      <!-- Sólo para líneas de producto (evita secciones/notas) -->
      <t t-if="line and not getattr(line, 'display_type', False) and line.product_id">
        <!-- Buscar primero un adjunto de tipo imagen asociado a la línea -->
        <t t-set="spw_att"
           t-value="next((a for a in (hasattr(line,'attachment_ids') and line.attachment_ids or [])
                           if (a.mimetype or '').startswith('image/')
                              and ('spw' in (a.name or '') or 'personaliz' in (a.name or ''))),
                         False)"/>

        <div style="margin-top:6px;">
          <div style="display:flex;align-items:flex-start;gap:8px;">
            <!-- Imagen del PRODUCTO (muy pequeña) -->
            <img t-att-src="'/web/image/product.product/%s/image_128' % (line.product_id.id)"
                 alt="Producto"
                 style="max-width:64px;max-height:64px;border:1px solid #ddd;border-radius:4px"/>

            <!-- Imagen de la PERSONALIZACIÓN (1º adjunto rápido; 2º ruta fallback limitada a 600px) -->
            <img t-if="spw_att"
                 t-att-src="'/web/image/ir.attachment/%s/datas?unique=1' % (spw_att.id)"
                 alt="Personalización"
                 style="max-width:120px;max-height:120px;border:1px solid #ddd;border-radius:4px"/>
            <img t-elif="line.id"
                 t-att-src="'/spw/line_preview/%s.png?w=600&amp;m=pdf' % (line.id)"
                 alt="Personalización"
                 style="max-width:120px;max-height:120px;border:1px solid #ddd;border-radius:4px"/>

            <!-- Metadatos -->
            <div style="font-size:11px;line-height:1.25;">
              <t t-set="tech"  t-value="getattr(line, 'spw_tech', '')"/>
              <t t-set="hex"   t-value="getattr(line, 'spw_svg_color', '')"/>
              <t t-set="notes" t-value="getattr(line, 'spw_notes', '')"/>
              <t t-set="qty"   t-value="hasattr(line,'product_uom_qty') and line.product_uom_qty or (hasattr(line,'quantity') and line.quantity or 0)"/>

              <div t-if="tech or hex or notes or qty">
                <div t-if="tech"><strong>Técnica:</strong> <span t-esc="tech"/></div>
                <div t-if="hex"><strong>Color SVG:</strong> <span t-esc="hex"/></div>
                <div t-if="notes"><strong>Obs:</strong> <span t-esc="notes"/></div>
                <div t-if="qty"><strong>Cant:</strong> <span t-esc="qty"/></div>
              </div>
            </div>
          </div>
        </div>
      </t>

    </xpath>
  </template>

  <!-- ==============================================
       FACTURA (account.report_invoice_document)
       ============================================== -->
  <template id="report_invoice_spw_inherit"
            inherit_id="account.report_invoice_document"
            name="SPW - Producto + Personalización en Factura"
            priority="90">

    <xpath expr="//span[contains(@t-field, 'line.name')]" position="after">

      <!-- Sólo líneas de producto -->
      <t t-if="line and not getattr(line, 'display_type', False) and line.product_id">
        <!-- Si existe vínculo a línea de venta, úsalo para el fallback -->
        <t t-set="sale_line_id"
           t-value="(hasattr(line,'sale_line_ids') and line.sale_line_ids and line.sale_line_ids[0].id) or line.id"/>

        <!-- Adj/rápido -->
        <t t-set="spw_att"
           t-value="next((a for a in (hasattr(line,'attachment_ids') and line.attachment_ids or [])
                           if (a.mimetype or '').startswith('image/')
                              and ('spw' in (a.name or '') or 'personaliz' in (a.name or ''))),
                         False)"/>

        <div style="margin-top:6px;">
          <div style="display:flex;align-items:flex-start;gap:8px;">
            <img t-att-src="'/web/image/product.product/%s/image_128' % (line.product_id.id)"
                 alt="Producto"
                 style="max-width:64px;max-height:64px;border:1px solid #ddd;border-radius:4px"/>

            <img t-if="spw_att"
                 t-att-src="'/web/image/ir.attachment/%s/datas?unique=1' % (spw_att.id)"
                 alt="Personalización"
                 style="max-width:120px;max-height:120px;border:1px solid #ddd;border-radius:4px"/>
            <img t-elif="sale_line_id"
                 t-att-src="'/spw/line_preview/%s.png?w=600&amp;m=pdf' % (sale_line_id)"
                 alt="Personalización"
                 style="max-width:120px;max-height:120px;border:1px solid #ddd;border-radius:4px"/>

            <div style="font-size:11px;line-height:1.25;">
              <t t-set="tech"  t-value="getattr(line, 'spw_tech', '')"/>
              <t t-set="hex"   t-value="getattr(line, 'spw_svg_color', '')"/>
              <t t-set="notes" t-value="getattr(line, 'spw_notes', '')"/>
              <t t-set="qty"   t-value="hasattr(line,'quantity') and line.quantity or (hasattr(line,'product_uom_qty') and line.product_uom_qty or 0)"/>

              <div t-if="tech or hex or notes or qty">
                <div t-if="tech"><strong>Técnica:</strong> <span t-esc="tech"/></div>
                <div t-if="hex"><strong>Color SVG:</strong> <span t-esc="hex"/></div>
                <div t-if="notes"><strong>Obs:</strong> <span t-esc="notes"/></div>
                <div t-if="qty"><strong>Cant:</strong> <span t-esc="qty"/></div>
              </div>
            </div>
          </div>
        </div>
      </t>

    </xpath>
  </template>

</odoo>