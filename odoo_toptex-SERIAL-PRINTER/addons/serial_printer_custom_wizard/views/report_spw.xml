<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- =========================================================
       PRESUPUESTO / PEDIDO: bloque SPW tras el nombre de línea
       ========================================================= -->
  <template id="report_saleorder_spw_inherit"
            inherit_id="sale.report_saleorder_document"
            name="SPW - Extras en presupuesto/pedido">

    <!-- Caso habitual: la variable se llama 'line' -->
    <xpath expr="//span[@t-field='line.name']" position="after">
      <t t-set="l" t-value="line"/>
      <div style="margin-top:6px;">
        <!-- IMÁGENES: reservamos alto para que wkhtml no colapse -->
        <div style="height:52px; line-height:0; margin:0 0 4px 0;">
          <!-- Producto -->
          <t t-if="l.product_id and l.product_id.image_128">
            <img t-att-src="'data:image/png;base64,%s' % (l.product_id.image_128 or '')"
                 style="display:inline-block;height:48px;width:auto;border:1px solid #e5e7eb;border-radius:3px;margin-right:6px;vertical-align:top;"
                 onerror="this.style.display='none';"/>
          </t>
          <!-- Personalización binaria en la línea -->
          <t t-if="getattr(l,'spw_png', False)">
            <img t-att-src="'data:image/png;base64,%s' % (l.spw_png or '')"
                 style="display:inline-block;height:48px;width:auto;border:1px solid #e5e7eb;border-radius:3px;margin-right:6px;vertical-align:top;"
                 onerror="this.style.display='none';"/>
          </t>
          <!-- Personalización desde adjunto (fallback) -->
          <t t-set="att" t-value="getattr(l,'spw_png_attachment_id', False) or getattr(l,'spw_attachment_id', False)"/>
          <t t-if="att and att.datas">
            <img t-att-src="'data:image/png;base64,%s' % (att.datas or '')"
                 style="display:inline-block;height:48px;width:auto;border:1px solid #e5e7eb;border-radius:3px;margin-right:6px;vertical-align:top;"
                 onerror="this.style.display='none';"/>
          </t>
        </div>

        <!-- PÍLDORA + metadatos -->
        <div style="font-size:11px;line-height:1.2;color:#374151;">
          <t t-set="hex" t-value="getattr(l,'spw_svg_color', '') or ''"/>
          <t t-if="hex">
            <span t-att-style="'background:%s;display:inline-block;width:10px;height:10px;border:1px solid #cbd5e1;vertical-align:middle;margin-right:4px;'%hex"/>
          </t>
          <t t-if="getattr(l,'spw_tech', False)">
            <span><strong>Técnica:</strong> <t t-esc="l.spw_tech"/></span>
          </t>
          <t t-if="getattr(l,'spw_svg_color_name', False) or getattr(l,'spw_svg_color', False)">
            <span style="margin-left:8px;">
              <strong>Color SVG:</strong>
              <t t-esc="getattr(l,'spw_svg_color_name', False) or getattr(l,'spw_svg_color', '')"/>
            </span>
          </t>
          <t t-if="getattr(l,'spw_notes', False)">
            <span style="margin-left:8px;"><strong>Obs:</strong> <t t-esc="l.spw_notes"/></span>
          </t>
          <t t-if="getattr(l,'product_uom_qty', False)">
            <span style="margin-left:8px;"><strong>Cant:</strong> <t t-esc="l.product_uom_qty"/></span>
          </t>
        </div>
      </div>
    </xpath>

    <!-- Variante de plantillas que usan 'l' en vez de 'line' -->
    <xpath expr="//span[@t-field='l.name']" position="after">
      <t t-set="l" t-value="l"/>
      <div style="margin-top:6px;">
        <div style="height:52px; line-height:0; margin:0 0 4px 0;">
          <t t-if="l.product_id and l.product_id.image_128">
            <img t-att-src="'data:image/png;base64,%s' % (l.product_id.image_128 or '')"
                 style="display:inline-block;height:48px;width:auto;border:1px solid #e5e7eb;border-radius:3px;margin-right:6px;vertical-align:top;"
                 onerror="this.style.display='none';"/>
          </t>
          <t t-if="getattr(l,'spw_png', False)">
            <img t-att-src="'data:image/png;base64,%s' % (l.spw_png or '')"
                 style="display:inline-block;height:48px;width:auto;border:1px solid #e5e7eb;border-radius:3px;margin-right:6px;vertical-align:top;"
                 onerror="this.style.display='none';"/>
          </t>
          <t t-set="att" t-value="getattr(l,'spw_png_attachment_id', False) or getattr(l,'spw_attachment_id', False)"/>
          <t t-if="att and att.datas">
            <img t-att-src="'data:image/png;base64,%s' % (att.datas or '')"
                 style="display:inline-block;height:48px;width:auto;border:1px solid #e5e7eb;border-radius:3px;margin-right:6px;vertical-align:top;"
                 onerror="this.style.display='none';"/>
          </t>
        </div>
        <div style="font-size:11px;line-height:1.2;color:#374151;">
          <t t-set="hex" t-value="getattr(l,'spw_svg_color', '') or ''"/>
          <t t-if="hex">
            <span t-att-style="'background:%s;display:inline-block;width:10px;height:10px;border:1px solid #cbd5e1;vertical-align:middle;margin-right:4px;'%hex"/>
          </t>
          <t t-if="getattr(l,'spw_tech', False)">
            <span><strong>Técnica:</strong> <t t-esc="l.spw_tech"/></span>
          </t>
          <t t-if="getattr(l,'spw_svg_color_name', False) or getattr(l,'spw_svg_color', False)">
            <span style="margin-left:8px;">
              <strong>Color SVG:</strong>
              <t t-esc="getattr(l,'spw_svg_color_name', False) or getattr(l,'spw_svg_color', '')"/>
            </span>
          </t>
          <t t-if="getattr(l,'spw_notes', False)">
            <span style="margin-left:8px;"><strong>Obs:</strong> <t t-esc="l.spw_notes"/></span>
          </t>
          <t t-if="getattr(l,'product_uom_qty', False)">
            <span style="margin-left:8px;"><strong>Cant:</strong> <t t-esc="l.product_uom_qty"/></span>
          </t>
        </div>
      </div>
    </xpath>
  </template>

