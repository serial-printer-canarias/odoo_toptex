<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Página de personalización -->
    <template id="spw_customize_page" name="SPW | Personalización">
      <t t-call="website.layout">

        <div class="container spw-container my-5">

          <!-- Variante seleccionada (si llega por parámetro) -->
          <t t-set="variant" t-value="product.product_variant_id"/>
          <t t-if="request.params.get('variant_id')">
            <t t-set="variant" t-value="request.env['product.product'].sudo().browse(int(request.params.get('variant_id')))"/>
          </t>

          <div class="row">
            <!-- Lienzo -->
            <div class="col-12 col-lg-7">
              <div class="spw-canvas-wrapper position-relative">
                <img id="spw_base_img"
                     class="img-fluid w-100"
                     t-att-src="(variant and (variant.image_1920 or variant.image_512)) or (product.image_1920 or product.image_512)"/>
                <img id="spw_logo" class="position-absolute d-none" alt="logo"/>
              </div>
              <p class="mt-3">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>
            </div>

            <!-- Controles -->
            <div class="col-12 col-lg-5">
              <div class="o_we_form">

                <!-- Técnicas -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Tipo de personalización</label>
                  <div class="d-flex flex-wrap gap-2">
                    <input type="radio" class="btn-check" name="spw_technique" id="spw_t_serigrafia" value="serigrafia" checked="checked"/>
                    <label class="btn btn-outline-secondary" for="spw_t_serigrafia">Serigrafía</label>

                    <input type="radio" class="btn-check" name="spw_technique" id="spw_t_dtf" value="dtf"/>
                    <label class="btn btn-outline-secondary" for="spw_t_dtf">DTF</label>

                    <input type="radio" class="btn-check" name="spw_technique" id="spw_t_bordado" value="bordado"/>
                    <label class="btn btn-outline-secondary" for="spw_t_bordado">Bordado</label>

                    <input type="radio" class="btn-check" name="spw_technique" id="spw_t_piel" value="marcado_en_cuero"/>
                    <label class="btn btn-outline-secondary" for="spw_t_piel">Marcado en cuero</label>
                  </div>
                </div>

                <!-- Colores (NS300 visual) -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Color</label>
                  <div id="spw_color_palette" class="d-flex flex-wrap gap-2">
                    <!-- Se rellena por JS con los chips visuales -->
                  </div>
                </div>

                <!-- Posición rápida -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Posición rápida</label>
                  <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary spw_quickpos" data-pos="left-chest">Pecho izq.</button>
                    <button type="button" class="btn btn-outline-secondary spw_quickpos" data-pos="right-chest">Pecho dcha.</button>
                    <button type="button" class="btn btn-outline-secondary spw_quickpos" data-pos="back">Espalda</button>
                    <button type="button" class="btn btn-outline-secondary spw_quickpos" data-pos="free">Libre</button>
                  </div>
                </div>

                <!-- Observaciones -->
                <div class="mb-3">
                  <label class="form-label fw-semibold" for="spw_notes">Observaciones</label>
                  <textarea id="spw_notes" class="form-control" rows="2"
                            placeholder="Tamaño de impresión y detalles (p. ej., pecho y espalda)."></textarea>
                </div>

                <!-- Subir logo -->
                <div class="mb-4 spw-file position-relative">
                  <label class="form-label fw-semibold" for="spw_file_btn">Subir logo (PNG/JPG/SVG)</label>
                  <label id="spw_file_btn" class="btn btn-light w-100 mb-2">Seleccionar archivo</label>
                  <input id="spw_file" type="file" accept=".png,.jpg,.jpeg,.svg"/>
                </div>

                <!-- Sliders -->
                <div class="row g-3">
                  <div class="col-12 col-md-6">
                    <label class="form-label">Tamaño</label>
                    <input id="spw_scale" type="range" class="form-range" min="10" max="300" value="100"/>
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label">Rotación</label>
                    <input id="spw_rotate" type="range" class="form-range" min="-180" max="180" value="0"/>
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label">Posición X</label>
                    <input id="spw_pos_x" type="range" class="form-range" min="0" max="100" value="50"/>
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label">Posición Y</label>
                    <input id="spw_pos_y" type="range" class="form-range" min="0" max="100" value="50"/>
                  </div>
                </div>

                <!-- Acciones -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <a t-att-href="product.website_url" class="btn btn-light">← Volver al producto</a>
                  <button id="spw_add_to_cart" class="btn btn-primary">
                    Añadir al carrito con esta personalización
                  </button>
                </div>

              </div>
            </div>
          </div>

        </div>

      </t>
    </template>

  </data>
</odoo>