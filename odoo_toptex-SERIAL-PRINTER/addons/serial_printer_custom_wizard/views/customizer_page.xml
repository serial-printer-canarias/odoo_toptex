<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="0">

    <!-- Página de personalización -->
    <template id="spw_customize_page" name="Personalización" page="True">
      <t t-call="website.layout">
        <div class="container spw-container oe_structure">

          <!-- Contexto: variante (si llega) y plantilla -->
          <t t-set="variant_id" t-value="request.params.get('variant_id') and int(request.params.get('variant_id')) or 0"/>
          <t t-set="variant" t-value="variant_id and request.env['product.product'].sudo().browse(variant_id) or False"/>
          <t t-set="template" t-value="variant and variant.product_tmpl_id or request.env['product.template'].sudo().browse(int(kwargs.get('product_id') or request.params.get('product_id') or 0))"/>

          <div class="row">
            <!-- Lienzo -->
            <div class="col-12 col-lg-7">
              <div class="spw-canvas-wrapper">
                <img id="spw_base_img" class="img-fluid w-100"
                     t-att-src="variant and ('/web/image/product.product/%s/image_1920' % variant.id) or (template and ('/web/image/product.template/%s/image_1920' % template.id) or '/web/static/img/placeholder.png')"
                     alt="Producto"/>
                <img id="spw_logo" class="position-absolute d-none" alt="Logo"/>
              </div>
              <p class="mt-3">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>
            </div>

            <!-- Controles -->
            <div class="col-12 col-lg-5">
              <div class="o_we_form spw-controls">

                <!-- Técnicas -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Tipo de personalización</label>
                  <div class="d-flex flex-wrap gap-2">
                    <input type="radio" class="btn-check" name="spw_technique" id="spw_te_serigrafia" value="Serigrafia" checked="checked"/>
                    <label class="btn btn-outline-secondary" for="spw_te_serigrafia">Serigrafia</label>

                    <input type="radio" class="btn-check" name="spw_technique" id="spw_te_dtf" value="DTF"/>
                    <label class="btn btn-outline-secondary" for="spw_te_dtf">DTF</label>

                    <input type="radio" class="btn-check" name="spw_technique" id="spw_te_bordado" value="Bordado"/>
                    <label class="btn btn-outline-secondary" for="spw_te_bordado">Bordado</label>

                    <input type="radio" class="btn-check" name="spw_technique" id="spw_te_cuero" value="Marcado en cuero"/>
                    <label class="btn btn-outline-secondary" for="spw_te_cuero">Marcado en cuero</label>
                  </div>
                </div>

                <!-- Colores -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Color (paleta)</label>
                  <div id="spw_colors" class="spw-colors d-flex flex-wrap gap-2"></div>
                </div>

                <!-- Posición rápida -->
                <div class="mb-4">
                  <label class="form-label fw-semibold">Posición rápida</label>
                  <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary spw-quick" data-pos="left_chest">Pecho izq.</button>
                    <button type="button" class="btn btn-outline-secondary spw-quick" data-pos="right_chest">Pecho dcha.</button>
                    <button type="button" class="btn btn-outline-secondary spw-quick" data-pos="back">Espalda</button>
                    <button type="button" class="btn btn-outline-secondary spw-quick" data-pos="free">Libre</button>
                  </div>
                </div>

                <!-- Observaciones -->
                <div class="mb-4">
                  <label class="form-label fw-semibold" for="spw_notes">Observaciones</label>
                  <textarea id="spw_notes" class="form-control" rows="2" placeholder="Tamaño de impresión y detalles (p. ej. pecho y espalda)"></textarea>
                </div>

                <!-- Subir logo -->
                <div class="mb-4 spw-file">
                  <label class="form-label fw-semibold" for="spw_file">Subir logo (PNG/JPG/SVG)</label>
                  <div class="form-control position-relative">
                    <span>Seleccionar archivo</span>
                    <input id="spw_file" type="file" accept=".png,.jpg,.jpeg,.svg"/>
                  </div>
                </div>

                <!-- Sliders -->
                <div class="row g-3">
                  <div class="col-12 col-md-6">
                    <label class="form-label">Tamaño</label>
                    <input id="spw_scale" type="range" min="20" max="300" step="1" value="100" class="form-range"/>
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label">Rotación</label>
                    <input id="spw_rotate" type="range" min="-180" max="180" step="1" value="0" class="form-range"/>
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label">Posición X</label>
                    <input id="spw_pos_x" type="range" min="0" max="100" step="1" value="50" class="form-range"/>
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label">Posición Y</label>
                    <input id="spw_pos_y" type="range" min="0" max="100" step="1" value="50" class="form-range"/>
                  </div>
                </div>

                <!-- Acciones -->
                <div class="d-flex justify-content-between mt-4">
                  <a t-att-href="template and ('/shop/product/%s' % template.id) or '/shop'" class="btn btn-light">← Volver al producto</a>
                  <button id="spw_add_to_cart" type="button" class="btn btn-primary">
                    Añadir al carrito con esta personalización
                  </button>
                </div>

              </div>
            </div>
          </div>
        </div>
      </t>
    </template>

  </data>
</odoo>