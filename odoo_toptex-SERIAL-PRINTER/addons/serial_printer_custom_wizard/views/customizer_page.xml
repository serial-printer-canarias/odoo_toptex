<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="customizer_page" name="SPW Personalizador" page="True">
    <t t-call="website.layout">
      <div id="wrap" class="container py-4">
        <h2 class="mb-3">
          <t t-esc="(variant and variant.display_name) or tmpl.display_name"/> — Personalización
        </h2>

        <form action="/personalizar/add" method="post">
          <input type="hidden" name="qty" value="1"/>
          <input type="hidden" name="variant_id" t-att-value="(variant and variant.id) or tmpl.product_variant_id.id"/>
          <input type="hidden" id="spw_base_url" t-att-value="base_image_url"/>

          <!-- Para enviar a servidor -->
          <input type="hidden" name="preview_png" id="spw_preview_png"/>
          <input type="hidden" name="params_json" id="spw_params_json"/>
          <input type="hidden" name="color_code" id="spw_color_code"/>
          <input type="hidden" name="color_hex" id="spw_color_hex"/>
          <input type="hidden" name="areas" id="spw_areas"/>

          <div class="row g-4">
            <div class="col-12 col-lg-8">
              <canvas id="spw_canvas" class="w-100" style="max-width:100%; border:1px solid #eee;"></canvas>
              <p class="text-muted mt-2">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>
            </div>

            <div class="col-12 col-lg-4">
              <div class="mb-3">
                <label class="form-label fw-bold">Tipo de personalización</label>
                <div class="spw-chip-group" id="spw_techniques">
                  <t t-foreach="techniques" t-as="tec">
                    <label class="spw-chip">
                      <input type="radio" name="technique" t-att-checked="tec == 'Sin vinilo' and 'checked' or None" t-att-value="tec"/><span t-esc="tec"/>
                    </label>
                  </t>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Color (NS300)</label>
                <div id="spw_colors" t-att-data-colors="ns_colors_json"></div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Posición rápida</label>
                <div class="spw-chip-group" id="spw_positions">
                  <label class="spw-chip"><input type="checkbox" value="pecho_izq"/><span>Pecho izq.</span></label>
                  <label class="spw-chip"><input type="checkbox" value="pecho_dcha"/><span>Pecho dcha.</span></label>
                  <label class="spw-chip"><input type="checkbox" value="espalda"/><span>Espalda</span></label>
                  <label class="spw-chip"><input type="checkbox" value="libre" checked="checked"/><span>Libre</span></label>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Subir logo (PNG/JPG/SVG)</label>
                <div class="spw-file">
                  <label for="spw_file" class="btn btn-outline-secondary">Seleccionar archivo</label>
                  <input id="spw_file" type="file" accept="image/*"/>
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-6">
                  <label class="form-label">Tamaño</label>
                  <input type="range" class="form-range" id="spw_scale" min="10" max="300" value="120"/>
                </div>
                <div class="col-6">
                  <label class="form-label">Rotación</label>
                  <input type="range" class="form-range" id="spw_rotate" min="-180" max="180" value="0"/>
                </div>
                <div class="col-6">
                  <label class="form-label">Posición X</label>
                  <input type="range" class="form-range" id="spw_pos_x" min="0" max="100" value="50"/>
                </div>
                <div class="col-6">
                  <label class="form-label">Posición Y</label>
                  <input type="range" class="form-range" id="spw_pos_y" min="0" max="100" value="50"/>
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label fw-bold">Observaciones</label>
                <textarea class="form-control" name="notes" rows="3" placeholder="Tamaño de impresión, detalles, etc."></textarea>
              </div>

              <div class="d-flex gap-2">
                <a href="javascript:history.back()" class="btn btn-light">&larr; Volver al producto</a>
                <button type="submit" id="spw_submit" class="btn btn-primary flex-fill">
                  Añadir al carrito con esta personalización
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- Pasa la URL base al JS -->
      <t t-jquery="body" t-operation="append">
        <script type="text/javascript">window.SPW_BASE_URL = "<t t-esc='base_image_url'/>";</script>
      </t>
    </t>
  </template>
</odoo>