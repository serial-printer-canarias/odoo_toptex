<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="spw_customizer_page" name="SPW – Customizer" inherit_id="website.layout">
    <xpath expr="//main" position="inside">
      <section class="container my-4 spw-wrap">
        <!-- Columna imagen -->
        <div class="spw-canvas">
          <t t-if="product_variant">
            <img id="spw_base_img"
                 t-att-src="'/web/image/product.product/%s/image_1920' % product_variant.id"
                 alt="Producto"/>
          </t>
          <t t-else="">
            <img id="spw_base_img"
                 t-att-src="'/web/image/product.template/%s/image_1920' % product_tmpl.id"
                 alt="Producto"/>
          </t>
          <!-- Logo superpuesto -->
          <img id="spw_logo_img" alt="Logo" class="spw-logo d-none"/>
        </div>

        <!-- Columna controles -->
        <aside class="spw-controls">
          <h1 class="h4 mb-3">
            <t t-esc="product_name"/> — Personalización
          </h1>

          <!-- Técnicas -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Tipo de personalización</label>
            <div class="spw-pills" id="spw_tech_group">
              <input type="radio" class="btn-check" name="spw_tech" id="spw_t_seri" value="serigrafia" checked="checked"/>
              <label class="btn btn-outline-secondary" for="spw_t_seri">Serigrafía</label>

              <input type="radio" class="btn-check" name="spw_tech" id="spw_t_dtf" value="dtf"/>
              <label class="btn btn-outline-secondary" for="spw_t_dtf">DTF</label>

              <input type="radio" class="btn-check" name="spw_tech" id="spw_t_bord" value="bordado"/>
              <label class="btn btn-outline-secondary" for="spw_t_bord">Bordado</label>

              <input type="radio" class="btn-check" name="spw_tech" id="spw_t_cuero" value="marcado_cuero"/>
              <label class="btn btn-outline-secondary" for="spw_t_cuero">Marcado en cuero</label>
            </div>
          </div>

          <!-- Colores (NS300, visuales) -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Color (NS300)</label>
            <div class="spw-palette" id="spw_palette">
              <!-- añade/quita colores si quieres -->
              <button type="button" class="spw-chip" style="--c:#000000" data-name="Black"></button>
              <button type="button" class="spw-chip" style="--c:#1f2a44" data-name="Oxford Navy"></button>
              <button type="button" class="spw-chip" style="--c:#607D3B" data-name="Olive Green"></button>
              <button type="button" class="spw-chip" style="--c:#c7b299" data-name="Biscuit"></button>
              <button type="button" class="spw-chip" style="--c:#d0d4d8" data-name="Light Grey"></button>
              <button type="button" class="spw-chip" style="--c:#ffffff" data-name="White"></button>
              <input type="hidden" id="spw_color_name" value="Black"/>
              <input type="hidden" id="spw_color_hex" value="#000000"/>
            </div>
          </div>

          <!-- Posición rápida -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Posición rápida</label>
            <div class="spw-pills">
              <input type="radio" class="btn-check" name="spw_posq" id="spw_p_left" value="pecho_izq" checked="checked"/>
              <label class="btn btn-outline-secondary" for="spw_p_left">Pecho izq.</label>

              <input type="radio" class="btn-check" name="spw_posq" id="spw_p_right" value="pecho_dcha"/>
              <label class="btn btn-outline-secondary" for="spw_p_right">Pecho dcha.</label>

              <input type="radio" class="btn-check" name="spw_posq" id="spw_p_back" value="espalda"/>
              <label class="btn btn-outline-secondary" for="spw_p_back">Espalda</label>

              <input type="radio" class="btn-check" name="spw_posq" id="spw_p_free" value="libre"/>
              <label class="btn btn-outline-secondary" for="spw_p_free">Libre</label>
            </div>
          </div>

          <!-- Observaciones -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Observaciones</label>
            <textarea id="spw_notes" class="form-control" rows="2" placeholder="Tamaño de impresión y detalles (p. ej., pecho y espalda)."></textarea>
          </div>

          <!-- File input -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Subir logo (PNG/JPG/SVG)</label>
            <div class="spw-file">
              <label for="spw_file" class="btn btn-light border">Seleccionar archivo</label>
              <input id="spw_file" type="file" accept=".png,.jpg,.jpeg,.svg"/>
            </div>
          </div>

          <!-- Sliders -->
          <div class="mb-4 spw-sliders">
            <label class="form-label">Tamaño</label>
            <input id="spw_size" class="form-range" type="range" min="0.2" max="2" step="0.02" value="0.6"/>

            <label class="form-label mt-3">Rotación</label>
            <input id="spw_rot" class="form-range" type="range" min="-180" max="180" step="1" value="0"/>

            <label class="form-label mt-3">Posición X</label>
            <input id="spw_x" class="form-range" type="range" min="0" max="100" step="1" value="50"/>

            <label class="form-label mt-3">Posición Y</label>
            <input id="spw_y" class="form-range" type="range" min="0" max="100" step="1" value="50"/>
          </div>

          <div class="d-grid gap-2">
            <a t-att-href="'/shop/product/%s' % (product_variant.id if product_variant else product_tmpl.product_variant_id.id)"
               class="btn btn-outline-secondary">&larr; Volver al producto</a>
            <button id="spw_add_cart" class="btn btn-primary">
              Añadir al carrito con esta personalización
            </button>
          </div>
        </aside>
      </section>
    </xpath>
  </template>
</odoo>