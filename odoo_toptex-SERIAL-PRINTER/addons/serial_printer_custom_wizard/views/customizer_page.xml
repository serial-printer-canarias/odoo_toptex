<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Página del personalizador -->
  <template id="spw_customizer_page" name="SPW: Personalizador">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <section class="container py-4">

          <!-- Lienzo: imagen base + logo superpuesto -->
          <div id="spw_canvas" class="spw-canvas mb-3">
            <img id="spw_base_img"
                 class="spw-base"
                 alt="Producto"
                 t-att-src="product and product._get_image_url('image_1024')"/>
            <img id="spw_logo_img" class="spw-logo" alt="Logo" style="display:none;"/>
          </div>

          <p class="lead mb-4">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>

          <!-- Tipo de personalización -->
          <div class="mb-3">
            <label class="form-label d-block fw-semibold">Tipo de personalización</label>
            <div class="btn-group w-100" role="group">
              <button type="button" class="btn btn-outline-secondary active">Serigrafía</button>
              <button type="button" class="btn btn-outline-secondary">DTF</button>
              <button type="button" class="btn btn-outline-secondary">Bordado</button>
              <button type="button" class="btn btn-outline-secondary">Marcado en cuero</button>
            </div>
          </div>

          <!-- Colores (demo) -->
          <div class="mb-3">
            <label class="form-label d-block fw-semibold">Color</label>
            <div class="spw-color-row">
              <button type="button" class="spw-color" style="--c:#000000;" aria-label="Negro"></button>
              <button type="button" class="spw-color" style="--c:#ffffff;" aria-label="Blanco"></button>
              <button type="button" class="spw-color" style="--c:#1f64ff;" aria-label="Azul"></button>
              <button type="button" class="spw-color" style="--c:#d62c3a;" aria-label="Rojo"></button>
            </div>
          </div>

          <!-- Posición rápida (demo) -->
          <div class="mb-3">
            <label class="form-label d-block fw-semibold">Posición rápida</label>
            <div class="d-flex gap-2 flex-wrap">
              <button type="button" class="btn btn-outline-secondary">Pecho izq.</button>
              <button type="button" class="btn btn-outline-secondary">Pecho dcha.</button>
              <button type="button" class="btn btn-outline-secondary">Espalda</button>
              <button type="button" class="btn btn-secondary">Libre</button>
            </div>
          </div>

          <!-- Observaciones -->
          <div class="mb-3">
            <label for="spw_notes" class="form-label fw-semibold">Observaciones</label>
            <textarea id="spw_notes" class="form-control"
                      placeholder="Tamaño, número de tintas y detalles (p.ej. pecho y espalda)"></textarea>
          </div>

          <!-- Subida de logo -->
          <div class="mb-4">
            <label for="spw_logo" class="form-label fw-semibold">Subir logo (PNG/JPG/SVG)</label>
            <input id="spw_logo" class="form-control" type="file" accept=".png,.jpg,.jpeg,.svg"/>
          </div>

          <!-- Controles -->
          <div class="row g-4">
            <div class="col-12 col-md-6">
              <label class="form-label">Tamaño</label>
              <input id="spw_scale" type="range" min="10" max="300" value="100" class="form-range"/>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label">Rotación</label>
              <input id="spw_rotate" type="range" min="-180" max="180" value="0" class="form-range"/>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label">Posición X</label>
              <input id="spw_pos_x" type="range" min="-400" max="400" value="0" class="form-range"/>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label">Posición Y</label>
              <input id="spw_pos_y" type="range" min="-400" max="400" value="0" class="form-range"/>
            </div>
          </div>

          <!-- Acciones -->
          <div class="d-flex justify-content-between align-items-center mt-4">
            <a t-att-href="product and product.website_url" class="btn btn-light">&#8592; Volver al producto</a>
            <button id="spw_add_to_cart" class="btn btn-primary">
              Añadir al carrito con esta personalización
            </button>
          </div>

        </section>
      </div>
    </t>
  </template>
</odoo>