<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Página de personalización -->
    <template id="spw_customize_page" name="SPW - Personalización" page="True">
        <!-- Layout público -->
        <t t-call="website.layout">
            <!-- Ayuda al editor (evita el TypeError en modo edición) -->
            <t t-set="main_object" t-value="variant or product"/>
            <t t-set="main_object_name" t-value="'product.product' if variant else 'product.template'"/>

            <div id="wrap"
                 class="container spw-container py-4"
                 t-att-data-oe-model="variant and 'product.product' or 'product.template'"
                 t-att-data-oe-id="(variant and variant.id) or product.id">
                <!-- Variante seleccionada (si la hay) -->
                <t t-set="variant" t-value="variant"/>

                <div class="row g-4">
                    <!-- Lienzo -->
                    <div class="col-12 col-lg-7">
                        <div class="spw-canvas-wrapper position-relative rounded-3 overflow-hidden bg-white shadow-sm">
                            <!-- Imagen base: usa la de la variante si existe -->
                            <img id="spw_base_img"
                                 class="img-fluid w-100 d-block"
                                 t-att-src="variant and ('/web/image/product.product/%s/image_1920' % variant.id) or ('/web/image/product.template/%s/image_1920' % product.id)"
                                 t-att-alt="(variant and variant.display_name) or product.display_name"/>

                            <!-- Logo del cliente (se dibuja por JS) -->
                            <img id="spw_logo" class="position-absolute d-none" alt="Logo"/>
                        </div>
                        <p class="mt-3 text-muted">
                            Arrastra el logo sobre la imagen para posicionarlo o usa los controles.
                        </p>
                    </div>

                    <!-- Controles -->
                    <div class="col-12 col-lg-5">
                        <div class="o_we_form spw-controls">

                            <!-- Técnicas -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Tipo de personalización</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <input type="radio" class="btn-check" name="spw_tech" id="spw_tech_serigrafia" value="serigrafia" checked="checked"/>
                                    <label class="btn btn-outline-secondary" for="spw_tech_serigrafia">Serigrafía</label>

                                    <input type="radio" class="btn-check" name="spw_tech" id="spw_tech_dtf" value="dtf"/>
                                    <label class="btn btn-outline-secondary" for="spw_tech_dtf">DTF</label>

                                    <input type="radio" class="btn-check" name="spw_tech" id="spw_tech_bordado" value="bordado"/>
                                    <label class="btn btn-outline-secondary" for="spw_tech_bordado">Bordado</label>

                                    <input type="radio" class="btn-check" name="spw_tech" id="spw_tech_cuero" value="marcado_cuero"/>
                                    <label class="btn btn-outline-secondary" for="spw_tech_cuero">Marcado en cuero</label>
                                </div>
                            </div>

                            <!-- Colores catálogo visual (chips) -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Color (NS300)</label>
                                <div id="spw_color_palette" class="d-flex flex-wrap gap-2"></div>
                                <!-- El JS rellena los chips y gestiona la selección -->
                            </div>

                            <!-- Posición rápida -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Posición rápida</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-outline-secondary spw-pos-btn" data-pos="pecho_izq">Pecho izq.</button>
                                    <button type="button" class="btn btn-outline-secondary spw-pos-btn" data-pos="pecho_dcha">Pecho dcha.</button>
                                    <button type="button" class="btn btn-outline-secondary spw-pos-btn" data-pos="espalda">Espalda</button>
                                    <button type="button" class="btn btn-outline-secondary spw-pos-btn" data-pos="libre">Libre</button>
                                </div>
                            </div>

                            <!-- Observaciones -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold" for="spw_notes">Observaciones</label>
                                <textarea id="spw_notes" class="form-control" rows="3"
                                          placeholder="Tamaño de impresión y detalles (p. ej. pecho y espalda)."></textarea>
                            </div>

                            <!-- Subida de logo -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Subir logo (PNG/JPG/SVG)</label>
                                <div class="spw-file">
                                    <label for="spw_file">Seleccionar archivo</label>
                                    <input id="spw_file" type="file" accept=".png,.jpg,.jpeg,.svg"/>
                                </div>
                            </div>

                            <!-- Sliders -->
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Tamaño</label>
                                    <input id="spw_scale" type="range" min="10" max="200" value="100" class="form-range"/>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Rotación</label>
                                    <input id="spw_rotate" type="range" min="-180" max="180" value="0" class="form-range"/>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Posición X</label>
                                    <input id="spw_pos_x" type="range" min="0" max="100" value="50" class="form-range"/>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Posición Y</label>
                                    <input id="spw_pos_y" type="range" min="0" max="100" value="50" class="form-range"/>
                                </div>
                            </div>

                            <!-- Acciones -->
                            <div class="d-flex justify-content-between align-items-center mt-4 gap-2">
                                <a t-att-href="product.website_url" class="btn btn-light">
                                    ← Volver al producto
                                </a>
                                <button id="spw_add_to_cart" type="button" class="btn btn-primary">
                                    Añadir al carrito con esta personalización
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>