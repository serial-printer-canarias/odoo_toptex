<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="customizer_page" name="SPW Customizer Page">
    <t t-call="website.layout">
      <t t-set="title" t-value="page_title or 'Personalización'"/>
      <div class="container my-4">

        <h1 class="mb-3" t-esc="page_title"/>

        <!-- Imagen base del producto/variante -->
        <div class="row">
          <div class="col-12">
            <img id="spw_base_img" class="img-fluid w-100" t-att-src="base_image_url" alt="Producto"/>
          </div>
        </div>

        <p class="mt-3">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>

        <!-- Técnicas -->
        <div class="mt-4">
          <h4>Tipo de personalización</h4>
          <div class="spw-chip-group" id="spw_techniques">
            <t t-foreach="techniques" t-as="tec">
              <label class="spw-chip me-2 mb-2">
                <!-- Serigrafia por defecto -->
                <input type="radio" name="technique" t-att-value="tec"
                       t-att-checked="tec == 'Serigrafia' and 'checked' or None"/>
                <span t-esc="tec"/>
              </label>
            </t>
          </div>
        </div>

        <!-- Colores visuales (paleta NS300-like) -->
        <div class="mt-4">
          <h4>Color (NS300)</h4>
          <div id="spw_colors" class="d-flex flex-wrap"></div>
          <input type="hidden" id="spw_color" value="000"/>
        </div>

        <!-- Posiciones rápidas -->
        <div class="mt-4">
          <h4>Posición rápida</h4>
          <div class="spw-chip-group" id="spw_positions">
            <label class="spw-chip me-2 mb-2"><input type="radio" name="pos" value="left_chest" checked="checked"/><span>Pecho izq.</span></label>
            <label class="spw-chip me-2 mb-2"><input type="radio" name="pos" value="right_chest"/><span>Pecho dcha.</span></label>
            <label class="spw-chip me-2 mb-2"><input type="radio" name="pos" value="back"/><span>Espalda</span></label>
            <label class="spw-chip me-2 mb-2"><input type="radio" name="pos" value="free"/><span>Libre</span></label>
          </div>
        </div>

        <!-- Observaciones -->
        <div class="mt-4">
          <h4>Observaciones</h4>
          <textarea id="spw_notes" class="form-control" rows="3"
                    placeholder="Tamaño de impresión y detalles (p.ej. pecho y espalda)…"/>
        </div>

        <!-- Subida y controles -->
        <div class="mt-4">
          <h4>Subir logo (PNG/JPG/SVG)</h4>
          <div class="spw-file">
            <label for="spw_file" class="btn btn-outline-secondary">Seleccionar archivo</label>
            <input id="spw_file" type="file" accept=".png,.jpg,.jpeg,.svg"/>
          </div>

          <div class="row g-3 mt-2">
            <div class="col-12 col-md-6">
              <label class="form-label">Tamaño</label>
              <input id="spw_scale" type="range" min="10" max="300" value="120" class="form-range"/>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label">Rotación</label>
              <input id="spw_rotate" type="range" min="-180" max="180" value="0" class="form-range"/>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label">Posición X</label>
              <input id="spw_posx" type="range" min="0" max="100" value="50" class="form-range"/>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label">Posición Y</label>
              <input id="spw_posy" type="range" min="0" max="100" value="50" class="form-range"/>
            </div>
          </div>
        </div>

        <!-- Acciones -->
        <div class="d-flex gap-2 my-4">
          <a t-att-href="variant and '/shop/product/%s?variant_id=%s' % (tmpl.id, variant.id) or '/shop/product/%s' % (tmpl.id)"
             class="btn btn-light">← Volver al producto</a>
          <button id="spw_add_to_cart" class="btn btn-primary flex-grow-1">
            Añadir al carrito con esta personalización
          </button>
        </div>

        <!-- Datos para JS -->
        <input type="hidden" id="spw_variant_id" t-att-value="variant and variant.id or ''"/>
        <input type="hidden" id="spw_product_id" t-att-value="tmpl and tmpl.id or ''"/>
        <script type="application/json" id="spw_ns_colors_json" t-esc="ns_colors_json"/>
      </div>
    </t>
  </template>
</odoo>