<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="spw_customize_page" name="SPW - Customizer Page">
    <t t-call="website.layout">
      <t t-set="pageName" t-value="'spw_customize_page'"/>
      <t t-set="main_object" t-value="template"/>

      <div class="container my-5 spw-customizer">
        <!-- Hidden para JS -->
        <input type="hidden" id="spw_template_id" t-att-value="template.id"/>
        <input type="hidden" id="spw_variant_id" t-att-value="variant_id or ''"/>

        <div class="row g-4">
          <!-- Lienzo -->
          <div class="col-12 col-lg-7">
            <div id="spw_canvas" class="spw-stage card p-3">
              <img id="spw_product_img" class="spw-base img-fluid rounded" t-att-src="img_src" alt="Producto"/>
              <img id="spw_logo_preview" class="spw-logo-preview d-none" alt="Logo preview"/>
            </div>
          </div>

          <!-- Controles -->
          <div class="col-12 col-lg-5">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title mb-3">Personalización</h5>

                <!-- Subir logo -->
                <div class="mb-3">
                  <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
                  <input id="spw_logo_input" class="form-control" type="file" accept=".png,.jpg,.jpeg,.svg,.PNG,.JPG,.JPEG,.SVG"/>
                  <small class="text-muted">Máx. 10MB.</small>
                </div>

                <!-- Técnica -->
                <div class="mb-3">
                  <label class="form-label">Técnica</label>
                  <div class="d-flex gap-3 flex-wrap">
                    <label class="form-check">
                      <input class="form-check-input" type="radio" name="spw_tech" value="Serigrafía" checked="checked"/>
                      <span class="form-check-label">Serigrafía</span>
                    </label>
                    <label class="form-check">
                      <input class="form-check-input" type="radio" name="spw_tech" value="DTF"/>
                      <span class="form-check-label">DTF</span>
                    </label>
                    <label class="form-check">
                      <input class="form-check-input" type="radio" name="spw_tech" value="Bordado"/>
                      <span class="form-check-label">Bordado</span>
                    </label>
                  </div>
                </div>

                <!-- Color (SVG) -->
                <div class="mb-3">
                  <label class="form-label">Color (SVG)</label>
                  <div class="spw-color-row">
                    <label class="spw-color-swatch is-black">
                      <input type="radio" name="spw_svg_color" value="#000000" checked="checked"/>
                      <span class="spw-color-ring"></span>
                    </label>
                    <label class="spw-color-swatch is-white">
                      <input type="radio" name="spw_svg_color" value="#FFFFFF"/>
                      <span class="spw-color-ring"></span>
                    </label>
                    <label class="spw-color-swatch is-red">
                      <input type="radio" name="spw_svg_color" value="#D62828"/>
                      <span class="spw-color-ring"></span>
                    </label>
                    <label class="spw-color-swatch is-blue">
                      <input type="radio" name="spw_svg_color" value="#2060FF"/>
                      <span class="spw-color-ring"></span>
                    </label>
                    <label class="spw-color-swatch is-green">
                      <input type="radio" name="spw_svg_color" value="#2A9D8F"/>
                      <span class="spw-color-ring"></span>
                    </label>
                  </div>
                  <div class="spw-help mt-1">Se aplica solo a logos SVG.</div>
                </div>

                <!-- Tamaño -->
                <div class="mb-3">
                  <label for="spw_size" class="form-label">Tamaño</label>
                  <input id="spw_size" class="form-range" type="range" min="10" max="200" value="100"/>
                </div>

                <!-- Posición X -->
                <div class="mb-3">
                  <label for="spw_pos_x" class="form-label">Posición X</label>
                  <input id="spw_pos_x" class="form-range" type="range" min="-50" max="50" value="0"/>
                </div>

                <!-- Posición Y -->
                <div class="mb-3">
                  <label for="spw_pos_y" class="form-label">Posición Y</label>
                  <input id="spw_pos_y" class="form-range" type="range" min="-50" max="50" value="10"/>
                </div>

                <!-- Rotación -->
                <div class="mb-3">
                  <label for="spw_rotation" class="form-label">Rotación</label>
                  <input id="spw_rotation" class="form-range" type="range" min="-45" max="45" value="0"/>
                </div>

                <!-- Cantidad -->
                <div class="mb-3">
                  <label class="form-label" for="spw_qty">Cantidad</label>
                  <input id="spw_qty" type="number" class="form-control" value="1" min="1" step="1"/>
                </div>

                <!-- Observaciones -->
                <div class="mb-3">
                  <label class="form-label" for="spw_notes">Observaciones</label>
                  <textarea id="spw_notes" class="form-control" rows="3" placeholder="Indica instrucciones para el taller..."></textarea>
                </div>

                <div class="d-flex align-items-center gap-2 mb-3">
                  <!-- ¡IMPORTANTE!: los ampersands escapados -->
                  <a class="btn btn-outline-secondary" href="javascript:void(0)"
                     onclick="window.spwReset &amp;&amp; window.spwReset();">Reset</a>
                  <a id="spw_btn_add_cart" class="btn btn-primary flex-grow-1" href="javascript:void(0)">Añadir al carrito con esta personalización</a>
                </div>

                <div class="d-flex align-items-center gap-3">
                  <a id="spw_btn_png" class="btn btn-light" href="javascript:void(0)">Descargar PNG</a>
                  <a class="btn btn-link ms-2" t-att-href="'/shop/product/%s' % template.id">&#8592; Volver al producto</a>
                </div>

              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>