<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="spw_customizer_page" name="SPW: Customizer Page">
    <t t-call="website.layout">
      <t t-set="pageName">spw_customizer</t>
      <t t-set="main_object" t-value="product_tmpl"/>

      <div class="container my-5">
        <p class="mb-3">
          <a t-attf-href="/shop/product/{{ product_tmpl.id }}" class="link-secondary">Volver al producto</a>
        </p>

        <div class="row g-4">
          <!-- Lienzo / Previsualización -->
          <div class="col-12 col-lg-8">
            <div id="spw_canvas" class="spw-stage shadow-sm rounded p-3 bg-white">
              <!-- Imagen de la VARIANTE seleccionada -->
              <img id="spw_product_img"
                   class="spw-base"
                   t-att-src="'/web/image/product.product/%s/image_1920' % variant.id"
                   alt="Producto"/>

              <!-- Overlay del logo -->
              <img id="spw_logo_preview" class="spw-logo-preview d-none" alt="Logo"/>
            </div>

            <!-- Controles -->
            <div class="spw-controls card mt-3">
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-12">
                    <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
                    <input id="spw_logo_input" class="form-control" type="file" accept=".png,.jpg,.jpeg,.svg,.svg+xml"/>
                  </div>

                  <div class="col-12">
                    <label for="spw_size" class="form-label">Tamaño</label>
                    <input id="spw_size" class="form-range" type="range" min="10" max="200" value="100"/>
                  </div>

                  <div class="col-12 col-md-6">
                    <label for="spw_pos_x" class="form-label">Posición X</label>
                    <input id="spw_pos_x" class="form-range" type="range" min="-200" max="200" value="0"/>
                  </div>
                  <div class="col-12 col-md-6">
                    <label for="spw_pos_y" class="form-label">Posición Y</label>
                    <input id="spw_pos_y" class="form-range" type="range" min="-200" max="200" value="0"/>
                  </div>

                  <div class="col-12 col-md-6">
                    <label for="spw_rotate" class="form-label">Rotación</label>
                    <input id="spw_rotate" class="form-range" type="range" min="-180" max="180" value="0"/>
                  </div>

                  <div class="col-12 col-md-6 d-grid">
                    <button id="spw_reset" class="btn btn-outline-secondary" type="button">Reset</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Info lateral (opcional, sin lógica de pedido aún) -->
          <div class="col-12 col-lg-4">
            <div class="card">
              <div class="card-body">
                <h5 class="card-title mb-3"><t t-esc="product_tmpl.name"/></h5>
                <p class="text-muted mb-2">Variante: <t t-esc="variant.display_name"/></p>
                <p class="small text-muted mb-0">Ajusta el logo con los controles. (El pedido se integra después.)</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>