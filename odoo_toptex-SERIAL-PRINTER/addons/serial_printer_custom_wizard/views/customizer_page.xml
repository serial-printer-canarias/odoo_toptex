<!-- serial_printer_custom_wizard/views/customizer_page.xml -->
<odoo>
  <template id="customizer_page" name="SPW Customizer Page" page="True">
    <t t-call="website.layout">
      <div class="container my-5 spw-customizer">
        <h1 class="mb-4">
          <t t-esc="product.display_name"/> — Personalización
        </h1>

        <div class="row g-4">
          <!-- Lado izquierdo: previsualización -->
          <div class="col-12 col-lg-7">
            <div class="spw-stage position-relative border rounded overflow-hidden">
              <img id="spw_base_img" t-att-src="product_image_url" class="img-fluid d-block w-100" alt="product"/>
              <!-- capa del logo -->
              <img id="spw_logo_preview" class="spw-logo d-none" alt="logo preview"/>
            </div>
            <p class="text-muted mt-2 small">
              Arrastra el logo sobre la imagen para posicionarlo (desktop) o usa los controles (móvil).
            </p>
          </div>

          <!-- Lado derecho: controles -->
          <div class="col-12 col-lg-5">
            <div class="card">
              <div class="card-body">
                <form id="spw_form" enctype="multipart/form-data">
                  <input type="hidden" name="product_id" t-att-value="product.id"/>

                  <div class="mb-3">
                    <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
                    <input id="spw_logo" type="file" accept=".png,.jpg,.jpeg,.svg" class="form-control"/>
                  </div>

                  <div class="row">
                    <div class="col-6 mb-3">
                      <label class="form-label">Tamaño</label>
                      <input id="spw_scale" type="range" min="20" max="200" value="100" class="form-range"/>
                    </div>
                    <div class="col-6 mb-3">
                      <label class="form-label">Rotación</label>
                      <input id="spw_rotate" type="range" min="-45" max="45" value="0" class="form-range"/>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-6 mb-3">
                      <label class="form-label">Posición X</label>
                      <input id="spw_posx" type="range" min="0" max="100" value="50" class="form-range"/>
                    </div>
                    <div class="col-6 mb-3">
                      <label class="form-label">Posición Y</label>
                      <input id="spw_posy" type="range" min="0" max="100" value="50" class="form-range"/>
                    </div>
                  </div>

                  <div class="d-grid gap-2">
                    <a t-att-href="'/shop/product/%s' % product.id" class="btn btn-light">
                      &larr; Volver al producto
                    </a>
                    <button type="button" id="spw_add_to_cart" class="btn btn-primary">
                      Añadir al carrito con esta personalización
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>

      </div>
    </t>
  </template>
</odoo>