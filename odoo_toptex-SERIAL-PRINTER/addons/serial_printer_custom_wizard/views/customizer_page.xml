<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Página de personalización -->
  <template id="spw_customize_page" name="SPW – Personalización" page="True">
    <t t-call="website.layout">
      <div class="container spw-container" id="spw_root" t-att-data-product-id="product.id">
        <!-- Variante seleccionada (si llega por querystring) -->
        <t t-set="variant" t-value="product.product_variant_id"/>
        <t t-if="request.params.get('variant_id')">
          <t t-set="variant" t-value="request.env['product.product'].browse(int(request.params.get('variant_id')))"/>
        </t>

        <div class="row">
          <!-- Lienzo -->
          <div class="col-12 col-lg-7">
            <div class="spw-canvas-wrapper position-relative">
              <img id="spw_base_img" class="img-fluid"
                   t-att-src="variant and ('/web/image/product.product/%s/image_1920' % variant.id) or ('/web/image/product.template/%s/image_1920' % product.id)"/>
              <img id="spw_logo" class="position-absolute top-0 start-0 d-none" alt="logo"/>
            </div>
            <p class="mt-3">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>
          </div>

          <!-- Controles -->
          <div class="col-12 col-lg-5">
            <div class="o_we_form">

              <!-- Técnicas -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Tipo de personalización</label>
                <div class="d-flex flex-wrap gap-2">
                  <input type="radio" name="spw_technique" id="spw_t_serigrafia" value="serigrafia" class="btn-check" checked="checked"/>
                  <label class="btn btn-outline-secondary" for="spw_t_serigrafia">Serigrafía</label>

                  <input type="radio" name="spw_technique" id="spw_t_dtf" value="dtf" class="btn-check"/>
                  <label class="btn btn-outline-secondary" for="spw_t_dtf">DTF</label>

                  <input type="radio" name="spw_technique" id="spw_t_bordado" value="bordado" class="btn-check"/>
                  <label class="btn btn-outline-secondary" for="spw_t_bordado">Bordado</label>

                  <input type="radio" name="spw_technique" id="spw_t_cuero" value="marcado_cuero" class="btn-check"/>
                  <label class="btn btn-outline-secondary" for="spw_t_cuero">Marcado en cuero</label>
                </div>
              </div>

              <!-- Colores NS300 (rellenos por JS) -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Color (NS300)</label>
                <div id="spw_colors" class="d-flex flex-wrap gap-2"></div>
              </div>

              <!-- Posiciones rápidas -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Posición rápida</label>
                <div class="d-flex flex-wrap gap-2">
                  <button type="button" class="btn btn-light" data-pos="chest_left">Pecho izq.</button>
                  <button type="button" class="btn btn-light" data-pos="chest_right">Pecho dcha.</button>
                  <button type="button" class="btn btn-light" data-pos="back">Espalda</button>
                  <button type="button" class="btn btn-light" data-pos="free">Libre</button>
                </div>
              </div>

              <!-- Observaciones -->
              <div class="mb-4">
                <label for="spw_notes" class="form-label fw-semibold">Observaciones</label>
                <textarea id="spw_notes" class="form-control" rows="3"
                          placeholder="Tamaño de impresión y detalles (p. ej., pecho y espalda)."></textarea>
              </div>

              <!-- Subir logo -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Subir logo (PNG/JPG/SVG)</label>
                <div class="spw-file">
                  <label for="spw_file" class="btn btn-outline-secondary w-100 mb-2">Seleccionar archivo</label>
                  <input id="spw_file" type="file" accept=".png,.jpg,.jpeg,.svg"/>
                </div>
              </div>

              <!-- Sliders -->
              <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                  <label class="form-label">Tamaño</label>
                  <input id="spw_scale" type="range" min="10" max="200" value="100" class="form-range"/>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label">Rotación</label>
                  <input id="spw_rotate" type="range" min="-180" max="180" value="0" class="form-range"/>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label">Posición X</label>
                  <input id="spw_pos_x" type="range" min="0" max="100" value="50" class="form-range"/>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label">Posición Y</label>
                  <input id="spw_pos_y" type="range" min="0" max="100" value="50" class="form-range"/>
                </div>
              </div>

              <!-- Acciones -->
              <div class="d-flex justify-content-between">
                <a t-att-href="product.website_url" class="btn btn-light">← Volver al producto</a>
                <button id="spw_add_to_cart" class="btn btn-primary">
                  Añadir al carrito con esta personalización
                </button>
              </div>

            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>