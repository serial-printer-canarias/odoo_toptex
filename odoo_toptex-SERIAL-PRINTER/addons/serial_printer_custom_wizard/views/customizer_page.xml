<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Página del personalizador -->
  <template id="spw_customize_page" name="SPW - Customizer Page">
    <t t-call="website.layout">
      <!-- Requeridos por website para evitar errores de metadata -->
      <t t-set="pageName" t-value="'spw_customize_page'"/>
      <t t-set="main_object" t-value="product"/>

      <!-- Determinar imagen a mostrar: variante si existe, si no la plantilla -->
      <t t-set="img_src">
        <t t-if="variant">
          <t t-esc="'/web/image/product.product/%s/image_1024' % variant.id"/>
        </t>
        <t t-else="">
          <t t-esc="'/web/image/product.template/%s/image_1024' % product.id"/>
        </t>
      </t>

      <div class="container my-5 spw-customizer">
        <div class="row g-4">
          <!-- Lienzo -->
          <div class="col-12 col-lg-7">
            <div id="spw_canvas" class="spw-canvas card p-3">
              <img id="spw_product_img"
                   class="img-fluid rounded"
                   t-att-src="img_src"
                   alt="Producto"/>
              <!-- Overlay del logo (se hace visible por JS) -->
              <img id="spw_logo_preview"
                   class="spw-logo-preview d-none"
                   alt="Logo preview"/>
            </div>
            <!-- Controles de posición/escala/rotación (sin tocar IDs esperados por el JS) -->
            <div class="card mt-3">
              <div class="card-body d-flex flex-wrap gap-2 align-items-center">
                <button type="button" id="spw_move_up" class="btn btn-outline-secondary" aria-label="Arriba">↑</button>
                <button type="button" id="spw_move_down" class="btn btn-outline-secondary" aria-label="Abajo">↓</button>
                <button type="button" id="spw_move_left" class="btn btn-outline-secondary" aria-label="Izquierda">←</button>
                <button type="button" id="spw_move_right" class="btn btn-outline-secondary" aria-label="Derecha">→</button>

                <span class="mx-2">|</span>

                <button type="button" id="spw_scale_minus" class="btn btn-outline-secondary" aria-label="Reducir">−</button>
                <button type="button" id="spw_scale_plus" class="btn btn-outline-secondary" aria-label="Ampliar">+</button>

                <span class="mx-2">|</span>

                <button type="button" id="spw_rotate_left" class="btn btn-outline-secondary" aria-label="Rotar izquierda">⟲</button>
                <button type="button" id="spw_rotate_right" class="btn btn-outline-secondary" aria-label="Rotar derecha">⟳</button>

                <span class="mx-2">|</span>

                <button type="button" id="spw_reset" class="btn btn-outline-danger">Reset</button>
              </div>
            </div>
          </div>

          <!-- Panel lateral -->
          <div class="col-12 col-lg-5">
            <div class="card">
              <div class="card-body">
                <a t-att-href="product.website_url or '/shop'" class="btn btn-link p-0 mb-3">← Volver al producto</a>

                <!-- Subida de logo -->
                <div class="mb-3">
                  <label for="spw_logo_input" class="form-label fw-bold">Subir logo</label>
                  <input id="spw_logo_input" class="form-control" type="file" accept="image/*"/>
                  <div class="form-text">Formatos: PNG/JPG/SVG. Máx. 10MB.</div>
                </div>

                <!-- Técnica (default: Serigrafía) -->
                <div class="mb-3">
                  <div class="fw-bold mb-1">Técnica</div>
                  <div class="d-flex flex-wrap gap-3">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="spw_technique" id="spw_tech_ser" value="serigrafia" checked="checked"/>
                      <label class="form-check-label" for="spw_tech_ser">Serigrafía</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="spw_technique" id="spw_tech_dtf" value="dtf"/>
                      <label class="form-check-label" for="spw_tech_dtf">DTF</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="spw_technique" id="spw_tech_bor" value="bordado"/>
                      <label class="form-check-label" for="spw_tech_bor">Bordado</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="spw_technique" id="spw_tech_cue" value="cuero"/>
                      <label class="form-check-label" for="spw_tech_cue">Marcado en cuero</label>
                    </div>
                  </div>
                </div>

                <!-- Colores (placeholder simple, el JS puede ampliarlos) -->
                <div class="mb-3">
                  <div class="fw-bold mb-1">Color</div>
                  <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary spw-color-btn" data-color="#000000">Negro</button>
                    <button type="button" class="btn btn-outline-secondary spw-color-btn" data-color="#FFFFFF">Blanco</button>
                    <button type="button" class="btn btn-outline-secondary spw-color-btn" data-color="#C8102E">Rojo</button>
                    <button type="button" class="btn btn-outline-secondary spw-color-btn" data-color="#0032A0">Azul</button>
                  </div>
                </div>

                <!-- Observaciones -->
                <div class="mb-3">
                  <label for="spw_notes" class="form-label fw-bold">Observaciones (tamaño, posición…)</label>
                  <textarea id="spw_notes" class="form-control" rows="3" placeholder="Ej.: Pecho 10 cm, Espalda 25 cm"></textarea>
                </div>

                <!-- Acciones -->
                <div class="d-grid gap-2">
                  <button id="spw_apply_to_cart" type="button" class="btn btn-primary">Aplicar y volver al producto</button>
                  <a t-att-href="product.website_url or '/shop'" class="btn btn-outline-secondary">Cancelar</a>
                </div>

                <!-- Datos ocultos (no tocar IDs) -->
                <input type="hidden" id="spw_product_tmpl_id" t-att-value="product.id"/>
                <t t-if="variant">
                  <input type="hidden" id="spw_variant_id" t-att-value="variant.id"/>
                </t>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>