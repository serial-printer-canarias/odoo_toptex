<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="spw_customize_page" name="SPW - Customizer Page">
    <t t-call="website.layout">
      <!-- Necesario para Website -->
      <t t-set="pageName" t-value="'spw_customize_page'"/>
      <t t-set="main_object" t-value="product"/>

      <div class="container my-5 spw-customizer">
        <div class="row g-4">
          <!-- PREVIEW -->
          <div class="col-12 col-lg-7">
            <div class="card p-3">
              <div class="position-relative w-100">
                <img id="spw_base_img"
                     class="img-fluid rounded"
                     t-att-src="base_image_url"
                     alt="Product"/>
                <!-- Logo subido -->
                <img id="spw_logo_img"
                     class="position-absolute d-none"
                     style="left:50%;top:50%;transform:translate(-50%,-50%);max-width:60%;pointer-events:auto;"/>
              </div>
              <p class="text-muted mt-3 mb-0">
                Arrastra el logo sobre la imagen para posicionarlo o usa los controles.
              </p>
            </div>
          </div>

          <!-- CONTROLES -->
          <div class="col-12 col-lg-5">
            <div class="card p-3">

              <!-- Tipo de personalización -->
              <h5 class="mb-2">Tipo de personalización</h5>
              <div class="btn-group w-100 mb-3" role="group" aria-label="Tipo">
                <input type="radio" class="btn-check" name="spw_method" id="spw_method_screen" value="screen" checked="checked" autocomplete="off"/>
                <label class="btn btn-outline-secondary" for="spw_method_screen">Serigrafía</label>

                <input type="radio" class="btn-check" name="spw_method" id="spw_method_dtf" value="dtf" autocomplete="off"/>
                <label class="btn btn-outline-secondary" for="spw_method_dtf">DTF</label>

                <input type="radio" class="btn-check" name="spw_method" id="spw_method_emb" value="embroidery" autocomplete="off"/>
                <label class="btn btn-outline-secondary" for="spw_method_emb">Bordado</label>

                <input type="radio" class="btn-check" name="spw_method" id="spw_method_leather" value="leather" autocomplete="off"/>
                <label class="btn btn-outline-secondary" for="spw_method_leather">Marcado en cuero</label>
              </div>

              <!-- Colores -->
              <h5 class="mt-2">Color</h5>
              <div class="d-flex gap-3 mb-3" id="spw_color_list">
                <button type="button" class="spw-color btn p-0 rounded-circle border" style="width:28px;height:28px;background:#000000;" data-color="#000000" aria-label="Negro"></button>
                <button type="button" class="spw-color btn p-0 rounded-circle border" style="width:28px;height:28px;background:#FFFFFF;" data-color="#FFFFFF" aria-label="Blanco"></button>
                <button type="button" class="spw-color btn p-0 rounded-circle border" style="width:28px;height:28px;background:#1f6feb;" data-color="#1f6feb" aria-label="Azul"></button>
                <button type="button" class="spw-color btn p-0 rounded-circle border" style="width:28px;height:28px;background:#d22f2f;" data-color="#d22f2f" aria-label="Rojo"></button>
              </div>

              <!-- Posición rápida -->
              <h5 class="mt-2">Posición rápida</h5>
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <button type="button" class="btn btn-outline-secondary w-100 spw-quick-pos" data-pos="left-chest">Pecho izq.</button>
                </div>
                <div class="col-6">
                  <button type="button" class="btn btn-outline-secondary w-100 spw-quick-pos" data-pos="right-chest">Pecho dcha.</button>
                </div>
                <div class="col-6">
                  <button type="button" class="btn btn-outline-secondary w-100 spw-quick-pos" data-pos="back">Espalda</button>
                </div>
                <div class="col-6">
                  <button type="button" class="btn btn-secondary w-100 spw-quick-pos" data-pos="free">Libre</button>
                </div>
              </div>

              <!-- Observaciones -->
              <div class="mb-3">
                <label for="spw_notes" class="form-label">Observaciones</label>
                <textarea id="spw_notes" class="form-control" rows="3"
                          placeholder="Tamaño, número de tintas y detalles (p.ej. pecho y espalda)"></textarea>
              </div>

              <!-- Fichero -->
              <div class="mb-3">
                <label for="spw_file" class="form-label">Subir logo (PNG/JPG/SVG)</label>
                <input id="spw_file" class="form-control" type="file" accept=".png,.jpg,.jpeg,.svg"/>
              </div>

              <!-- Sliders -->
              <div class="row g-3">
                <div class="col-12">
                  <label for="spw_scale" class="form-label">Tamaño</label>
                  <input id="spw_scale" type="range" class="form-range" min="0.2" max="2.0" step="0.01" value="1"/>
                </div>
                <div class="col-12">
                  <label for="spw_rotate" class="form-label">Rotación</label>
                  <input id="spw_rotate" type="range" class="form-range" min="-180" max="180" step="1" value="0"/>
                </div>
                <div class="col-12">
                  <label for="spw_pos_x" class="form-label">Posición X</label>
                  <input id="spw_pos_x" type="range" class="form-range" min="0" max="100" step="1" value="50"/>
                </div>
                <div class="col-12">
                  <label for="spw_pos_y" class="form-label">Posición Y</label>
                  <input id="spw_pos_y" type="range" class="form-range" min="0" max="100" step="1" value="50"/>
                </div>
              </div>

              <!-- Acciones -->
              <div class="d-flex justify-content-between align-items-center mt-4">
                <a t-att-href="product.website_url or '/shop'" class="btn btn-light">← Volver al producto</a>
                <button id="spw_add_to_cart" class="btn btn-primary">Añadir al carrito con esta personalización</button>
              </div>

            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>