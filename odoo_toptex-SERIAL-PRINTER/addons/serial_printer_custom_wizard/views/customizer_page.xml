<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="customizer_page" name="SPW: Customizer Page">
    <t t-call="website.layout">
      <div class="container py-4">

        <!-- Lienzo -->
        <div id="spw_canvas" class="spw-canvas">
          <img id="spw_product_img"
               t-att-src="product_image_url"
               alt="Producto"
               class="img-fluid"/>
          <!-- Vista previa del logo (se muestra al elegir archivo) -->
          <img id="spw_logo_preview" class="spw-logo-preview d-none" alt="Logo preview"/>
        </div>

        <!-- Controles (los mismos sliders que ya usabas) -->
        <form id="spw_form" class="mt-4" method="post" enctype="multipart/form-data">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <input type="hidden" name="variant_id" t-att-value="variant_id"/>

          <div class="mb-3">
            <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
            <input id="spw_logo_input" class="form-control" type="file" name="logo"
                   accept=".png,.jpg,.jpeg,.svg,image/png,image/jpeg,image/svg+xml"/>
          </div>

          <div class="mb-3">
            <label class="form-label">Tamaño</label>
            <input id="spw_size" type="range" min="10" max="100" value="40" class="form-range"/>
          </div>
          <div class="mb-3">
            <label class="form-label">Posición X</label>
            <input id="spw_pos_x" type="range" min="-200" max="200" value="0" class="form-range"/>
          </div>
          <div class="mb-3">
            <label class="form-label">Posición Y</label>
            <input id="spw_pos_y" type="range" min="-200" max="200" value="0" class="form-range"/>
          </div>
          <div class="mb-3">
            <label class="form-label">Rotación</label>
            <input id="spw_rotate" type="range" min="-180" max="180" value="0" class="form-range"/>
          </div>
        </form>
      </div>
    </t>
  </template>
</odoo>