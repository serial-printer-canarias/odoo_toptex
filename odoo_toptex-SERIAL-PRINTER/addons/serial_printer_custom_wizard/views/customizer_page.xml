<odoo>
  <data>

    <!-- Página de personalización -->
    <template id="spw_customize_page" name="SPW Personalización">
      <t t-call="website.layout">

        <!-- Producto y variante -->
        <t t-set="product" t-value="request.env['product.template'].browse(int(request.params.get('product_id') or 0))"/>
        <t t-set="variant" t-value="product.product_variant_id"/>
        <t t-if="request.params.get('variant_id')">
          <t t-set="variant" t-value="request.env['product.product'].browse(int(request.params.get('variant_id')))"/>
        </t>

        <div class="container spw-container py-4">
          <t t-if="variant">
            <div class="row">
              <!-- Lienzo -->
              <div class="col-12 col-lg-7">
                <div class="spw-canvas-wrapper position-relative">
                  <img id="spw_base_img"
                       class="img-fluid w-100 rounded shadow-sm"
                       t-att-src="(variant.image_1024 or variant.product_tmpl_id.image_1024) or ''"
                       alt="Base"/>
                  <img id="spw_logo" class="position-absolute top-0 start-0" style="display:none;" alt="Logo"/>
                </div>
                <p class="mt-3">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>
              </div>

              <!-- Controles -->
              <div class="col-12 col-lg-5">
                <div class="o_we_form">

                  <!-- Técnicas -->
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Tipo de personalización</label>
                    <div class="d-flex gap-2 flex-wrap" id="spw_techniques">
                      <input class="btn-check" type="radio" name="spw_technique" id="spw_tec_serigrafia" value="serigrafia" checked="checked"/>
                      <label class="btn btn-outline-secondary" for="spw_tec_serigrafia">Serigrafía</label>

                      <input class="btn-check" type="radio" name="spw_technique" id="spw_tec_dtf" value="dtf"/>
                      <label class="btn btn-outline-secondary" for="spw_tec_dtf">DTF</label>

                      <input class="btn-check" type="radio" name="spw_technique" id="spw_tec_bordado" value="bordado"/>
                      <label class="btn btn-outline-secondary" for="spw_tec_bordado">Bordado</label>

                      <input class="btn-check" type="radio" name="spw_technique" id="spw_tec_cuero" value="marcado_cuero"/>
                      <label class="btn btn-outline-secondary" for="spw_tec_cuero">Marcado en cuero</label>
                    </div>
                  </div>

                  <!-- Paleta de color -->
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Color</label>
                    <div id="spw_palette" class="d-flex flex-wrap gap-2 align-items-center"></div>
                  </div>

                  <!-- Posiciones rápidas -->
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Posición rápida</label>
                    <div class="d-flex gap-2 flex-wrap" id="spw_quickpos">
                      <button type="button" class="btn btn-outline-secondary" data-pos="left-chest">Pecho izq.</button>
                      <button type="button" class="btn btn-outline-secondary" data-pos="right-chest">Pecho dcha.</button>
                      <button type="button" class="btn btn-outline-secondary" data-pos="back">Espalda</button>
                      <button type="button" class="btn btn-outline-secondary" data-pos="free">Libre</button>
                    </div>
                  </div>

                  <!-- Observaciones -->
                  <div class="mb-3">
                    <label class="form-label fw-semibold" for="spw_notes">Observaciones</label>
                    <textarea id="spw_notes" class="form-control" rows="2"
                              placeholder="Tamaño de impresión y detalles (p. ej. pecho y espalda)."></textarea>
                  </div>

                  <!-- Subir logo -->
                  <div class="mb-3 spw-file">
                    <label for="spw_file" class="form-label fw-semibold d-block">Subir logo (PNG/JPG/SVG)</label>
                    <label class="btn btn-outline-secondary w-100 mb-2" for="spw_file">Seleccionar archivo</label>
                    <input id="spw_file" type="file" accept=".png,.jpg,.jpeg,.svg"/>
                  </div>

                  <!-- Sliders -->
                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <label class="form-label">Tamaño</label>
                      <input id="spw_scale" type="range" class="form-range" min="10" max="300" value="100"/>
                    </div>
                    <div class="col-12 col-md-6">
                      <label class="form-label">Rotación</label>
                      <input id="spw_rotate" type="range" class="form-range" min="-180" max="180" value="0"/>
                    </div>
                    <div class="col-12 col-md-6">
                      <label class="form-label">Posición X</label>
                      <input id="spw_pos_x" type="range" class="form-range" min="0" max="100" value="50"/>
                    </div>
                    <div class="col-12 col-md-6">
                      <label class="form-label">Posición Y</label>
                      <input id="spw_pos_y" type="range" class="form-range" min="0" max="100" value="50"/>
                    </div>
                  </div>

                  <!-- Acciones -->
                  <div class="d-flex justify-content-between align-items-center mt-3">
                    <a t-att-href="product.website_url" class="btn btn-light">← Volver al producto</a>
                    <button id="spw_add_to_cart" type="button" class="btn btn-primary">
                      Añadir al carrito con esta personalización
                    </button>
                  </div>

                </div>
              </div>
            </div>
          </t>
          <t t-if="not variant">
            <div class="alert alert-danger mt-3">No se encontró la variante.</div>
          </t>
        </div>

        <!-- Contexto para JS (JSON válido) -->
        <script type="application/json" id="spw_ctx">
          {
            "product_id": <t t-esc="product and product.id or 0"/>,
            "variant_id": <t t-esc="variant and variant.id or 0"/>
          }
        </script>

      </t>
    </template>

  </data>
</odoo>