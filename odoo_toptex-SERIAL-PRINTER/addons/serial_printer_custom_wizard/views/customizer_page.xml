<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="spw_customizer_page" name="SPW: Personalizador">
    <t t-call="website.layout">
      <t t-set="main_object" t-value="product or website"/>
      <t t-set="product_url" t-value="product and '/shop/product/%s' % slug(product) or '/shop'"/>

      <div class="container my-5 spw-customizer">
        <!-- Vista previa -->
        <div class="row mb-4">
          <div class="col-12">
            <div class="spw-canvas position-relative">
              <t t-if="variant">
                <img id="spw_product_img"
                     t-att-src="'/web/image/%s/%s/image_1024' % (variant._name, variant.id)"
                     class="img-fluid rounded shadow"/>
              </t>
              <t t-else="">
                <img id="spw_product_img"
                     t-att-src="'/web/image/%s/%s/image_1024' % (product._name, product.id)"
                     class="img-fluid rounded shadow"/>
              </t>
              <img id="spw_logo_preview" src="" alt="Logo preview" class="d-none"/>
            </div>
            <p class="mt-3 lead">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>
          </div>
        </div>

        <!-- Controles -->
        <div class="row g-3">
          <!-- Técnicas -->
          <div class="col-12">
            <h5 class="mb-2">Tipo de personalización</h5>
            <div class="btn-group w-100" role="group" aria-label="Método">
              <button type="button" class="btn btn-outline-secondary spw-method active" data-method="serigrafia">Serigrafía</button>
              <button type="button" class="btn btn-outline-secondary spw-method" data-method="dtf">DTF</button>
              <button type="button" class="btn btn-outline-secondary spw-method" data-method="bordado">Bordado</button>
              <button type="button" class="btn btn-outline-secondary spw-method" data-method="marcado">Marcado en cuero</button>
            </div>
          </div>

          <!-- Colores -->
          <div class="col-12">
            <h5 class="mb-2">Color</h5>
            <div id="spw-colors" class="d-flex flex-wrap gap-2">
              <button type="button" class="spw-color" style="--spw-color:#000000" data-color="#000000" aria-label="Negro"></button>
              <button type="button" class="spw-color" style="--spw-color:#FFFFFF" data-color="#FFFFFF" aria-label="Blanco"></button>
              <button type="button" class="spw-color" style="--spw-color:#1E63FF" data-color="#1E63FF" aria-label="Azul"></button>
              <button type="button" class="spw-color" style="--spw-color:#D32F2F" data-color="#D32F2F" aria-label="Rojo"></button>
            </div>
          </div>

          <!-- Posiciones rápidas -->
          <div class="col-12">
            <h5 class="mb-2">Posición rápida</h5>
            <div class="d-flex flex-wrap gap-2">
              <button type="button" class="btn btn-outline-secondary spw-quickpos" data-pos="left_chest">Pecho izq.</button>
              <button type="button" class="btn btn-outline-secondary spw-quickpos" data-pos="right_chest">Pecho dcha.</button>
              <button type="button" class="btn btn-outline-secondary spw-quickpos" data-pos="back">Espalda</button>
              <button type="button" class="btn btn-secondary spw-quickpos" data-pos="free">Libre</button>
            </div>
          </div>

          <!-- Observaciones -->
          <div class="col-12">
            <h5 class="mb-2">Observaciones</h5>
            <textarea id="spw_notes" class="form-control"
                      placeholder="Tamaño, número de tintas y detalles (p.ej. pecho y espalda)"
                      rows="3"></textarea>
          </div>

          <!-- Subir logo -->
          <div class="col-12">
            <h5 class="mb-2">Subir logo (PNG/JPG/SVG)</h5>
            <input id="spw_logo_file" class="form-control" type="file" accept=".png,.jpg,.jpeg,.svg"/>
          </div>

          <!-- Sliders -->
          <div class="col-12 col-md-6">
            <label class="form-label">Tamaño</label>
            <input id="spw_scale" type="range" class="form-range" min="0.2" max="2" step="0.01" value="1"/>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label">Rotación</label>
            <input id="spw_rotate" type="range" class="form-range" min="-180" max="180" step="1" value="0"/>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label">Posición X</label>
            <input id="spw_pos_x" type="range" class="form-range" min="0" max="100" step="1" value="50"/>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label">Posición Y</label>
            <input id="spw_pos_y" type="range" class="form-range" min="0" max="100" step="1" value="50"/>
          </div>

          <!-- Acciones -->
          <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mt-2">
              <a t-att-href="product_url" class="btn btn-light">&#8592; Volver al producto</a>
              <button id="spw_add_to_cart" type="button" class="btn btn-primary">
                Añadir al carrito con esta personalización
              </button>
            </div>
          </div>
        </div>

        <!-- Metadatos para el JS -->
        <input type="hidden" id="spw_product_id" t-att-value="product and product.id"/>
        <input type="hidden" id="spw_variant_id" t-att-value="variant and variant.id"/>
      </div>
    </t>
  </template>
</odoo>