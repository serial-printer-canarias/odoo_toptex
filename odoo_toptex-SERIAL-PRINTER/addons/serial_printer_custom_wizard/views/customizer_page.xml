<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="spw_customizer_page" name="SPW: Página de Personalización">
    <t t-call="website.layout">
      <div class="container py-4">
        <div class="row g-4">
          <!-- Lienzo de previsualización -->
          <div class="col-12 col-lg-7">
            <div id="spw_canvas" class="spw-stage">
              <!-- Imagen de la variante seleccionada -->
              <img id="spw_product_img"
                   class="spw-base"
                   t-att-src="'/web/image/product.product/%s/image_1024' % variant.id"
                   alt="Producto"/>
              <!-- Logo subido por el usuario -->
              <img id="spw_logo_preview"
                   class="spw-overlay d-none"
                   src=""
                   alt="Logo"/>
            </div>
          </div>

          <!-- Controles -->
          <div class="col-12 col-lg-5">
            <div class="card">
              <div class="card-body">
                <h5 class="mb-3">Subir logo (PNG/JPG/SVG)</h5>
                <input id="spw_logo_file" type="file"
                       class="form-control mb-4"
                       accept=".png,.jpg,.jpeg,.svg"/>

                <label class="form-label">Tamaño</label>
                <input id="spw_size" type="range" class="form-range mb-3"
                       min="30" max="200" value="100"/>

                <label class="form-label">Rotación</label>
                <input id="spw_rot" type="range" class="form-range mb-3"
                       min="-180" max="180" value="0"/>

                <label class="form-label">Posición X</label>
                <input id="spw_posx" type="range" class="form-range mb-3"
                       min="-50" max="50" value="0"/>

                <label class="form-label">Posición Y</label>
                <input id="spw_posy" type="range" class="form-range mb-4"
                       min="-50" max="50" value="10"/>

                <a t-att-href="'/shop/product/%s' % product_tmpl.id"
                   class="btn btn-light me-2">← Volver</a>
                <a href="#" class="btn btn-primary">
                  Añadir al carrito con esta personalización
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>