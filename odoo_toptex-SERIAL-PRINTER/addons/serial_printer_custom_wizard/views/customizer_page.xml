<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Página de personalización -->
  <template id="spw_customize_page" name="SPW · Personalización" page="True">
    <t t-call="website.layout">
      <div class="container spw-container my-5">

        <!-- ========= Contexto/variables ========= -->
        <!-- Product template llega desde el controlador -->
        <t t-set="prod_tmpl" t-value="product"/>

        <!-- Si viene variant_id en la URL, usamos esa variante; si no, la principal -->
        <t t-if="request.params.get('variant_id')">
          <t t-set="variant"
             t-value="request.env['product.product'].browse(int(request.params.get('variant_id')))"/>
        </t>
        <t t-else="">
          <t t-set="variant" t-value="prod_tmpl.product_variant_id"/>
        </t>

        <!-- ========= Cabecera ========= -->
        <div class="row mb-4">
          <div class="col-12">
            <h1 class="h3">
              <t t-esc="prod_tmpl.display_name"/> — Personalización
            </h1>
          </div>
        </div>

        <div class="row g-4">
          <!-- ======= Lienzo / previsualización ======= -->
          <div class="col-12 col-lg-7">
            <div class="spw-canvas-wrapper position-relative w-100">
              <!-- Imagen base: prioriza imagen de la variante; si no, la del template -->
              <img id="spw_base_img"
                   class="img-fluid w-100 d-block"
                   alt="Producto"
                   t-att-src="variant and ('/web/image/product.product/%s/image_1024' % variant.id) or ('/web/image/product.template/%s/image_1024' % prod_tmpl.id)"/>
              <!-- Capa del logo -->
              <img id="spw_logo" class="position-absolute d-none" alt="Logo"/>
            </div>

            <p class="mt-3 text-muted">
              Arrastra el logo sobre la imagen para posicionarlo o usa los controles.
            </p>
          </div>

          <!-- ======= Controles ======= -->
          <div class="col-12 col-lg-5">
            <div class="o_we_form">

              <!-- Técnicas (solo: Serigrafía, DTF, Bordado, Marcado en cuero) -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Tipo de personalización</label>
                <div class="d-flex flex-wrap gap-2" id="spw_techniques">
                  <input class="btn-check" type="radio" name="spw_technique" id="spw_t_serigrafia" value="serigrafia" checked="checked"/>
                  <label class="btn btn-outline-secondary" for="spw_t_serigrafia">Serigrafía</label>

                  <input class="btn-check" type="radio" name="spw_technique" id="spw_t_dtf" value="dtf"/>
                  <label class="btn btn-outline-secondary" for="spw_t_dtf">DTF</label>

                  <input class="btn-check" type="radio" name="spw_technique" id="spw_t_bordado" value="bordado"/>
                  <label class="btn btn-outline-secondary" for="spw_t_bordado">Bordado</label>

                  <input class="btn-check" type="radio" name="spw_technique" id="spw_t_cuero" value="marcado_cuero"/>
                  <label class="btn btn-outline-secondary" for="spw_t_cuero">Marcado en cuero</label>
                </div>
              </div>

              <!-- Paleta de color (NS300 visual, sin mencionarlo) -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Color</label>
                <div class="d-flex flex-wrap gap-2" id="spw_palette">
                  <!-- chips visuales; data-color guarda el hex -->
                  <button type="button" class="spw-chip" data-color="#000000" style="background:#000000" aria-label="Negro"></button>
                  <button type="button" class="spw-chip" data-color="#FFFFFF" style="background:#FFFFFF;border:1px solid #ddd" aria-label="Blanco"></button>
                  <button type="button" class="spw-chip" data-color="#C8102E" style="background:#C8102E" aria-label="Rojo"></button>
                  <button type="button" class="spw-chip" data-color="#0057B8" style="background:#0057B8" aria-label="Azul"></button>
                  <button type="button" class="spw-chip" data-color="#00843D" style="background:#00843D" aria-label="Verde"></button>
                  <button type="button" class="spw-chip" data-color="#FF6A00" style="background:#FF6A00" aria-label="Naranja"></button>
                  <button type="button" class="spw-chip" data-color="#FFD100" style="background:#FFD100" aria-label="Amarillo"></button>
                  <button type="button" class="spw-chip" data-color="#6C757D" style="background:#6C757D" aria-label="Gris"></button>
                  <button type="button" class="spw-chip" data-color="#9B5E34" style="background:#9B5E34" aria-label="Marrón"></button>
                  <button type="button" class="spw-chip" data-color="#7A003C" style="background:#7A003C" aria-label="Burdeos"></button>
                </div>
                <input type="hidden" id="spw_color_hex" value="#000000"/>
              </div>

              <!-- Posición rápida -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Posición rápida</label>
                <div class="d-flex flex-wrap gap-2">
                  <button type="button" class="btn btn-outline-secondary spw-pos" data-pos="pecho_izq">Pecho izq.</button>
                  <button type="button" class="btn btn-outline-secondary spw-pos" data-pos="pecho_dcha">Pecho dcha.</button>
                  <button type="button" class="btn btn-outline-secondary spw-pos" data-pos="espalda">Espalda</button>
                  <button type="button" class="btn btn-outline-secondary spw-pos" data-pos="libre">Libre</button>
                </div>
              </div>

              <!-- Observaciones -->
              <div class="mb-4">
                <label for="spw_notes" class="form-label fw-semibold">Observaciones</label>
                <textarea id="spw_notes" class="form-control" rows="3"
                  placeholder="Tamaño de impresión y detalles (p. ej. pecho y espalda)."></textarea>
              </div>

              <!-- Subir logo (PNG/JPG/SVG) -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Subir logo (PNG/JPG/SVG)</label>
                <div class="spw-file">
                  <label for="spw_file">Seleccionar archivo</label>
                  <input id="spw_file" type="file" accept="image/png,image/jpeg,image/svg+xml"/>
                </div>
              </div>

              <!-- Deslizadores -->
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label class="form-label">Tamaño</label>
                  <input id="spw_scale" type="range" class="form-range" min="10" max="200" value="100"/>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label">Rotación</label>
                  <input id="spw_rotate" type="range" class="form-range" min="-180" max="180" value="0"/>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label">Posición X</label>
                  <input id="spw_pos_x" type="range" class="form-range" min="0" max="100" value="50"/>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label">Posición Y</label>
                  <input id="spw_pos_y" type="range" class="form-range" min="0" max="100" value="50"/>
                </div>
              </div>

              <!-- Acciones -->
              <div class="d-flex justify-content-between align-items-center mt-4">
                <a t-att-href="prod_tmpl.website_url" class="btn btn-light">← Volver al producto</a>
                <button id="spw_add_to_cart" class="btn btn-primary">
                  Añadir al carrito con esta personalización
                </button>
              </div>

            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>