<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Página del personalizador -->
  <template id="customizer_page" name="SPW Customizer Page">
    <t t-call="website.layout">
      <div class="container py-5" id="spw_customizer"
           t-att-data-product-image="('/web/image/product.template/%s/image_1920' % product.id) if product and product.image_1920 else ''">
        <div class="row g-4">
          <div class="col-12">
            <h1 class="h3 mb-3">
              Personalizar: <t t-esc="product.display_name or 'Producto'"/>
            </h1>
          </div>

          <div class="col-12 col-lg-6">
            <canvas id="spwCanvas"></canvas>
          </div>

          <div class="col-12 col-lg-6 spw-controls">
            <!-- IMPORTANTE: el controlador debe existir y procesar estos campos -->
            <form t-att-action="'/personalizar/%s/confirm' % product.id" method="post" enctype="multipart/form-data">
              <input type="hidden" name="product_id" t-att-value="product.id"/>
              <input type="hidden" id="spw_logo_data" name="spw_logo_data"/>

              <div class="mb-3">
                <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
                <input id="spw_logo" class="form-control" type="file" name="spw_logo" accept=".png,.jpg,.jpeg,.svg"/>
              </div>

              <div class="mb-3">
                <label class="form-label">Técnica de personalización</label>
                <select name="spw_technique" class="form-select">
                  <option>DTF</option>
                  <option>Vinilo</option>
                  <option>Bordado</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Posición</label>
                <select id="spw_position" name="spw_position" class="form-select">
                  <option value="pecho">Pecho</option>
                  <option value="espalda">Espalda</option>
                  <option value="lateral">Lateral</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Color de impresión</label>
                <input class="form-control" name="spw_color" placeholder="Ej. Blanco / Pantone 186C"/>
              </div>

              <div class="mb-3">
                <label class="form-label">Cantidad</label>
                <input class="form-control" name="spw_qty" type="number" min="1" step="1" value="1"/>
              </div>

              <div class="mb-3">
                <label class="form-label">Observaciones</label>
                <textarea class="form-control" rows="3" name="spw_notes" placeholder="Notas para el taller..."></textarea>
              </div>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Añadir al carrito con personalización</button>
                <a href="/shop" class="btn btn-outline-secondary">← Volver</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>