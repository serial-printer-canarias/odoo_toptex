<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="spw_customize_page" name="SPW - Customizer Page">
    <t t-call="website.layout">
      <!-- Requeridos por Website/QWeb -->
      <t t-set="pageName" t-value="'spw_customize_page'"/>
      <t t-set="tmpl_id" t-value="int(request.params.get('product_tmpl_id') or 0)"/>
      <t t-set="product" t-value="request.env['product.template'].sudo().browse([tmpl_id])[:1]"/>
      <t t-set="v_id" t-value="int(request.params.get('product_id') or 0)"/>
      <t t-if="v_id">
        <t t-set="variant" t-value="request.env['product.product'].sudo().browse([v_id])[:1]"/>
      </t>
      <t t-set="main_object" t-value="product"/>

      <div class="container my-5 spw-customizer">
        <div class="row g-4">
          <!-- Lienzo -->
          <div class="col-12 col-lg-7">
            <div id="spw_canvas" class="spw-canvas card p-3">
              <img id="spw_product_img"
                   class="img-fluid rounded"
                   t-att-src="variant and ('/web/image/product.product/%s/image_1024' % variant.id) or ('/web/image/product.template/%s/image_1024' % product.id)"
                   alt="Producto"/>
              <!-- Overlay del logo -->
              <img id="spw_logo_preview" class="spw-logo-preview" alt="Logo" style="display:none;"/>
            </div>
            <p class="text-muted mt-3">
              Arrastra el logo sobre la imagen para posicionarlo o usa los controles.
            </p>
          </div>

          <!-- Controles -->
          <div class="col-12 col-lg-5">
            <div class="mb-3">
              <label class="form-label h5">Tipo de personalización</label>
              <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-outline-secondary active">Serigrafía</button>
                <button type="button" class="btn btn-outline-secondary">DTF</button>
                <button type="button" class="btn btn-outline-secondary">Bordado</button>
                <button type="button" class="btn btn-outline-secondary">Marcado en cuero</button>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Color</label>
              <div class="spw-color-list">
                <button class="spw-color" style="--spw-color:#000"></button>
                <button class="spw-color" style="--spw-color:#fff"></button>
                <button class="spw-color" style="--spw-color:#1e63ff"></button>
                <button class="spw-color" style="--spw-color:#d23a3a"></button>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Posición rápida</label>
              <div class="d-grid gap-2" style="grid-template-columns:repeat(2,minmax(0,1fr))">
                <button type="button" class="btn btn-outline-secondary" data-spw-pos="left">Pecho izq.</button>
                <button type="button" class="btn btn-outline-secondary" data-spw-pos="right">Pecho dcha.</button>
                <button type="button" class="btn btn-outline-secondary" data-spw-pos="back">Espalda</button>
                <!-- booleanos en XML deben llevar valor -->
                <button type="button" class="btn btn-secondary" disabled="disabled">Libre</button>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Observaciones</label>
              <textarea class="form-control" rows="3"
                        placeholder="Tamaño, número de tintas y detalles (p.ej. pecho y espalda)"/>
            </div>

            <div class="mb-3">
              <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
              <input id="spw_logo_input" type="file" accept=".png,.jpg,.jpeg,.svg" class="form-control"/>
            </div>

            <div class="mb-3">
              <label class="form-label">Tamaño</label>
              <input id="spw_scale" type="range" min="10" max="200" value="100" class="form-range"/>
            </div>

            <div class="mb-3">
              <label class="form-label">Rotación</label>
              <input id="spw_rotate" type="range" min="-180" max="180" value="0" class="form-range"/>
            </div>

            <div class="mb-3">
              <label class="form-label">Posición X</label>
              <input id="spw_pos_x" type="range" min="0" max="100" value="50" class="form-range"/>
            </div>

            <div class="mb-4">
              <label class="form-label">Posición Y</label>
              <input id="spw_pos_y" type="range" min="0" max="100" value="50" class="form-range"/>
            </div>

            <div class="d-flex justify-content-between gap-2">
              <a t-att-href="'/shop/product/%s' % product.id" class="btn btn-light">Volver al producto</a>
              <button id="spw_add_to_cart" class="btn btn-primary">
                Añadir al carrito con esta personalización
              </button>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>