<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Página del customizer -->
  <template id="customizer_page" name="SPW Customizer Page">
    <t t-call="website.layout">
      <div class="container my-5">
        <!-- Lienzo con la foto de la variante y el overlay del logo -->
        <div id="spw_canvas" class="spw-stage">
          <img id="spw_product_img" class="spw-base img-fluid" t-att-src="img_src" alt="Producto"/>
          <!-- El logo se muestra aquí al elegir archivo -->
          <img id="spw_logo_preview" class="spw-logo-preview d-none" alt="Logo preview"/>
        </div>

        <!-- Controles (los mismos que ya usabas: tamaño / pos X / pos Y / rotación) -->
        <div class="row g-4 mt-4">
          <div class="col-12">
            <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
            <input id="spw_logo_input" class="form-control"
                   type="file" accept=".png,.jpg,.jpeg,.svg,.SVG,.PNG,.JPG,.JPEG"/>
            <small class="text-muted">Formatos: PNG/JPG/SVG. Máx. 10MB.</small>
          </div>

          <div class="col-12">
            <label class="form-label">Tamaño</label>
            <input id="spw_size" class="form-range" type="range" min="10" max="200" value="100"/>
          </div>

          <div class="col-12">
            <label class="form-label">Posición X</label>
            <input id="spw_pos_x" class="form-range" type="range" min="-50" max="50" value="0"/>
          </div>

          <div class="col-12">
            <label class="form-label">Posición Y</label>
            <input id="spw_pos_y" class="form-range" type="range" min="-50" max="50" value="10"/>
          </div>

          <div class="col-12">
            <label class="form-label">Rotación</label>
            <input id="spw_rotation" class="form-range" type="range" min="-45" max="45" value="0"/>
          </div>

          <div class="col-12">
            <a class="btn btn-outline-secondary" href="javascript:void(0)"
               onclick="window.spwReset && window.spwReset();">Reset</a>
            <a class="btn btn-link ms-3" t-attf-href="/shop/product/#{template.id}">&larr; Volver al producto</a>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>