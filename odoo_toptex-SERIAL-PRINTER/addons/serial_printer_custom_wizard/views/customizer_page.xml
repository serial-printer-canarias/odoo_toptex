<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Página de personalización -->
  <template id="customizer_page" name="SPW - Customizer Page">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <section class="container spw-preview my-4">

          <!-- Título -->
          <h1 class="mb-3" t-esc="page_title or 'Personalización'"/>

          <!-- Lienzo de previsualización
               La imagen base NO se muestra (CSS la oculta); el JS la usa para cargar el src
          -->
          <img id="spw_base_img" t-att-src="product_image_url" alt="Base"/>

          <canvas id="spw_canvas" class="spw-canvas" width="1200" height="1200">
            <!-- Fallback si el navegador no soporta canvas -->
            Tu navegador no soporta canvas.
          </canvas>

          <!-- Texto de ayuda -->
          <p class="mt-3">
            Arrastra el logo sobre la imagen para posicionarlo o usa los controles.
          </p>

          <!-- CONTROLES -->
          <div class="spw-controls">
            <!-- Archivo -->
            <div class="spw-field" style="grid-column: 1 / -1;">
              <label for="spw_file">Subir logo (PNG/JPG/SVG)</label>
              <div class="spw-file">
                <label for="spw_file">Seleccionar archivo</label>
                <input id="spw_file" type="file" accept="image/png,image/jpeg,image/svg+xml"/>
              </div>
            </div>

            <!-- Tamaño -->
            <div class="spw-field">
              <label for="spw_size">Tamaño</label>
              <input id="spw_size" type="range" min="5" max="300" step="1" value="25"/>
            </div>

            <!-- Rotación -->
            <div class="spw-field">
              <label for="spw_rotate">Rotación</label>
              <input id="spw_rotate" type="range" min="-180" max="180" step="1" value="0"/>
            </div>

            <!-- Posición X -->
            <div class="spw-field">
              <label for="spw_pos_x">Posición X</label>
              <input id="spw_pos_x" type="range" min="0" max="1200" step="1" value="0"/>
            </div>

            <!-- Posición Y -->
            <div class="spw-field">
              <label for="spw_pos_y">Posición Y</label>
              <input id="spw_pos_y" type="range" min="0" max="1200" step="1" value="0"/>
            </div>
          </div>

          <!-- ACCIONES -->
          <div class="spw-actions">
            <a t-att-href="return_to_product_url" class="btn btn-light">
              ← Volver al producto
            </a>
            <a t-att-href="add_to_cart_with_custom_url"
               id="spw_add_to_cart"
               class="btn btn-primary">
              Añadir al carrito con esta personalización
            </a>
          </div>

        </section>
      </div>
    </t>
  </template>
</odoo>