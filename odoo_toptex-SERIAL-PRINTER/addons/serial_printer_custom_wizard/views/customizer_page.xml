<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- SPW: Página de personalización -->
    <template id="spw_customize_page" name="SPW: Página de personalización">
        <t t-call="website.layout">
            <div class="container spw-container my-4">

                <!-- Variante: por defecto la del producto; si llega ?variant_id usarla -->
                <t t-set="variant" t-value="product and product.product_variant_id or False"/>
                <t t-if="request.params.get('variant_id')">
                    <t t-set="variant"
                       t-value="request.env['product.product'].browse(int(request.params.get('variant_id')))"/>
                </t>

                <div class="row">
                    <!-- Lienzo -->
                    <div class="col-12 col-lg-7">
                        <div class="spw-canvas-wrapper position-relative">
                            <img id="spw_base_img" class="img-fluid w-100"
                                 t-att-src="'/web/image/product.product/%s/image_1024' % (variant.id if variant else 0)"/>
                            <img id="spw_logo" class="position-absolute d-none" alt="Logo"/>
                        </div>
                        <p class="mt-3">Arrastra el logo sobre la imagen para posicionarlo o usa los controles.</p>
                    </div>

                    <!-- Controles -->
                    <div class="col-12 col-lg-5">
                        <div class="o_we_form">

                            <div class="mb-3">
                                <label class="form-label">Subir logo (PNG/JPG/SVG)</label>
                                <input id="spw_file" type="file" accept=".png,.jpg,.jpeg,.svg" class="form-control"/>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Tamaño</label>
                                    <input id="spw_scale" type="range" min="0.2" max="2" step="0.01" value="1" class="form-range"/>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Rotación</label>
                                    <input id="spw_rotate" type="range" min="-180" max="180" step="1" value="0" class="form-range"/>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Posición X</label>
                                    <input id="spw_pos_x" type="range" min="0" max="100" step="1" value="50" class="form-range"/>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Posición Y</label>
                                    <input id="spw_pos_y" type="range" min="0" max="100" step="1" value="50" class="form-range"/>
                                </div>
                            </div>

                            <!-- Acciones -->
                            <div class="d-flex justify-content-between mt-3">
                                <a t-att-href="product and product.website_url or '/shop'"
                                   class="btn btn-light">← Volver al producto</a>
                                <button id="spw_add_to_cart" class="btn btn-primary">
                                    Añadir al carrito con esta personalización
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>