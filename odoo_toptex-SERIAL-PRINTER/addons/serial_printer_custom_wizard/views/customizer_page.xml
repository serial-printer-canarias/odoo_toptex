<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="spw_customize_page" name="SPW - Customizer Page">
    <t t-call="website.layout">
      <t t-set="pageName" t-value="'spw_customize_page'"/>

      <main id="wrap" class="container py-4 spw-customizer">
        <div class="row g-4">
          <!-- Vista previa -->
          <div class="col-12 col-lg-7">
            <div class="card p-3 spw-canvas">
              <img id="spw_product_img"
                   class="img-fluid rounded"
                   t-att-src="variant_id and ('/web/image/product.product/%s/image_1024' % variant_id) or ('/web/image/product.template/%s/image_1024' % product_template.id)"
                   alt="Producto"/>
              <img id="spw_logo_img" class="spw-logo d-none" alt="Logo"/>
            </div>
          </div>

          <!-- Controles -->
          <div class="col-12 col-lg-5">
            <div class="card p-3">
              <h3 class="h5 mb-3">Subir logo (PNG/JPG/SVG)</h3>
              <input type="file" id="spw_logo_input" accept=".png,.jpg,.jpeg,.svg"/>

              <div class="mt-3">
                <label class="form-label">Tamaño</label>
                <input type="range" id="spw_size" min="10" max="200" value="100"/>
              </div>
              <div class="mt-3">
                <label class="form-label">Rotación</label>
                <input type="range" id="spw_rotate" min="-180" max="180" value="0"/>
              </div>
              <div class="mt-3">
                <label class="form-label">Posición X</label>
                <input type="range" id="spw_pos_x" min="-200" max="200" value="0"/>
              </div>
              <div class="mt-3">
                <label class="form-label">Posición Y</label>
                <input type="range" id="spw_pos_y" min="-200" max="200" value="0"/>
              </div>

              <div class="d-flex gap-2 mt-4">
                <a t-att-href="'/shop/product/%s' % product_template.id" class="btn btn-light w-50">← Volver</a>
                <a href="#" class="btn btn-primary w-50 disabled" id="spw_add_to_cart">Añadir al carrito con esta personalización</a>
              </div>
            </div>
          </div>
        </div>
      </main>
    </t>
  </template>
</odoo>