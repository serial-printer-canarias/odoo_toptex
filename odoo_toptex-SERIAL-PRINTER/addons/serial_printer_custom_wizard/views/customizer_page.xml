<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="spw_customize_page" name="SPW - Customizer Page">
    <t t-call="website.layout">
      <!-- Requerido por Website para no romper editor -->
      <t t-set="pageName" t-value="'spw_customize_page'"/>
      <t t-set="main_object" t-value="product"/>

      <main id="wrap" class="oe_structure spw-customizer">
        <div class="container py-4">
          <t t-if="product">
            <div class="row g-4">
              <!-- Lienzo -->
              <div class="col-12 col-lg-7">
                <div id="spw_canvas" class="spw-canvas card p-3">
                  <!-- Imagen del producto (si viene variante, ya la usaremos en el paso 2) -->
                  <t t-if="product_variant">
                    <img id="spw_product_img" class="img-fluid rounded"
                         t-att-src="'/web/image/product.product/%s/image_1024' % product_variant.id"
                         alt="Product"/>
                  </t>
                  <t t-else="">
                    <img id="spw_product_img" class="img-fluid rounded"
                         t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                         alt="Product"/>
                  </t>
                  <!-- PREVIEW del logo -->
                  <img id="spw_logo_preview" class="spw-logo-preview d-none" alt="Logo preview"/>
                </div>
              </div>

              <!-- Controles mínimos para el logo -->
              <div class="col-12 col-lg-5">
                <div class="card p-3">
                  <h5 class="mb-3">Subir logo (PNG/JPG/SVG)</h5>
                  <input id="spw_logo_input" type="file"
                         accept="image/png,image/jpeg,image/svg+xml"
                         class="form-control mb-3"/>

                  <div class="mb-3">
                    <label class="form-label">Tamaño</label>
                    <input id="spw_scale" type="range" min="10" max="300" step="1" value="100"
                           class="form-range"/>
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Rotación</label>
                    <input id="spw_rotate" type="range" min="-180" max="180" step="1" value="0"
                           class="form-range"/>
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Posición X</label>
                    <input id="spw_pos_x" type="range" min="0" max="100" step="1" value="50"
                           class="form-range"/>
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Posición Y</label>
                    <input id="spw_pos_y" type="range" min="0" max="100" step="1" value="50"
                           class="form-range"/>
                  </div>
                </div>
              </div>
            </div>
          </t>
          <t t-else="">
            <div class="alert alert-danger">Producto no encontrado.</div>
          </t>
        </div>
      </main>
    </t>
  </template>
</odoo>