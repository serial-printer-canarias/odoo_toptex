<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Solo nuestro CSS + JS plano -->
  <template id="spw_assets_public_min" inherit_id="web.assets_frontend" name="SPW Assets (solo público)">
    <xpath expr="." position="inside">
      <link rel="stylesheet" href="/serial_printer_custom_wizard/static/src/css/spw.css"/>
      <script type="text/javascript" src="/serial_printer_custom_wizard/static/src/js/spw_public.js" defer="defer"/>
    </xpath>
  </template>

  <!-- Limpieza silenciosa de referencias viejas de ESTE módulo -->
  <template id="spw_assets_cleanup" inherit_id="web.assets_frontend" name="SPW Assets Cleanup">
    <xpath expr="//script[contains(@src,'/serial_printer_custom_wizard/static/src/js/spw_options.js')]" position="replace"/>
    <xpath expr="//script[contains(@src,'/serial_printer_custom_wizard/static/src/js/ns300_colors.js')]" position="replace"/>
    <xpath expr="//script[contains(@src,'/serial_printer_custom_wizard/static/src/js/spw.js')]" position="replace"/>
    <xpath expr="//script[contains(@src,'/serial_printer_custom_wizard/static/src/js/spw_cart.js')]" position="replace"/>
    <xpath expr="//script[contains(@src,'/serial_printer_custom_wizard/static/src/js/spw_button.js')]" position="replace"/>
    <xpath expr="//script[contains(@src,'/serial_printer_custom_wizard/static/src/js/customizer')]" position="replace"/>
  </template>
</odoo>