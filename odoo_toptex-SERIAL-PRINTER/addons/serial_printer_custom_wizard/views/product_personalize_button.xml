<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Inserta el botón en la ficha del producto (debajo de acciones) -->
  <template id="spw_personalize_button" name="SPW: Botón Personalizar (Product Page)"
            inherit_id="website_sale.product">
    <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' o_wsale_product_actions ')]"
           position="inside">
      <!-- href se queda en #, la navegación la hace JS para construir bien la URL -->
      <a id="spw_personalize_btn" href="#"
         class="btn btn-primary mt-3" role="button">
        <i class="fa fa-magic me-1"/>
        <span>Personalizar</span>
      </a>
    </xpath>
  </template>
</odoo>