<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Inserta el botón en la zona de acciones de la ficha de producto -->
  <template id="spw_personalize_button"
            name="SPW: Botón Personalizar (Product Page)"
            inherit_id="website_sale.product">

    <!-- Contenedor de acciones (Add to cart, wishlist, etc.) -->
    <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' o_wsale_product_actions ')]"
           position="inside">
      <a id="spw_personalize_btn"
         href="#"
         class="btn btn-outline-primary ms-2"
         role="button"
         data-spw="personalize"
         t-att-data-product_tmpl_id="product.id"
         t-att-data-variant_id="product.product_variant_id and product.product_variant_id.id or 0">
        <i class="fa fa-magic me-1"/>
        <span>Personalizar</span>
      </a>
    </xpath>

  </template>
</odoo>