<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <template id="product_personalize_button"
              inherit_id="website_sale.product"
              name="SPW: Personalize Button">

      <!-- Odoo 19: js_add_cart_variants ya no cuelga del <form>; está en un <ul> -->
      <xpath expr="//ul[contains(concat(' ', normalize-space(@class), ' '), ' js_add_cart_variants ')]"
             position="after">

        <div class="mt-2">
          <button type="button"
                  class="btn btn-primary w-100"
                  id="spw_customize_btn"
                  t-att-data-ptmpl-id="product.id">
            <span class="fa fa-magic me-1"/><span>Personalizar</span>
          </button>
        </div>

      </xpath>
    </template>
  </data>
</odoo>

