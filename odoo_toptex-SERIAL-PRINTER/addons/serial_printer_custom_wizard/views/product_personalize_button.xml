<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Inserta el botón en la ficha de producto (vista website_sale) -->
  <template id="spw_personalize_button" inherit_id="website_sale.product_buy" name="SPW: Botón Personalizar (Product Page)">
    <!-- Dentro del <form> que tiene el input hidden product_id (la variante seleccionada) -->
    <xpath expr="//form[.//input[@name='product_id']]" position="inside">
      <div class="mt-3">
        <!-- data-product-template-id = ID de product.template; la variante se lee del input name=product_id -->
        <a id="spw_personalize_btn"
           class="btn btn-primary w-100"
           t-att-data-product-template-id="product.id"
           href="javascript:void(0)">
          <i class="fa fa-magic me-1"/>
          <span>Personalizar</span>
        </a>
      </div>
    </xpath>
  </template>
</odoo>