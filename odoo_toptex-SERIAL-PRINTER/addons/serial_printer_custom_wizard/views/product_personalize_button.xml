<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- SPW: Botón Personalizar en la PDP (después de Add to cart) -->
  <template id="spw_personalize_button"
            name="SPW: Botón Personalizar"
            inherit_id="website_sale.product"
            priority="60">

    <xpath expr="//button[contains(concat(' ', normalize-space(@class), ' '), ' o_add_to_cart ')]"
           position="after">
      <a id="spw_personalize_btn"
         t-att-href="'/personalizar/%s' % product.id"
         class="btn btn-outline-primary ms-2 mt-2 mt-lg-0">
        <i class="fa fa-magic me-1"/>
        <t t-esc="_('Personalizar')"/>
      </a>
    </xpath>

  </template>
</odoo>