<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Botón "Personalizar" en la página de producto (anclaje seguro) -->
  <template id="spw_personalize_button"
            name="SPW: Botón Personalizar (Product Page)"
            inherit_id="website_sale.product">

    <!-- Insertamos un slot SIEMPRE presente para no romper la vista -->
    <xpath expr="//div[@id='wrap']" position="inside">
      <div id="spw_personalize_slot"
           class="d-none"
           t-att-data-ptmpl="product and product.product_tmpl_id.id or (product_template and product_template.id)">
        <a id="spw_personalize_btn"
           class="btn btn-primary"
           href="#"
           role="button"
           data-spw="personalize">
          <i class="fa fa-magic me-1"/>
          <span>Personalizar</span>
        </a>
      </div>
    </xpath>
  </template>
</odoo>