<odoo>
  <template id="product_personalize_button" inherit_id="website_sale.product" name="SPW: Personalize Button">
    <xpath expr="//div[contains(@class,'o_wsale_product_btn') or contains(@class,'o_wsale_product_btn_section')]" position="inside">
      <button type="button"
              class="btn btn-primary w-100 mt-2"
              id="spw_customize_btn"
              t-att-data-ptmpl-id="product.id">
        <span class="fa fa-magic me-1"/>
        <span>Personalizar</span>
      </button>
    </xpath>
  </template>
</odoo>