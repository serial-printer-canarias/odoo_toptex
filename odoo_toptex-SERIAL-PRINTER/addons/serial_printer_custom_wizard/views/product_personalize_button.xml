<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Botón dentro del <form> que tiene el input[name='product_id'] -->
  <template id="spw_personalize_button" inherit_id="website_sale.product_buy">
    <xpath expr="//form[.//input[@name='product_id']]" position="inside">
      <div class="mt-3">
        <a id="spw_personalize_btn"
           class="btn btn-primary w-100"
           t-att-data-product-id="product.id"
           t-att-data-product-template-id="product.product_tmpl_id.id"
           href="#">
          <i class="fa fa-magic me-1"/>
          <span>Personalizar</span>
        </a>
      </div>
    </xpath>
  </template>
</odoo>