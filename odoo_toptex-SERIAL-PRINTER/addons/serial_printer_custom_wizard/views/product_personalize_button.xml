<odoo>
  <!-- Botón "Personalizar" insertado SIN depender de clases del tema -->
  <template id="spw_personalize_button" name="SPW: Botón Personalizar"
            inherit_id="website_sale.product_buy">

    <!-- Selecciona el formulario del producto por el input product_id (siempre existe) -->
    <xpath expr="//form[.//input[@name='product_id']]" position="inside">
      <a id="spw_personalize_btn"
         href="#"
         class="btn btn-outline-primary ms-2 mt-2"
         data-spw="personalize">
        <i class="fa fa-magic me-1"/>
        <span>Personalizar</span>
      </a>
    </xpath>

  </template>
</odoo>