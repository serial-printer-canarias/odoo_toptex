<odoo>
  <!-- NO cambies el inherit_id: seguimos heredando la vista estándar -->
  <template id="product_personalize_button" inherit_id="website_sale.product" name="SPW: Personalize Button">
    <!-- Inserta el botón dentro del formulario de compra -->
    <xpath expr="//form[@id='add_to_cart']" position="inside">
      <div class="mt-2">
        <button type="button"
                class="btn btn-primary w-100"
                id="spw_customize_btn"
                t-att-data-ptmpl-id="product.id">
          <span class="fa fa-magic me-1"/>
          <span>Personalizar</span>
        </button>
      </div>
    </xpath>
  </template>
</odoo>