<!-- serial_printer_custom_wizard/views/product_personalize_button.xml -->
<odoo>
  <template id="spw_personalize_button" inherit_id="website_sale.product" name="SPW: Botón Personalizar">
    <!-- Inserta bajo el formulario que tiene el hidden product_id (existe siempre) -->
    <xpath expr="//form[.//input[@name='product_id']]" position="inside">
      <div class="mt-3">
        <a id="spw_personalize_btn"
           t-att-data-product-id="product.id"
           class="btn btn-primary w-100"
           href="#">
          <i class="fa fa-magic me-1"/>
          <span>Personalizar</span>
        </a>
      </div>
    </xpath>
  </template>
</odoo>