<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Odoo 18: en la plantilla del producto -->
  <template id="spw_button_on_product" inherit_id="website_sale.product" name="SPW: Botón Personalizar (Product Page)">
    <xpath expr="//form[.//input[@name='product_id']]" position="inside">
      <div class="mt-3">
        <a id="spw_personalize_btn" class="btn btn-primary w-100" href="javascript:void(0)">
          <i class="fa fa-magic me-1"/>
          <span>Personalizar</span>
        </a>
      </div>
    </xpath>
  </template>
</odoo>