<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="spw_personalize_button" inherit_id="website_sale.product_buy" name="SPW: Botón Personalizar">
    <!-- Inserta el botón dentro del bloque de acciones de la ficha -->
    <xpath expr="//div[contains(@class,'o_wsale_product_actions')]" position="inside">
      <a id="spw_personalize_btn"
         href="#"
         class="btn btn-outline-primary ms-2"
         role="button"
         data-spw="personalize">
        <i class="fa fa-magic me-1"/>
        <span>Personalizar</span>
      </a>
    </xpath>
  </template>
</odoo>