<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- SPW: Botón "Personalizar" en la página de producto -->
  <template id="spw_product_button" inherit_id="website_sale.product" name="SPW: Personalizar (Product)">
    <!-- Dentro del <form> que contiene el input hidden name="product_id" -->
    <xpath expr="//form[.//input[@name='product_id']]" position="inside">
      <button id="spw_personalize_btn"
              type="button"
              class="btn btn-primary w-100 mt-3"
              t-att-data-product-template-id="product.product_tmpl_id.id if product else (product_template and product_template.id or 0)"
              t-att-data-variant-id="product.id if product else 0">
        <i class="fa fa-magic me-1"/><span>Personalizar</span>
      </button>
    </xpath>
  </template>
</odoo>