<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Botón "Personalizar" en la ficha de producto -->
  <template id="spw_personalize_button"
            name="SPW: Botón Personalizar (Product Page)"
            inherit_id="website_sale.product">

    <!-- Inserta dentro de un contenedor estable -->
    <xpath expr="//div[@id='product_details']" position="inside">
      <div id="spw_personalize_btn_wrapper" class="mt-3">
        <a id="spw_personalize_btn"
           class="btn btn-outline-primary"
           role="button"
           data-spw="personalize"
           t-att-data-product_tmpl_id="product.id"
           t-att-data-variant_id="product.product_variant_id and product.product_variant_id.id or 0"
           t-att-href="'/spw/customize/%s?variant_id=%s' % (product.id, (product.product_variant_id.id if product.product_variant_id else 0))">
          <i class="fa fa-magic me-1"/>
          <span>Personalizar</span>
        </a>
      </div>
    </xpath>

  </template>
</odoo>