<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- SPW: Botón Personalizar en la ficha de producto (Odoo 18) -->
  <template id="spw_personalize_button"
            name="SPW: Botón Personalizar (Product Page)"
            inherit_id="website_sale.product">

    <!-- Inserta el botón dentro del <form> que siempre contiene el input hidden name="product_id" -->
    <xpath expr="//form[.//input[@name='product_id']]" position="inside">
      <div class="mt-3">
        <a id="spw_personalize_btn"
           class="btn btn-primary w-100"
           t-att-data-product-template-id="product.id"
           href="javascript:void(0)">
          <i class="fa fa-magic me-1"/>
          <span>Personalizar</span>
        </a>
      </div>
    </xpath>
  </template>
</odoo>