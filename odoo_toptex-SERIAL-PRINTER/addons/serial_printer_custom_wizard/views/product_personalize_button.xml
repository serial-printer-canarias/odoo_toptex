<?xml version="1.0" encoding="UTF-8"?>
<!-- serial_printer_custom_wizard/views/product_personalize_button.xml -->
<odoo>
  <data>
    <!-- Insertamos el botón dentro del <form> que siempre contiene el input hidden product_id -->
    <template id="spw_personalize_button" name="SPW: Botón Personalizar (Product Page)"
              inherit_id="website_sale.product">
      <xpath expr="//form[.//input[@name='product_id']]" position="inside">
        <div class="mt-3">
          <a id="spw_personalize_btn"
             class="btn btn-primary w-100"
             t-att-data-tmpl-id="product.product_tmpl_id.id"
             href="#">
            <i class="fa fa-magic me-1"/>
            <span>Personalizar</span>
          </a>
        </div>
      </xpath>
    </template>
  </data>
</odoo>