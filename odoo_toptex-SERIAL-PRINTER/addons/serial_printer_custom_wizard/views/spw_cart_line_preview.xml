<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Parche defensivo: evita ParseError si cambia el DOM del carrito.
         No modifica nada visual (no-op), solo asegura que el xpath siempre
         encuentra algo dentro del bucle de líneas del carrito. -->
    <template id="spw_cart_line_preview_safe"
              name="SPW Cart line: preview + color (fieldless)"
              inherit_id="website_sale.cart_lines"
              priority="60">

        <!-- Ancla robusta: el bucle de líneas del carrito en varias versiones -->
        <xpath expr="//t[@t-as='line' and
                        (@t-foreach='website_sale_order.order_line'
                         or @t-foreach='order.order_line'
                         or contains(@t-foreach,'order_line'))]"
               position="inside">
            <!-- no-op para que la herencia sea válida -->
            <t t-set="__spw_placeholder">1</t>
        </xpath>
    </template>
</odoo>