<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista “no-op” ultra segura: hereda directamente cart_lines y ancla al root -->
    <template id="spw_cart_line_preview_safe"
              name="SPW Cart line: preview + color (fieldless)"
              inherit_id="website_sale.cart_lines"
              priority="60">
        <!-- El selector '.' es el root del template heredado: siempre existe -->
        <xpath expr="." position="inside">
            <t t-set="__spw_placeholder">1</t>
        </xpath>
    </template>
</odoo>