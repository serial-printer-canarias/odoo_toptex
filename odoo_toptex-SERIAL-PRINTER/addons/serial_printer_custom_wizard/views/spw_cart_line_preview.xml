<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Parche seguro: evita ParseError en update sin modificar el front -->
    <template id="spw_cart_line_preview_safe"
              name="SPW Cart line: preview + color (fieldless)"
              inherit_id="website_sale.cart"
              priority="60">
        <!-- Ancla robusta y estable en todas las plantillas del carrito -->
        <xpath expr="//div[@id='wsale_cart']" position="inside">
            <!-- no-op; solo para que la herencia sea válida y el update no falle -->
            <t t-set="__spw_placeholder">1</t>
        </xpath>
    </template>
</odoo>