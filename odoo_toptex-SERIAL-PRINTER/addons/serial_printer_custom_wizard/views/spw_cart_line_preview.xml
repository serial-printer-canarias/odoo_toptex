<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- (1) Vista “no-op” para que los updates nunca fallen -->
    <template id="spw_cart_line_preview_safe"
              name="SPW Cart lines safe anchor"
              inherit_id="website_sale.cart_lines"
              priority="60">
        <xpath expr="." position="inside">
            <t t-set="__spw_ok">1</t>
        </xpath>
    </template>

    <!-- (2) Inyección visual en cada línea del carrito -->
    <template id="spw_cart_item_preview"
              name="SPW Cart item: preview + color"
              inherit_id="website_sale.cart_item"
              priority="70">

        <!-- Dentro del bloque de información del producto (clase estable) -->
        <xpath expr="//div[contains(@class,'o_cart_product_info') or contains(@class,'o_wsale_product_information')]"
               position="inside">

            <!-- Solo si los campos existen en sale.order.line -->
            <t t-if="'spw_png_attachment_id' in line._fields or 'spw_svg_color' in line._fields">

                <div class="spw-cart-custom d-flex align-items-center gap-2 mt-2">

                    <!-- Miniatura PNG de la personalización -->
                    <img t-if="'spw_png_attachment_id' in line._fields and line.spw_png_attachment_id"
                         t-att-src="'/web/image/%s' % (line.spw_png_attachment_id.id)"
                         alt="Personalización"
                         style="width:64px;height:64px;object-fit:contain;border:1px solid #e8e8e8;border-radius:6px;" />

                    <!-- Píldora de color -->
                    <t t-if="'spw_svg_color' in line._fields and line.spw_svg_color">
                        <span t-att-title="line.spw_svg_color"
                              style="display:inline-block;width:18px;height:18px;border-radius:9999px;border:1px solid rgba(0,0,0,.15);"
                              t-att-style="'background:%s;'" t-attf-style="background:{{ line.spw_svg_color }};"></span>
                    </t>

                </div>
            </t>
        </xpath>
    </template>

</odoo>