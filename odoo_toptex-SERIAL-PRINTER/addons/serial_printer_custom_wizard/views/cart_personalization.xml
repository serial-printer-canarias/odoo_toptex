<odoo>
  <template id="cart_line_personalization" inherit_id="website_sale.cart_line">
    <xpath expr=".//div[contains(@class,'td-product_name')]" position="inside">
      <t t-if="line.x_personalization_png">
        <div class="mt-2">
          <img t-att-src="'data:image/png;base64,%s' % line.x_personalization_png"
               style="max-width:180px; border:1px solid #eee;"/>
        </div>
      </t>
    </xpath>
  </template>
</odoo>