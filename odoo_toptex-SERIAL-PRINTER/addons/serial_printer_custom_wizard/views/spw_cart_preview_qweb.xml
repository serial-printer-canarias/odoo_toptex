<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <template id="spw_cart_line_preview_block" name="SPW Cart line preview block">
      <t t-if="line and line.id">
        <div class="spw-preview" style="display:flex;align-items:center;gap:8px;margin-top:6px">
          <t t-if="getattr(line, 'spw_svg_color', False)">
            <span t-att-title="line.spw_svg_color"
                  style="display:inline-block;width:16px;height:16px;border-radius:999px;border:1px solid #e5e7eb"
                  t-att-style="'background:%s' % line.spw_svg_color"/>
          </t>
          <img t-att-src="'/spw/line_preview/%s.png' % line.id"
               alt="Personalización" loading="lazy"
               style="max-width:120px;height:auto;border:1px solid #e5e7eb;border-radius:6px"/>
        </div>
      </t>
    </template>

    <!-- Insertar dentro del contenedor de info del producto -->
    <template id="spw_cart_lines_inherit" inherit_id="website_sale.cart_lines" priority="99">
      <xpath expr=".//div[contains(@class,'o_wsale_product_information')]" position="inside">
        <t t-set="line" t-value="line"/>
        <t t-call="serial_printer_custom_wizard.spw_cart_line_preview_block"/>
      </xpath>
    </template>

  </data>
</odoo>