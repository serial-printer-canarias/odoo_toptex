<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Serial Printer: vista de producto personalizada tipo TopTex -->
  <template id="serial_printer_product_stock"
            inherit_id="website_sale.product"
            name="Serial Printer Product View">

    <!-- ✅ Descripción del producto (editable desde Website) -->
    <xpath expr="//div[@id='product_details']" position="inside">
      <t t-if="product.website_description">
        <div class="oe_structure mt-4">
          <t t-raw="product.website_description"/>
        </div>
      </t>
    </xpath>

    <!-- ✅ BLOQUE ÚNICO: stock rápido + swatches + matriz color×talla -->
    <xpath expr="//div[@id='product_details']" position="after">

      <!-- Stock rápido de la variante principal -->
      <div class="mt-3">
        <t t-if="product.product_variant.qty_available &gt; 0">
          <p class="text-success">
            ✅ Stock disponible: <t t-esc="product.product_variant.qty_available"/> uds
          </p>
        </t>
        <t t-else="">
          <p class="text-danger">❌ Sin stock</p>
        </t>
      </div>

      <!-- Swatches de color (html_color); no dependemos de js_add_cart_variants -->
      <t t-set="color_attribute"
         t-value="product.attribute_line_ids.filtered(lambda l: l.attribute_id.name.lower() in ['color','colour','couleur','farbe','colore'])"/>
      <t t-if="color_attribute">
        <div class="d-flex flex-wrap my-2">
          <t t-foreach="color_attribute.value_ids" t-as="color">
            <label class="mx-1" t-att-title="color.name">
              <input type="radio" name="sp_color_sw" t-att-value="color.id"/>
              <span t-att-style="'display:inline-block;width:24px;height:24px;border-radius:50%%;background-color:%s;border:1px solid #000' % (color.html_color or '#ccc')"></span>
            </label>
          </t>
        </div>
      </t>

      <!-- MATRIZ estilo TopTex: Color → Tallas con stock/precio/qty -->
      <t t-set="grouped_variants" t-value="dict()"/>
      <t t-foreach="product.product_variant_ids" t-as="variant">
        <!-- Detectar atributos Color / Talla (multilenguaje) -->
        <t t-set="color_vals"
           t-value="variant.attribute_value_ids.filtered(
             lambda a: a.attribute_id.name.lower() in ['color','colour','couleur','farbe','colore']
           )"/>
        <t t-set="size_vals"
           t-value="variant.attribute_value_ids.filtered(
             lambda a: a.attribute_id.name.lower() in ['talla','size','taille','größe','groesse','taglia']
           )"/>

        <t t-if="color_vals and size_vals">
          <t t-set="color_name"  t-value="color_vals[0].name"/>
          <t t-set="html_color"  t-value="color_vals[0].html_color or '#ccc'"/>
          <t t-set="talla_name"  t-value="size_vals[0].name"/>
          <t t-set="line"
             t-value="{
               'id': variant.id,
               'sku': variant.default_code,
               'talla': talla_name,
               'stock': variant.qty_available,
               'price': (variant.website_price or variant.list_price),
               'html_color': html_color
             }"/>
          <t t-set="__void" t-value="grouped_variants.setdefault(color_name, [])"/>
          <t t-set="__void" t-value="grouped_variants[color_name].append(line)"/>
        </t>
      </t>

      <t t-if="grouped_variants">
        <t t-foreach="grouped_variants.items()" t-as="pair">
          <t t-set="color_name" t-value="pair[0]"/>
          <t t-set="rows"       t-value="pair[1]"/>

          <div class="border rounded p-3 mb-4">
            <h5 class="mb-3 d-flex align-items-center">
              <span t-att-style="'display:inline-block;width:20px;height:20px;border-radius:50%%;background-color:%s;border:1px solid #000;margin-right:8px;' % (((rows and rows[0]['html_color']) or '#ccc'))"></span>
              <t t-esc="color_name"/>
            </h5>

            <div class="table-responsive">
              <table class="table table-sm table-bordered text-center align-middle mb-2">
                <thead class="table-light">
                  <tr>
                    <th style="min-width:72px;">Talla</th>
                    <th>Stock</th>
                    <th>Precio</th>
                    <th style="width:120px;">Cantidad</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="rows" t-as="r">
                    <tr>
                      <td><t t-esc="r['talla']"/></td>
                      <td><t t-esc="r['stock']"/> uds</td>
                      <td><t t-esc="r['price']"/> €</td>
                      <td>
                        <input type="number"
                               class="form-control form-control-sm qty-input"
                               t-att-name="'qty_%s' % r['id']"
                               t-att-data-variant-id="r['id']"
                               t-att-data-sku="r['sku']"
                               min="0" value="0"/>
                      </td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>

            <button type="button"
                    class="btn btn-primary add-to-cart-btn"
                    t-att-data-color="color_name">
              Añadir al carrito (color <t t-esc="color_name"/>)
            </button>
          </div>
        </t>
      </t>

      <t t-else="">
        <p class="alert alert-warning mt-3">
          No hay variantes configuradas para mostrar la matriz de tallas.
        </p>
      </t>

    </xpath>
    <!-- /BLOQUE ÚNICO -->

  </template>
</odoo>