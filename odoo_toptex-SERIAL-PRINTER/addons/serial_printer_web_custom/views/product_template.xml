<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Heredamos SIEMPRE la plantilla base del producto -->
  <template id="serial_printer_product_view"
            name="Serial Printer Product View"
            inherit_id="website_sale.product">

    <!--
      Anclaje robusto: el DIV "oe_structure" propio de la página de producto.
      Existe incluso con temas/ediciones de Website Builder.
    -->
    <xpath expr="//div[@id='oe_structure_website_sale_product']" position="before">
      <div class="alert alert-info my-3" role="alert">
        Matriz Serial Printer: <strong>activa</strong>
      </div>
    </xpath>

    <!--
      Ejemplo opcional: caja al final de la página de producto
      (si quieres probar que el heredado funciona en dos puntos distintos)
    -->
    <xpath expr="//div[@id='oe_structure_website_sale_product']" position="after">
      <div class="o-spwc-box mt-4 p-3 border rounded">
        <t t-esc="'Bloque insertado por serial_printer_web_custom'"/>
      </div>
    </xpath>

  </template>
</odoo>