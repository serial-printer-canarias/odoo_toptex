odoo.define('serial_printer_web_custom.product_matrix', function (require) {
    'use strict';

    const publicWidget = require('web.public.widget');
    const ajax = require('web.ajax');

    publicWidget.registry.SerialPrinterMatrix = publicWidget.Widget.extend({
        selector: '.o_wsale_product_page',
        events: {
            'click .sp-add-to-cart': '_onAddAllToCart',
        },

        start() {
            // Construir una vez por página
            if (!this.el.querySelector('#sp-matrix')) {
                this._buildIfPossible();
            }
            return this._super.apply(this, arguments);
        },

        // -------- Utils: detectar bloques de atributos --------
        _getAttributeBlocks() {
            const blocks = [];
            // listas con data-attribute_name (marcado estándar website_sale)
            this.$('.js_product .js_attributes [data-attribute_name]').each(function () {
                const $b = $(this);
                const name = ($b.attr('data-attribute_name') || '').trim();
                const options = $b.find('input[type="radio"]').map(function () {
                    const $inp = $(this);
                    const id = parseInt($inp.data('value_id') || $inp.data('attribute_value_id') || $inp.val(), 10);
                    const label = ($inp.closest('label').text() || $inp.attr('title') || '').trim();
                    return { id, name: label, $inp };
                }).get();
                if (options.length) {
                    blocks.push({ name, options, $el: $b });
                }
            });
            return blocks;
        },

        _pickColorAndSize(blocks) {
            const isColor = n => /color|couleur|farbe|colou?r|colore|kleur/i.test(n || '');
            const isSize  = n => /size|talla|taille|größe|grosse|taglia|maat/i.test(n || '');
            let color = blocks.find(b => isColor(b.name));
            let size  = blocks.find(b => isSize(b.name));
            if (!color && blocks.length) color = blocks[0];
            if (!size  && blocks.length > 1) size  = blocks[1];
            return { color, size };
        },

        // -------- Build tabla matriz --------
        async _buildIfPossible() {
            const blocks = this._getAttributeBlocks();
            if (blocks.length < 2) return;
            const { color, size } = this._pickColorAndSize(blocks);
            if (!color || !size) return;

            const $matrix = $('<div id="sp-matrix" class="sp-matrix o-pt-3"></div>');
            // Inserta la matriz debajo del precio (ajusta si quieres otro sitio)
            const $anchor = this.$('.product_price').first();
            ($anchor.length ? $anchor : this.$el).after($matrix);

            const $table = $('<table class="sp-matrix__table"></table>');
            const $thead = $('<thead><tr><th class="sp-sticky-left">Color</th></tr></thead>');
            size.options.forEach(o => $thead.find('tr').append(`<th>${_.escape(o.name || '')}</th>`));
            const $tbody = $('<tbody></tbody>');

            color.options.forEach(c => {
                const $tr = $(`
                    <tr data-color-id="${c.id}">
                      <th class="sp-sticky-left">
                        <div class="sp-color">
                          <img class="sp-color__img" alt="">
                          <span class="sp-color__name">${_.escape(c.name)}</span>
                        </div>
                      </th>
                    </tr>`);

                size.options.forEach(s => {
                    const $td = $(`
                      <td data-size-id="${s.id}">
                        <div class="sp-cell">
                          <input type="number" min="0" step="1" class="sp-qty"
                                 data-color-id="${c.id}" data-size-id="${s.id}">
                          <div class="sp-meta">
                            <span class="sp-price"></span>
                            <span class="sp-stock"></span>
                          </div>
                        </div>
                      </td>`);
                    $tr.append($td);
                });
                $tbody.append($tr);
            });

            $table.append($thead, $tbody);
            $matrix.append($table);
            $matrix.append('<button type="button" class="btn btn-primary mt-2 sp-add-to-cart">Añadir selección</button>');

            // Hidratar celdas con variant_id, precio y stock
            this._hydrateCells();
        },

        // -------- Obtener datos de combinación --------
        _comboArgs(avIds) {
            const tmplId = parseInt(
                this.$('[data-product-template-id]').data('product-template-id') ||
                this.$('input[name="product_id"]').val() || 0, 10);

            const pricelistId = parseInt(
                this.$('[data-pricelist-id]').data('pricelist-id') || 0, 10);

            return {
                product_template_id: tmplId || undefined,
                product_id: 0,
                combination: avIds,
                add_qty: 1,
                parent_combination: [],
                pricelist_id: pricelistId || undefined,
            };
        },

        async _fetchCombination(avIds) {
            const args = this._comboArgs(avIds);
            try {
                return await ajax.jsonRpc('/shop/get_combination_info', 'call', args);
            } catch (_) {
                try {
                    return await ajax.jsonRpc('/sale/get_combination_info', 'call', args);
                } catch (__) {
                    return null;
                }
            }
        },

        async _getStock(variantId) {
            try {
                const res = await ajax.jsonRpc('/web/dataset/call_kw', 'call', {
                    model: 'product.product',
                    method: 'read',
                    args: [[variantId], ['qty_available']],
                    kwargs: {},
                });
                return (res && res[0] && typeof res[0].qty_available === 'number') ? res[0].qty_available : null;
            } catch (e) {
                return null;
            }
        },

        async _hydrateCells() {
            const cells = Array.from(this.el.querySelectorAll('#sp-matrix td'));
            const self = this;

            // Concurrency limitada
            const queue = cells.slice();
            const workers = new Array(6).fill(0).map(async function run() {
                while (queue.length) {
                    const td = queue.shift();
                    const $td = $(td);
                    const colorId = parseInt($td.data('size') ? $td.closest('tr').data('color-id') : $td.find('.sp-qty').data('color-id'), 10) || parseInt($td.attr('data-color-id') || 0, 10);
                    const sizeId  = parseInt($td.find('.sp-qty').data('size-id') || $td.attr('data-size-id') || 0, 10);

                    const info = await self._fetchCombination([colorId, sizeId]);
                    if (info && info.product_id) {
                        // Variant id
                        const $input = $td.find('.sp-qty');
                        $input.attr('data-variant-id', info.product_id);

                        // Precio (si viene)
                        if (typeof info.price === 'number') {
                            $td.find('.sp-price').text(self._formatPrice(info.price));
                        }

                        // Stock: primero lo que devuelva info, si no, fallback
                        let stock = (info.stock_quantity !== undefined) ? info.stock_quantity : null;
                        if (stock === null) {
                            stock = await self._getStock(info.product_id);
                        }
                        if (stock !== null) {
                            $td.find('.sp-stock').text(`Stock: ${stock}`);
                        }

                        // Imagen por fila/color (sólo si no está puesta)
                        const $row = $td.closest('tr');
                        const $img = $row.find('.sp-color__img');
                        if ($img.attr('src')) continue;
                        $img.attr('src', `/web/image/product.product/${info.product_id}/image_128`);
                    } else {
                        $td.addClass('sp-unavailable');
                    }
                }
            });

            await Promise.all(workers);
        },

        _formatPrice(v) {
            try {
                const lang = document.documentElement.lang || 'es-ES';
                const curr = document.querySelector('[data-website-currency-code]')?.dataset.websiteCurrencyCode || 'EUR';
                return new Intl.NumberFormat(lang, { style: 'currency', currency: curr }).format(v);
            } catch (e) {
                return (Math.round(v * 100) / 100).toFixed(2);
            }
        },

        // -------- Añadir al carrito todas las celdas > 0 --------
        _onAddAllToCart(ev) {
            ev.preventDefault();
            const calls = [];
            this.$('#sp-matrix .sp-qty').each(function () {
                const qty = parseFloat(this.value || '0');
                const product_id = parseInt(this.dataset.variantId || '0', 10);
                if (qty > 0 && product_id) {
                    calls.push(ajax.jsonRpc('/shop/cart/update_json', 'call', {
                        product_id, add_qty: qty, display: false,
                    }));
                }
            });
            if (!calls.length) return;
            Promise.all(calls).then(() => window.location.reload());
        },
    });

    return publicWidget.registry.SerialPrinterMatrix;
});