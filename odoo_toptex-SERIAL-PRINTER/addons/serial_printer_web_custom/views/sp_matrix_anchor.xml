<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="sp_matrix_anchor_product" inherit_id="website_sale.product" name="SP Matrix Anchor (product)">
    <!-- Insertar ancla justo después del bloque de atributos -->
    <xpath expr="//div[contains(@class,'js_attributes')]" position="after">
      <div id="sp-matrix-anchor"/>
    </xpath>
  </template>
</odoo>