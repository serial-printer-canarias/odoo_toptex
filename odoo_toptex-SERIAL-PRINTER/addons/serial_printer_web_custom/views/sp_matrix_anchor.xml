<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Ancla robusta dentro del formulario del producto -->
    <template id="sp_matrix_anchor_product" inherit_id="website_sale.product" name="SP Matrix Anchor (product)">
      <xpath expr="//form[contains(@class,'o_wsale_product_configurator')]" position="inside">
        <div id="sp-matrix-anchor" class="sp-matrix-anchor"/>
      </xpath>
    </template>
  </data>
</odoo>