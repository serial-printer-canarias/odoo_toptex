<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="sp_matrix_anchor_product"
            name="SP Matrix Anchor (product)"
            inherit_id="website_sale.product">
    <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' js_product ')]"
           position="inside">
      <div id="sp-matrix-anchor" class="sp-matrix-anchor"/>
    </xpath>
  </template>
</odoo>